---
// Full-screen layout for the web onboarding: no site nav or footer, just the
// app's sky and one phone-width column, like the iOS onboarding.
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import WebsiteAnalytics from '../components/WebsiteAnalytics.astro';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#7ec0ee" />
    <SEO {title} {description} noindex={true} />
    <script is:inline>
      (function () {
        var ua = navigator.userAgent || '';
        var ios = /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
        var android = /Android/.test(ua);
        document.documentElement.dataset.platform = ios ? 'ios' : android ? 'android' : 'other';
      })();
    </script>
  </head>
  <body class="funnel-page">
    <main class="mx-auto w-full max-w-[30rem] min-h-[100dvh]">
      <slot />
    </main>
    <WebsiteAnalytics />
  </body>
</html>

<style is:global>
  .funnel-page {
    background:
      url('/app-ui/sky.webp') top center / min(100%, 60rem) auto no-repeat,
      linear-gradient(180deg, var(--color-sky-top) 0%, var(--color-sky-mid) 45%, var(--color-sky-bottom) 100%) fixed;
    min-height: 100dvh;
  }
</style>
