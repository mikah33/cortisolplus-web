---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SEO from '../components/SEO.astro';
import Nav from '../components/Nav.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import WebsiteAnalytics from '../components/WebsiteAnalytics.astro';
import StickyCTA from '../components/StickyCTA.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, image, noindex, schema } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <!-- Meta (Facebook) domain verification -->
    <meta name="facebook-domain-verification" content="8he4ko2zztscsupggm61yd5v7zkeye" />
    <SEO {title} {description} {image} {noindex} {schema} />
    <ClientRouter />
    <meta name="theme-color" content="#7ec0ee" />
    <script is:inline>
      // Tag the page with the visitor's phone so store buttons and copy can
      // follow it. iPadOS reports itself as a Mac, so touch support decides.
      (function () {
        var ua = navigator.userAgent || '';
        var ios = /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
        var android = /Android/.test(ua);
        var platform = ios ? 'ios' : android ? 'android' : 'other';
        var tag = function () { document.documentElement.dataset.platform = platform; };
        tag();
        // Client-side navigation replaces <html> attributes, so tag it again.
        if (!window.__cpPlatformTagged) {
          window.__cpPlatformTagged = true;
          document.addEventListener('astro:after-swap', tag);
        }
      })();
    </script>
  </head>
  <body class="app-page min-h-screen flex flex-col">
    <Nav />
    <Breadcrumbs />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <StickyCTA />
    <WebsiteAnalytics />
  </body>
</html>
