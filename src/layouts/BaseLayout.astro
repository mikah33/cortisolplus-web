---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SEO from '../components/SEO.astro';
import Nav from '../components/Nav.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, image, noindex, schema } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <!-- Meta (Facebook) domain verification -->
    <meta name="facebook-domain-verification" content="8he4ko2zztscsupggm61yd5v7zkeye" />
    <SEO {title} {description} {image} {noindex} {schema} />
    <ClientRouter />

    <!-- Meta Pixel Code -->
    <script is:inline>
      if (!window.__metaPixelInit) {
        window.__metaPixelInit = true;
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', '1318457513735358');
        // Fire PageView on initial load and on every client-side (View Transitions) navigation.
        document.addEventListener('astro:page-load', function () { if (window.fbq) fbq('track', 'PageView'); });
      }
    </script>
    <noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=1318457513735358&ev=PageView&noscript=1" alt="" /></noscript>
    <!-- End Meta Pixel Code -->
  </head>
  <body class="min-h-screen flex flex-col">
    <Nav />
    <Breadcrumbs />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
