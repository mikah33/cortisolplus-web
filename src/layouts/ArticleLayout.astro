---
import BaseLayout from './BaseLayout.astro';
import RelatedGuides from '../components/RelatedGuides.astro';
import RatingBadge from '../components/RatingBadge.astro';
import NewsletterCTA from '../components/NewsletterCTA.astro';
import { SITE, PUBLISHER } from '../consts';

interface Props {
  title: string;
  description: string;
  published?: string;
  updated?: string;
  image?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** If true, omits the YMYL medical disclaimer footer (for legal pages, etc.) */
  hideDisclaimer?: boolean;
}

const { title, description, published, updated, image, schema, noindex, hideDisclaimer } = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const heroImage = image ? new URL(image, SITE.url).toString() : new URL(SITE.ogImage, SITE.url).toString();

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: heroImage,
  ...(published ? { datePublished: published } : {}),
  ...(updated ? { dateModified: updated } : {}),
  author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  publisher: {
    '@type': 'Organization',
    name: PUBLISHER.name,
    url: PUBLISHER.url,
    logo: { '@type': 'ImageObject', url: `${SITE.url}/icon-512.png` },
  },
  mainEntityOfPage: canonical,
};

const combinedSchema = schema
  ? [articleSchema, ...(Array.isArray(schema) ? schema : [schema])]
  : articleSchema;
---

<BaseLayout {title} {description} {image} {noindex} schema={combinedSchema}>
  <div class="reading-progress" id="reading-progress"></div>

  <article class="max-w-3xl mx-auto px-4 pt-6 pb-16">
    <header class="px-1 mb-6">
      <h1 class="text-[2rem] md:text-5xl leading-[1.1] font-extrabold tracking-tight mb-3 text-balance">{title}</h1>
      <p class="text-[1.0625rem] md:text-xl leading-relaxed text-[color:var(--color-ink-muted)] text-pretty">{description}</p>
      {(updated || published) && (
        <p class="text-sm text-[color:var(--color-ink-muted)] mt-4">
          {updated ? 'Updated' : 'Published'} {new Date(updated ?? published!).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
          {' · By '}<a href="/about/">Cortisol+ Editorial</a>
        </p>
      )}
    </header>

    <div class="app-card px-5 py-6 sm:px-8 sm:py-8 prose prose-base sm:prose-lg max-w-none
      prose-headings:font-extrabold
      prose-headings:tracking-tight prose-headings:text-[color:var(--color-ink)] prose-headings:text-balance
      prose-h2:mt-12 prose-h2:mb-3 prose-h2:text-[1.5rem] sm:prose-h2:text-[1.75rem] prose-h2:leading-tight
      prose-h3:mt-8 prose-h3:mb-2
      prose-p:text-[color:var(--color-ink)] prose-p:leading-[1.75] prose-p:my-4
      prose-li:text-[color:var(--color-ink)] prose-li:leading-[1.7] prose-li:my-1.5
      prose-a:text-[color:var(--color-teal-dark)] prose-a:no-underline hover:prose-a:underline
      prose-strong:text-[color:var(--color-ink)]">
      <slot />
    </div>

    <RelatedGuides />

    {!hideDisclaimer && (
      <aside class="mt-6 app-card p-5 text-sm text-[color:var(--color-ink-muted)] leading-relaxed">
        <strong class="text-[color:var(--color-ink)]">Not medical advice.</strong> This page is educational. Cortisol+ does not measure cortisol directly — the app offers a wellness score derived from biometric signals, not a hormone test. For diagnosis, testing, or treatment of any medical condition, consult a qualified healthcare provider.
      </aside>
    )}

    <aside class="mt-6 app-sky rounded-3xl overflow-hidden px-5 pt-6 pb-6 text-center">
      <img src="/app-ui/zen_presenting_new.webp" alt="" width="306" height="480" loading="lazy" class="mx-auto h-32 w-auto" />
      <h2 class="mt-2 text-2xl font-extrabold tracking-tight">Get your personal stress plan</h2>
      <p class="mt-2 mb-5 text-[color:var(--color-ink)]/75 leading-relaxed">
        A one-minute check-in with Zen, then a plan built around your watch's HRV, sleep and activity. Read <a href="/how-it-works/" class="underline font-semibold">our methodology</a> to see what the score can and can't tell you.
      </p>
      <a href="/start/" data-start-cta data-event="article-start-click" class="mx-auto flex h-14 w-full max-w-sm items-center justify-center rounded-full bg-[color:var(--color-ink)] text-[1.0625rem] font-extrabold text-white shadow-sm transition hover:brightness-110">Start my plan ›</a>
      <p class="mt-3 text-sm text-[color:var(--color-ink)]/70">Just want the app? <a href="/download/" class="underline font-semibold">Download Cortisol+</a></p>
      <div class="mt-4 flex justify-center"><RatingBadge size="sm" /></div>
    </aside>

    <NewsletterCTA variant="card" />
  </article>

  <script>
    function initReadingProgress() {
      const bar = document.getElementById('reading-progress');
      const article = document.querySelector('article');
      if (!bar || !article) return;
      const updateProgress = () => {
        const { top, height } = article.getBoundingClientRect();
        const viewport = window.innerHeight;
        const scrolled = Math.max(0, -top);
        const total = Math.max(1, height - viewport);
        const pct = Math.min(100, (scrolled / total) * 100);
        (bar as HTMLElement).style.width = pct + '%';
      };
      updateProgress();
      window.addEventListener('scroll', updateProgress, { passive: true });
      window.addEventListener('resize', updateProgress);
    }
    initReadingProgress();
    document.addEventListener('astro:after-swap', initReadingProgress);
  </script>
</BaseLayout>
