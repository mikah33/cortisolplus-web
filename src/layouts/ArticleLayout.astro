---
import BaseLayout from './BaseLayout.astro';
import RelatedGuides from '../components/RelatedGuides.astro';
import RatingBadge from '../components/RatingBadge.astro';
import NewsletterCTA from '../components/NewsletterCTA.astro';
import { SITE, PUBLISHER } from '../consts';

interface Props {
  title: string;
  description: string;
  published?: string;
  updated?: string;
  image?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** If true, omits the YMYL medical disclaimer footer (for legal pages, etc.) */
  hideDisclaimer?: boolean;
}

const { title, description, published, updated, image, schema, noindex, hideDisclaimer } = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const heroImage = image ? new URL(image, SITE.url).toString() : new URL(SITE.ogImage, SITE.url).toString();

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: heroImage,
  ...(published ? { datePublished: published } : {}),
  ...(updated ? { dateModified: updated } : {}),
  author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  publisher: {
    '@type': 'Organization',
    name: PUBLISHER.name,
    url: PUBLISHER.url,
    logo: { '@type': 'ImageObject', url: `${SITE.url}/icon-512.png` },
  },
  mainEntityOfPage: canonical,
};

const combinedSchema = schema
  ? [articleSchema, ...(Array.isArray(schema) ? schema : [schema])]
  : articleSchema;
---

<BaseLayout {title} {description} {image} {noindex} schema={combinedSchema}>
  <div class="reading-progress" id="reading-progress"></div>

  <article class="max-w-3xl mx-auto px-4 pt-6 pb-16 lg:max-w-6xl lg:grid lg:grid-cols-[minmax(0,48rem)_16rem] lg:justify-center lg:gap-x-12 xl:gap-x-16">
    <div class="lg:col-start-1 lg:row-start-1 lg:min-w-0">
    <header class="px-1 mb-6">
      <h1 class="text-[2rem] md:text-5xl leading-[1.1] font-extrabold tracking-tight mb-3 text-balance">{title}</h1>
      <p class="text-[1.0625rem] md:text-xl leading-relaxed text-[color:var(--color-ink-muted)] text-pretty">{description}</p>
      {(updated || published) && (
        <p class="text-sm text-[color:var(--color-ink-muted)] mt-4">
          {updated ? 'Updated' : 'Published'} {new Date(updated ?? published!).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
          {' · By '}<a href="/about/">Cortisol+ Editorial</a>
        </p>
      )}
    </header>

    <div data-article-body class="app-card px-5 py-6 sm:px-8 sm:py-8 prose prose-base sm:prose-lg max-w-none
      prose-headings:font-extrabold
      prose-headings:tracking-tight prose-headings:text-[color:var(--color-ink)] prose-headings:text-balance
      prose-h2:mt-12 prose-h2:mb-3 prose-h2:text-[1.5rem] sm:prose-h2:text-[1.75rem] prose-h2:leading-tight
      prose-h3:mt-8 prose-h3:mb-2
      prose-p:text-[color:var(--color-ink)] prose-p:leading-[1.75] prose-p:my-4
      prose-li:text-[color:var(--color-ink)] prose-li:leading-[1.7] prose-li:my-1.5
      prose-a:text-[color:var(--color-teal-dark)] prose-a:no-underline hover:prose-a:underline
      prose-strong:text-[color:var(--color-ink)]">
      <slot />
    </div>
    </div>

    <!-- Desktop only: sticky "On this page" list and a compact Start card. -->
    <aside class="hidden lg:block lg:col-start-2 lg:row-start-1" aria-label="Article tools">
      <div class="sticky top-20 flex max-h-[calc(100vh-6rem)] flex-col gap-4">
        <nav data-article-toc hidden aria-label="On this page" style="view-transition-name: none" class="app-card min-h-0 overflow-y-auto px-5 py-4">
          <p class="text-xs font-extrabold uppercase tracking-widest text-[color:var(--color-ink-muted)]">On this page</p>
          <ol data-article-toc-list class="mt-2 space-y-0.5 text-[0.875rem] leading-snug"></ol>
        </nav>
        <a href="/start/" data-start-cta data-event="article-sidebar-start-click" class="group flex shrink-0 items-center gap-3 rounded-3xl app-sky border border-white/80 p-4 shadow-[0_12px_28px_-16px_rgba(40,96,140,0.45)] transition hover:brightness-[1.03]">
          <img src="/app-ui/zen_presenting_new.webp" alt="" width="306" height="480" loading="lazy" class="h-16 w-auto shrink-0" />
          <span class="min-w-0 flex-1">
            <span class="block font-extrabold leading-tight text-[color:var(--color-ink)]">Get your personal stress plan</span>
            <span class="mt-2 inline-flex h-9 items-center rounded-full bg-[color:var(--color-ink)] px-4 text-sm font-extrabold text-white group-hover:brightness-110">Start ›</span>
          </span>
        </a>
      </div>
    </aside>

    <div class="lg:col-start-1 lg:row-start-2 lg:min-w-0">
    <RelatedGuides />

    {!hideDisclaimer && (
      <aside class="mt-6 app-card p-5 text-sm text-[color:var(--color-ink-muted)] leading-relaxed">
        <strong class="text-[color:var(--color-ink)]">Not medical advice.</strong> This page is educational. Cortisol+ does not measure cortisol directly — the app offers a wellness score derived from biometric signals, not a hormone test. For diagnosis, testing, or treatment of any medical condition, consult a qualified healthcare provider.
      </aside>
    )}

    <aside class="mt-6 app-sky rounded-3xl overflow-hidden px-5 pt-6 pb-6 text-center">
      <img src="/app-ui/zen_presenting_new.webp" alt="" width="306" height="480" loading="lazy" class="mx-auto h-32 w-auto" />
      <h2 class="mt-2 text-2xl font-extrabold tracking-tight">Get your personal stress plan</h2>
      <p class="mt-2 mb-5 text-[color:var(--color-ink)]/75 leading-relaxed">
        A one-minute check-in with Zen, then a plan built around your watch's HRV, sleep and activity. Read <a href="/how-it-works/" class="underline font-semibold">our methodology</a> to see what the score can and can't tell you.
      </p>
      <a href="/start/" data-start-cta data-event="article-start-click" class="mx-auto flex h-14 w-full max-w-sm items-center justify-center rounded-full bg-[color:var(--color-ink)] text-[1.0625rem] font-extrabold text-white shadow-sm transition hover:brightness-110">Start my plan ›</a>
      <p class="mt-3 text-sm text-[color:var(--color-ink)]/70">Just want the app? <a href="/download/" class="underline font-semibold">Download Cortisol+</a></p>
      <div class="mt-4 flex justify-center"><RatingBadge size="sm" /></div>
    </aside>

    <NewsletterCTA variant="card" />
    </div>
  </article>

  <script>
    function initReadingProgress() {
      const bar = document.getElementById('reading-progress');
      const article = document.querySelector('article');
      if (!bar || !article) return;
      const updateProgress = () => {
        const { top, height } = article.getBoundingClientRect();
        const viewport = window.innerHeight;
        const scrolled = Math.max(0, -top);
        const total = Math.max(1, height - viewport);
        const pct = Math.min(100, (scrolled / total) * 100);
        (bar as HTMLElement).style.width = pct + '%';
      };
      updateProgress();
      window.addEventListener('scroll', updateProgress, { passive: true });
      window.addEventListener('resize', updateProgress);
    }
    initReadingProgress();
    document.addEventListener('astro:after-swap', initReadingProgress);

    // Desktop sidebar "On this page": reuse the page's own jump list when it
    // has one (that list is then hidden on desktop only), otherwise build it
    // from the article's h2s. Fewer than three entries: no list.
    let tocCleanup: (() => void) | undefined;
    function initArticleToc() {
      tocCleanup?.();
      const nav = document.querySelector<HTMLElement>('[data-article-toc]');
      const list = nav?.querySelector('[data-article-toc-list]');
      const body = document.querySelector('[data-article-body]');
      if (!nav || !list || !body) return;
      const slug = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
      let items: { id: string; text: string }[] = [];
      const own = body.querySelector<HTMLElement>('nav[aria-label="On this page"]');
      if (own) {
        items = [...own.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')]
          .map((a) => ({ id: decodeURIComponent(a.hash.slice(1)), text: (a.textContent || '').trim() }))
          .filter((i) => i.id && document.getElementById(i.id));
      }
      if (items.length >= 3) {
        own!.dataset.tocInSidebar = '';
      } else {
        const used = new Set<string>();
        items = [...body.querySelectorAll<HTMLElement>('h2')]
          .filter((h) => !h.closest('aside, .not-prose, [data-toc-skip]'))
          .map((h) => {
            if (!h.id) {
              let id = slug(h.textContent || '') || 'section';
              while (document.getElementById(id) || used.has(id)) id += '-x';
              h.id = id;
            }
            used.add(h.id);
            return { id: h.id, text: (h.textContent || '').trim() };
          });
      }
      list.replaceChildren();
      if (items.length < 3) { nav.hidden = true; return; }
      const links = items.map(({ id, text }) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `#${encodeURIComponent(id)}`;
        a.textContent = text;
        a.className = 'article-toc-link';
        li.append(a);
        list.append(li);
        return a;
      });
      nav.hidden = false;
      const targets = items.map((i) => document.getElementById(i.id));
      const onScroll = () => {
        let active = 0;
        targets.forEach((t, i) => { if (t && t.getBoundingClientRect().top < 140) active = i; });
        links.forEach((a, i) => a.toggleAttribute('aria-current', i === active));
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      tocCleanup = () => window.removeEventListener('scroll', onScroll);
    }
    initArticleToc();
    document.addEventListener('astro:after-swap', initArticleToc);
  </script>

  <style is:global>
    @media (min-width: 1024px) {
      [data-article-body] nav[data-toc-in-sidebar] { display: none; }
      [data-article-body] h2[id] { scroll-margin-top: 5rem; }
      .article-toc-link {
        display: block;
        margin-inline: -0.5rem;
        padding: 0.4rem 0.5rem;
        border-radius: 0.625rem;
        color: var(--color-ink-muted);
        font-weight: 600;
        text-decoration: none;
        transition: background-color 150ms ease, color 150ms ease;
      }
      .article-toc-link:hover { color: var(--color-ink); background: var(--color-surface); }
      .article-toc-link[aria-current] { color: var(--color-teal-dark); background: var(--color-mint-soft); }
    }
  </style>
</BaseLayout>
