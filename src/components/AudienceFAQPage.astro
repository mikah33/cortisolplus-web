---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ, { type FAQItem } from './FAQ.astro';
import RelatedLinks from './RelatedLinks.astro';
import AppStoreBadge from './AppStoreBadge.astro';
import RatingBadge from './RatingBadge.astro';

interface RelatedLink { href: string; title: string; hint?: string; }

interface Props {
  audience: string;
  title: string;
  description: string;
  intro: string;
  faqs: FAQItem[];
  related: RelatedLink[];
  image?: string;
}

const { audience, title, description, intro, faqs, related, image } = Astro.props;
---

<BaseLayout {title} {description} {image}>
  <section class="max-w-3xl mx-auto px-6 py-16">
    <div class="text-xs uppercase tracking-widest text-[color:var(--color-coral)] font-medium mb-3">FAQ · {audience}</div>
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4">{title}</h1>
    <p class="text-xl text-[color:var(--color-ink-muted)] mb-10">{intro}</p>

    <FAQ items={faqs} title="" />

    <aside class="mt-16 p-8 rounded-2xl bg-gradient-to-br from-[color:var(--color-mint-soft)] to-[color:var(--color-surface)] border border-[color:var(--color-border)]">
      <div class="text-xs uppercase tracking-widest text-[color:var(--color-teal-dark)] font-medium mb-2">Cortisol+</div>
      <h2 class="text-2xl font-bold mb-2">Track your own cortisol pattern</h2>
      <p class="text-[color:var(--color-ink-muted)] mb-6">
        Free on iPhone + Apple Watch. See how your symptoms map to actual biometric patterns.
      </p>
      <div class="flex flex-wrap items-center gap-4">
        <AppStoreBadge size="lg" />
        <RatingBadge size="sm" />
      </div>
    </aside>

    <RelatedLinks links={related} />
  </section>
</BaseLayout>
