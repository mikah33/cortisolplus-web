---
import GooglePlayIcon from './icons/GooglePlayIcon.astro';
// App Store and Google Play buttons, always both visible. The platform class
// set in BaseLayout's head only puts the visitor's own store first.
import { SITE } from '../consts';

interface Props {
  variant?: 'dark' | 'light';
  class?: string;
}
const { variant = 'dark', class: className = '' } = Astro.props;
const btn = `app-btn w-full ${variant === 'light' ? 'app-btn--light' : ''}`;
---

<div class={`get-app ${className}`}>
  <a href={SITE.appStoreUrl} class={btn} data-store="ios" data-event="appstore-click">
    <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 -mt-0.5" aria-hidden="true"><path d="M17.5 12.5c0-2.6 2.1-3.8 2.2-3.9-1.2-1.7-3-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9-1.7 0-3.4 1-4.3 2.6-1.8 3.2-.5 7.9 1.3 10.5.9 1.3 1.9 2.7 3.3 2.7 1.3-.1 1.8-.9 3.4-.9 1.6 0 2 .9 3.4.9 1.4 0 2.3-1.3 3.2-2.6 1-1.5 1.4-3 1.4-3.1-.1 0-2.7-1-2.7-4.1zM15 4.6c.7-.9 1.2-2.1 1.1-3.3-1 0-2.3.7-3 1.5-.7.8-1.2 2-1.1 3.2 1.1.1 2.3-.6 3-1.4z"/></svg>
    Get it on the App Store
  </a>
  <a href={SITE.googlePlayUrl} class={btn} data-store="android">
    <GooglePlayIcon class="h-5 w-5" />
    Get it on Google Play
  </a>
</div>

<style>
  .get-app { display: grid; gap: 0.625rem; }
  /* Visitor's own store first; both always shown. */
  :global(html[data-platform='android']) [data-store='android'] { order: -1; }
</style>
