---
// One store button that follows the visitor's phone: App Store on iPhone and
// iPad, Google Play on Android. Both links are rendered so attribution
// (src/lib/acquisition.js) still sees a real apps.apple.com href; the platform
// class set in BaseLayout's head hides the one that doesn't apply.
import { SITE } from '../consts';

interface Props {
  variant?: 'dark' | 'light';
  class?: string;
  showOther?: boolean;
}
const { variant = 'dark', class: className = '', showOther = true } = Astro.props;
const btn = `app-btn w-full ${variant === 'light' ? 'app-btn--light' : ''}`;
---

<div class={`get-app ${className}`}>
  <a href={SITE.appStoreUrl} class={btn} data-store="ios" data-event="appstore-click">
    <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 -mt-0.5" aria-hidden="true"><path d="M17.5 12.5c0-2.6 2.1-3.8 2.2-3.9-1.2-1.7-3-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9-1.7 0-3.4 1-4.3 2.6-1.8 3.2-.5 7.9 1.3 10.5.9 1.3 1.9 2.7 3.3 2.7 1.3-.1 1.8-.9 3.4-.9 1.6 0 2 .9 3.4.9 1.4 0 2.3-1.3 3.2-2.6 1-1.5 1.4-3 1.4-3.1-.1 0-2.7-1-2.7-4.1zM15 4.6c.7-.9 1.2-2.1 1.1-3.3-1 0-2.3.7-3 1.5-.7.8-1.2 2-1.1 3.2 1.1.1 2.3-.6 3-1.4z"/></svg>
    Get it on the App Store
  </a>
  <a href={SITE.googlePlayUrl} class={btn} data-store="android">
    <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4" aria-hidden="true"><path d="M5 3.5v17l15-8.5z" /></svg>
    Get it on Google Play
  </a>
  {showOther && (
    <p class="get-app-other mt-3 text-center text-sm text-[color:var(--color-ink-muted)]">
      <a href={SITE.googlePlayUrl} data-store-other="android" class="underline underline-offset-2">On Android? Get it on Google Play</a>
      <a href={SITE.appStoreUrl} data-store-other="ios" class="underline underline-offset-2">On iPhone? Get it on the App Store</a>
    </p>
  )}
</div>

<style>
  .get-app { display: grid; gap: 0.625rem; }
  /* Unknown platform (desktop, bots): show both buttons, no "other" link. */
  .get-app-other { display: none; }
  :global(html[data-platform='ios']) [data-store='android'],
  :global(html[data-platform='android']) [data-store='ios'] { display: none; }
  :global(html[data-platform='ios']) .get-app-other,
  :global(html[data-platform='android']) .get-app-other { display: block; }
  :global(html[data-platform='ios']) [data-store-other='ios'],
  :global(html[data-platform='android']) [data-store-other='android'] { display: none; }
</style>
