---
interface Link {
  href: string;
  title: string;
  hint?: string;
}

interface Props {
  title?: string;
  links: Link[];
}

const { title = 'Related', links } = Astro.props;
---

<aside class="mt-12 reveal">
  <h2 class="px-1 mb-4 text-[1.5rem] md:text-3xl font-extrabold tracking-tight leading-tight">{title}</h2>
  <ul class="app-card app-list overflow-hidden">
    {links.map((l) => (
      <li>
        <a href={l.href} class="app-row">
          <span>
            <span class="block font-bold">{l.title}</span>
            {l.hint && <span class="block text-sm text-[color:var(--color-ink-muted)]">{l.hint}</span>}
          </span>
          <span class="app-chevron" aria-hidden="true">›</span>
        </a>
      </li>
    ))}
  </ul>
</aside>
