---
// The iPhone app's Bio Age screen, rebuilt in HTML: the Bio Age ring, the
// Pace of Aging card with its slower → faster bar, and the Sleep, HRV and
// RHR tiles. Values are examples taken from the App Store screenshot.
interface Props {
  bioAge?: number;
  yearsYounger?: number;
  pace?: number;
  sleepHours?: number;
  hrv?: number;
  restingHR?: number;
}
const {
  bioAge = 26,
  yearsYounger = 4,
  pace = 0.88,
  sleepHours = 8.0,
  hrv = 54,
  restingHR = 62,
} = Astro.props;

// Pace bar spans 0.5x–1.5x, so 1.0x ("on pace") sits in the middle.
const knobPct = Math.min(100, Math.max(0, ((pace - 0.5) / 1) * 100));
const slowerPct = Math.round((1 - pace) * 100);

// Last seven nights / days for the mini bar charts (example shapes).
const tiles = [
  { name: 'Sleep', value: sleepHours.toFixed(1), unit: 'hours', color: '#7c6cf0', bars: [0.6, 0.75, 0.55, 0.45, 0.9, 0.8, 0.95] },
  { name: 'HRV', value: String(hrv), unit: 'ms', color: '#34c759', bars: [0.3, 0.35, 0.3, 0.45, 0.6, 0.65, 0.95] },
  { name: 'RHR', value: String(restingHR), unit: 'bpm', color: '#ff6b81', bars: [0.9, 0.85, 0.95, 0.6, 0.5, 0.45, 0.4] },
];
---

<div class="select-none">
  <div class="flex justify-center">
    <div class="relative w-40 h-40 rounded-full grid place-items-center bg-[radial-gradient(circle,#c9f2df_0%,#9fe3c4_100%)] shadow-[0_0_40px_-6px_rgba(74,194,158,0.55)]">
      <div class="w-28 h-28 rounded-full bg-white grid place-items-center text-center">
        <div>
          <div class="text-xs font-semibold text-[color:var(--color-ink-muted)]">Bio Age</div>
          <div class="text-4xl font-extrabold tabular-nums leading-none mt-0.5">{bioAge}</div>
          <div class="text-[11px] font-bold text-[#34c759] mt-1">{yearsYounger} years younger</div>
        </div>
      </div>
    </div>
  </div>

  <div class="bio-card mt-4 px-4 py-4">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2 font-bold">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-[color:var(--color-teal)]" aria-hidden="true"><circle cx="12" cy="13" r="8" /><path d="M12 13l3-3M10 2h4" stroke-linecap="round" /></svg>
        Pace of Aging
      </div>
      <span class="text-xl font-extrabold tabular-nums text-[#34c759]">{pace.toFixed(2)}×</span>
    </div>
    <p class="mt-1.5 text-sm text-[color:var(--color-ink-muted)] leading-snug">About {pace.toFixed(2)} estimated years per calendar year, {slowerPct}% slower than average.</p>
    <div class="relative mt-3 h-2.5 rounded-full bg-[linear-gradient(90deg,#34c759_0%,#4ac29e_35%,#ffcc40_70%,#f75754_100%)]">
      <span class="absolute top-1/2 w-5 h-5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-white border-[3px] border-[#34c759] shadow" style={`left:${knobPct}%`}></span>
    </div>
    <div class="mt-2 flex justify-between text-[11px] font-semibold">
      <span class="text-[#34c759]">Slower</span>
      <span class="text-[color:var(--color-ink-muted)]">On pace</span>
      <span class="text-[#f75754]">Faster</span>
    </div>
  </div>

  <div class="mt-3 grid grid-cols-3 gap-2.5">
    {tiles.map((t) => (
      <div class="bio-card px-3 py-3">
        <div class="text-xs font-bold" style={`color:${t.color}`}>{t.name}</div>
        <div class="mt-0.5 whitespace-nowrap"><span class="text-xl font-bold tabular-nums">{t.value}</span> <span class="text-[11px] text-[color:var(--color-ink-muted)]">{t.unit}</span></div>
        <div class="mt-2 flex items-end gap-[3px] h-7" aria-hidden="true">
          {t.bars.map((b, i) => (
            <span class="flex-1 rounded-full" style={`height:${Math.round(b * 100)}%;background:${t.color};opacity:${i === t.bars.length - 1 ? 1 : 0.45}`}></span>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .bio-card {
    background: white;
    border-radius: 1.4rem;
    box-shadow: 0 1px 2px rgba(15, 20, 25, 0.04), 0 8px 24px -12px rgba(15, 20, 25, 0.12);
  }
</style>
