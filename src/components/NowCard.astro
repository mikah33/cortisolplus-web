---
// The iPhone app's Now screen, rebuilt in HTML: the ~210° arc gauge with its
// green → blue → yellow → red spectrum and white knob, the HRV and Resting HR
// tiles beside it, and the Cortisol average/high/low card below.
// Geometry and colors follow CortisolArcGauge in the app (Shared/Components/
// CortisolGauge.swift). Values are examples taken from the App Store screenshot.
interface Props {
  score?: number;
  level?: string;
  average?: number;
  hrv?: number;
  restingHR?: number;
  dayAverage?: number;
  dayHigh?: number;
  dayLow?: number;
}
const {
  score = 26,
  level = 'Low',
  average = 26,
  hrv = 58,
  restingHR = 58,
  dayAverage = 32,
  dayHigh = 48,
  dayLow = 23,
} = Astro.props;

// Angles in screen space: 0° = east, 90° = down, sweeping clockwise.
const sweep = 210;
const start = 270 - sweep / 2; // lower-left
const w = 300;
const lineWidth = 20;
const r = (w - lineWidth) / 2;
const cx = w / 2;
const cy = r + lineWidth / 2;

const stops: [number, [number, number, number]][] = [
  [0.0, [61, 209, 120]],  // green
  [0.36, [66, 158, 245]], // blue
  [0.7, [255, 204, 64]],  // yellow
  [1.0, [247, 87, 84]],   // red
];
function colorAt(t: number) {
  for (let i = 1; i < stops.length; i++) {
    const [t1, c1] = stops[i];
    const [t0, c0] = stops[i - 1];
    if (t <= t1) {
      const k = (t - t0) / (t1 - t0);
      const c = c0.map((v, j) => Math.round(v + (c1[j] - v) * k));
      return `rgb(${c[0]},${c[1]},${c[2]})`;
    }
  }
  return 'rgb(247,87,84)';
}
function point(t: number) {
  const a = ((start + sweep * t) * Math.PI) / 180;
  return { x: cx + r * Math.cos(a), y: cy + r * Math.sin(a) };
}

// SVG has no angular gradient, so the arc is drawn as short segments, each in
// the spectrum color at its midpoint. Round caps are added at both ends.
const segments = Array.from({ length: 70 }, (_, i) => {
  const t0 = i / 70;
  const t1 = Math.min(1, (i + 1.35) / 70);
  const a = point(t0);
  const b = point(t1);
  return { d: `M ${a.x.toFixed(2)} ${a.y.toFixed(2)} A ${r} ${r} 0 0 1 ${b.x.toFixed(2)} ${b.y.toFixed(2)}`, color: colorAt((t0 + t1) / 2) };
});
const startCap = point(0);
const h = Math.ceil(startCap.y + lineWidth / 2 + 2);
const endCap = point(1);

const t = Math.min(1, Math.max(0, score / 100));
const knob = point(t);
const knobAngle = start + sweep * t + 90; // pill lies along the arc

const levelColor = score < 30 ? '#34c759' : score < 51 ? '#007aff' : score < 71 ? '#ff9500' : '#ff3b30';
const ringPct = Math.min(1, dayAverage / 100);
const ringR = 22;
const ringC = 2 * Math.PI * ringR;
---

<div class="now-card select-none">
  <div class="grid grid-cols-[1.45fr_1fr] gap-3">
    <!-- Gauge card -->
    <div class="app-card flex flex-col items-center justify-center px-3 pt-5 pb-6">
      <div class="dial relative w-full">
        <svg viewBox={`0 0 ${w} ${h}`} class="w-full h-auto overflow-visible" aria-hidden="true">
          <defs>
            <filter id="now-arc-blur" x="-20%" y="-20%" width="140%" height="140%">
              <feGaussianBlur stdDeviation="7" />
            </filter>
            <filter id="now-knob-shadow" x="-100%" y="-100%" width="300%" height="300%">
              <feDropShadow dx="0" dy="1" stdDeviation="1.5" flood-color="#0f1419" flood-opacity="0.25" />
            </filter>
          </defs>
          <!-- Soft glow under the arc, as in the app -->
          <g filter="url(#now-arc-blur)" opacity="0.35">
            {segments.map((s) => <path d={s.d} fill="none" stroke={s.color} stroke-width={lineWidth} />)}
          </g>
          <g class="now-arc">
            {segments.map((s) => <path d={s.d} fill="none" stroke={s.color} stroke-width={lineWidth} />)}
            <circle cx={startCap.x} cy={startCap.y} r={lineWidth / 2} fill={colorAt(0)} />
            <circle cx={endCap.x} cy={endCap.y} r={lineWidth / 2} fill={colorAt(1)} />
          </g>
          <rect
            class="now-knob"
            x={knob.x - 7} y={knob.y - 13} width="14" height="26" rx="7"
            fill="white"
            filter="url(#now-knob-shadow)"
            transform={`rotate(${knobAngle} ${knob.x} ${knob.y})`}
          />
        </svg>
        <div class="dial-readout absolute inset-x-0 top-[22%] flex flex-col items-center text-center">
          <div class="dial-label font-semibold text-[#6b7280]">CORTISOL</div>
          <div class="dial-number font-bold tracking-tight tabular-nums leading-none" data-count-target={score}>{score}</div>
          <div class="dial-level font-bold" style={`color:${levelColor}`}>{level.toUpperCase()}</div>
          <div class="dial-avg font-semibold text-[#6b7280]">avg {average}</div>
          <div class="dial-tap text-[#9ca3af]">Tap for details</div>
        </div>
      </div>
    </div>

    <!-- HRV + Resting HR tiles -->
    <div class="flex flex-col gap-3">
      <div class="app-card flex-1 flex flex-col justify-center px-4 py-3">
        <div class="flex items-center gap-1.5 text-xs sm:text-sm font-semibold whitespace-nowrap text-[#34c759]">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><path d="M2 12h4l2-5 4 10 2-5h8" /></svg>
          HRV
        </div>
        <div class="text-xl sm:text-2xl md:text-[1.7rem] font-bold tabular-nums tracking-tight whitespace-nowrap mt-1">{hrv} ms</div>
      </div>
      <div class="app-card flex-1 flex flex-col justify-center px-4 py-3">
        <div class="flex items-center gap-1.5 text-xs sm:text-sm font-semibold whitespace-nowrap text-[#ef4444]">
          <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" /></svg>
          Resting HR
        </div>
        <div class="text-xl sm:text-2xl md:text-[1.7rem] font-bold tabular-nums tracking-tight whitespace-nowrap mt-1">{restingHR} bpm</div>
      </div>
    </div>
  </div>

  <!-- Cortisol card -->
  <div class="app-card mt-3 px-5 py-4">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2 font-bold">
        <svg viewBox="0 0 24 24" class="w-4 h-4 text-[color:var(--color-teal)]" fill="currentColor" aria-hidden="true"><path d="M10 3.5c-.4.6-5.5 7.2-5.5 11A5.5 5.5 0 0 0 10 20a5.5 5.5 0 0 0 5.5-5.5c0-3.8-5.1-10.4-5.5-11z" /><circle cx="18" cy="5" r="2.2" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
        Cortisol
      </div>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 text-[#c4c9cf]" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </div>
    <div class="flex items-center justify-between mt-2">
      <dl class="grid grid-cols-3 gap-6">
        <div><dt class="text-xs font-medium text-[#34c759]">Average</dt><dd class="text-2xl font-bold tabular-nums">{dayAverage}</dd></div>
        <div><dt class="text-xs font-medium text-[#ff9500]">High</dt><dd class="text-2xl font-bold tabular-nums">{dayHigh}</dd></div>
        <div><dt class="text-xs font-medium text-[#34c759]">Low</dt><dd class="text-2xl font-bold tabular-nums">{dayLow}</dd></div>
      </dl>
      <svg viewBox="0 0 56 56" class="w-12 h-12 -rotate-90" aria-hidden="true">
        <circle cx="28" cy="28" r={ringR} fill="none" stroke="#e5e7eb" stroke-width="6" />
        <circle class="now-ring" cx="28" cy="28" r={ringR} fill="none" stroke="var(--color-teal)" stroke-width="6" stroke-linecap="round"
          stroke-dasharray={`${(ringC * ringPct).toFixed(1)} ${ringC.toFixed(1)}`} />
      </svg>
    </div>
  </div>
</div>

<style>
  .now-card {
    --app-bg: #f2f4f7;
  }
  .app-card {
    background: white;
    border-radius: 1.4rem;
    box-shadow: 0 1px 2px rgba(15, 20, 25, 0.04), 0 8px 24px -12px rgba(15, 20, 25, 0.12);
  }
  /* The readout scales with the dial's width, so it sits inside the arc at any size. */
  .dial { container-type: inline-size; }
  .dial-label { font-size: max(7px, 3.6cqw); letter-spacing: 0.32em; }
  .dial-number { font-size: 21cqw; margin-top: 1.2cqw; }
  .dial-level { font-size: max(10px, 5.4cqw); letter-spacing: 0.18em; margin-top: 2cqw; }
  .dial-avg { font-size: max(10px, 5.4cqw); }
  .dial-tap { font-size: max(8px, 3.6cqw); margin-top: 1.2cqw; }
  .now-arc {
    animation: now-arc-in 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
    transform-origin: center;
    transform-box: fill-box;
  }
  @keyframes now-arc-in {
    from { opacity: 0; transform: scale(0.94); }
    to { opacity: 1; transform: scale(1); }
  }
  .now-knob {
    animation: now-knob-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0.9s both;
  }
  @keyframes now-knob-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  .now-ring {
    animation: now-ring-in 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.6s both;
  }
  @keyframes now-ring-in {
    from { stroke-dasharray: 0 999; }
  }
  @media (prefers-reduced-motion: reduce) {
    .now-arc, .now-knob, .now-ring { animation: none !important; }
  }
</style>
