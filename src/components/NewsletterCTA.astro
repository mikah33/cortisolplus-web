---
import { SITE } from '../consts';

interface Props {
  variant?: 'card' | 'inline';
}

const { variant = 'card' } = Astro.props;
---

{variant === 'card' && (
  <aside class="mt-12 p-8 rounded-2xl bg-gradient-to-br from-[color:var(--color-coral)]/8 via-[color:var(--color-mint-soft)] to-[color:var(--color-teal)]/8 border border-[color:var(--color-border)]">
    <div class="text-xs uppercase tracking-widest text-[color:var(--color-coral)] font-medium mb-2">Free newsletter</div>
    <h2 class="text-2xl font-bold mb-2">{SITE.substackName}</h2>
    <p class="text-[color:var(--color-ink-muted)] mb-6 max-w-xl">
      One short, evidence-cited note on cortisol, stress, sleep, or HRV — delivered weekly. No supplement spam, no TikTok takes. Free, unsubscribe anytime.
    </p>
    <a
      href={SITE.substack}
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-gradient-to-br from-[color:var(--color-teal)] to-[color:var(--color-teal-dark)] text-white font-semibold text-sm shadow-sm hover:brightness-110 transition"
    >
      Subscribe to the newsletter
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-4 h-4"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </aside>
)}

{variant === 'inline' && (
  <div class="my-8 p-5 rounded-xl bg-[color:var(--color-surface)] border border-[color:var(--color-border)] flex flex-col sm:flex-row sm:items-center gap-4 not-prose">
    <div class="flex-1">
      <div class="font-semibold text-[color:var(--color-ink)]">Get The Cortisol Brief</div>
      <div class="text-sm text-[color:var(--color-ink-muted)]">One short note on cortisol, weekly. Free.</div>
    </div>
    <a
      href={SITE.substack}
      target="_blank"
      rel="noopener"
      class="inline-flex shrink-0 items-center gap-2 px-4 py-2 rounded-full bg-[color:var(--color-ink)] text-white font-semibold text-sm hover:opacity-90 transition"
    >
      Subscribe →
    </a>
  </div>
)}
