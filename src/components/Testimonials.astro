---
import reviewsData from '../data/reviews.json';
import { APP_RATING } from '../consts';

const reviews = reviewsData.reviews;
---

<section class="max-w-5xl mx-auto px-6 py-20 border-t border-[color:var(--color-border)]">
  <div class="text-center mb-12">
    <div class="text-xs uppercase tracking-widest text-[color:var(--color-teal-dark)] font-medium mb-3">Real reviews · App Store</div>
    <h2 class="text-3xl md:text-4xl font-bold tracking-tight">What users say</h2>
    <div class="flex items-center justify-center gap-2 mt-3 text-sm text-[color:var(--color-ink-muted)]">
      <span class="flex items-center gap-0.5">
        {Array.from({ length: 5 }).map(() => (
          <svg viewBox="0 0 24 24" class="w-4 h-4 text-[#fbbf24]" fill="currentColor">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/>
          </svg>
        ))}
      </span>
      <span><strong class="text-[color:var(--color-ink)]">{APP_RATING.value}</strong> from {APP_RATING.count} ratings</span>
    </div>
  </div>

  <div class="grid md:grid-cols-2 gap-5">
    {reviews.map((r) => (
      <figure class="p-7 rounded-2xl bg-[color:var(--color-surface)] border border-[color:var(--color-border)]">
        <div class="flex items-center gap-0.5 mb-3">
          {Array.from({ length: r.rating }).map(() => (
            <svg viewBox="0 0 24 24" class="w-4 h-4 text-[#fbbf24]" fill="currentColor">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/>
            </svg>
          ))}
        </div>
        <h3 class="text-lg font-semibold mb-2">{r.title}</h3>
        <blockquote class="text-[color:var(--color-ink-muted)] leading-relaxed mb-4">
          "{r.body}"
        </blockquote>
        <figcaption class="text-xs text-[color:var(--color-ink-muted)]">
          — {r.author} · App Store review · v{r.version}
        </figcaption>
      </figure>
    ))}
  </div>
</section>
