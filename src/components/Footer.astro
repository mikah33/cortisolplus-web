---
import { SITE } from '../consts';

const groups = [
  {
    title: 'Tools',
    links: [
      ['/tools/cortisol-calculator', 'Stress & habits check-in'],
      ['/tools/morning-cortisol-test', 'Morning routine check-in'],
      ['/tools/stress-score', 'Stress score quiz'],
      ['/tools/burnout-risk', 'Burnout check-in'],
      ['/tools/sleep-debt-cortisol', 'Sleep habits check-in'],
    ],
  },
  {
    title: 'Cortisol guide',
    links: [
      ['/cortisol', 'Full guide'],
      ['/cortisol/symptoms', 'Symptoms'],
      ['/cortisol/symptoms/cortisol-face', 'Cortisol face'],
      ['/cortisol/lower', 'How to lower'],
      ['/cortisol/foods/ashwagandha', 'Ashwagandha'],
    ],
  },
  {
    title: 'For you',
    links: [
      ['/faq-perimenopause', 'Perimenopause'],
      ['/faq-burnout', 'Burnout'],
      ['/faq-shift-workers', 'Shift workers'],
      ['/faq-athletes', 'Athletes'],
    ],
  },
  {
    title: 'HRV & devices',
    links: [
      ['/hrv', 'HRV & stress'],
      ['/hrv/normal-range', 'Normal HRV by age'],
      ['/stress/apple-watch', 'Apple Watch stress'],
      ['/fitbit', 'Fitbit stress'],
      ['/fitbit/cortisol', 'Fitbit & cortisol'],
    ],
  },
  {
    title: 'Product',
    links: [
      ['/how-it-works', 'How it works'],
      ['/download', 'Download'],
      ['/about', 'About'],
      ['/compare/', 'Compare apps'],
      ['/resources/', 'Free resources'],
      ['/press/', 'Press & product facts'],
    ],
  },
  {
    title: 'Legal',
    links: [
      ['/privacy', 'Privacy'],
      ['/terms', 'Terms'],
      ['/.well-known/security.txt', 'Security'],
    ],
  },
];
---

<footer class="mt-24 pb-10">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="app-card p-5 mb-4">
      <div class="font-extrabold text-lg flex items-center gap-2.5 mb-1">
        <img src="/apple-touch-icon.png" alt="" width="32" height="32" class="w-8 h-8 rounded-[10px]" />
        {SITE.name}
      </div>
      <p class="text-[color:var(--color-ink-muted)] mb-4">Stress, HRV and recovery insights.</p>
      <div class="flex flex-wrap gap-2 text-sm font-bold">
        <a href={SITE.appStoreUrl} class="px-3.5 py-2 rounded-full bg-[color:var(--color-ink)]/90 text-white">App Store</a>
        <a href={SITE.googlePlayUrl} class="px-3.5 py-2 rounded-full bg-[color:var(--color-ink)]/90 text-white">Google Play</a>
        <a href={SITE.youtube} class="px-3.5 py-2 rounded-full bg-[color:var(--color-surface-2)]">YouTube</a>
        <a href={SITE.tiktok} target="_blank" rel="noopener" class="px-3.5 py-2 rounded-full bg-[color:var(--color-surface-2)]">TikTok {SITE.tiktokHandle}</a>
      </div>
    </div>

    <div class="app-card p-5 mb-4">
      <div class="text-sm font-bold text-[color:var(--color-ink-muted)] mb-1">{SITE.substackName}</div>
      <p class="mb-3 leading-relaxed">Weekly notes on cortisol, stress, sleep, and HRV — backed by research, not TikTok takes.</p>
      <a href={SITE.substack} target="_blank" rel="noopener" class="inline-flex items-center px-4 py-2 rounded-full bg-[color:var(--color-teal)] text-[color:var(--color-ink)] font-bold text-sm active:scale-95 transition">Subscribe free</a>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
      {groups.map((group) => (
        <section>
          <h2 class="px-1 pb-1.5 text-[0.8125rem] font-bold text-[color:var(--color-ink-muted)]">{group.title}</h2>
          <ul class="app-card app-list overflow-hidden text-[0.9375rem] font-semibold">
            {group.links.map(([href, label]) => (
              <li><a href={href} class="app-row">{label}<span class="app-chevron">›</span></a></li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <div class="px-1 mt-8 text-xs leading-relaxed text-[color:var(--color-ink-muted)] space-y-2">
      <p>The wellness score does not measure cortisol or provide a diagnosis. Consult a healthcare provider for medical advice.</p>
      <p>© {new Date().getFullYear()} {SITE.name}. All rights reserved.</p>
      <button data-open-privacy class="underline underline-offset-2 font-semibold text-[color:var(--color-ink)]">Privacy choices</button>
    </div>
  </div>
</footer>
