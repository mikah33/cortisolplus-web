    badge: 'Apple Watch essentials',
    alt: 'Cortisol+ Sleep Analysis showing 8 nights tracked, 7.1 h average sleep, 91/100 average quality score, 92% efficiency, 5/8 nights hitting 7-hour goal, plus a nightly duration bar chart and Insights card noting Great Night and Optimal Duration',
  },
  {
    src: '/screenshots/track-metrics.png',
    title: 'Track metrics',
    caption: 'Monthly and daily health tracking. Take control of your trend.',
    badge: 'Real Apple Watch metrics',
    alt: 'Cortisol+ Insights screen displaying 28.5 average cortisol over 4 readings today, fitness panel with HRV 54 ms, resting heart rate 71 bpm, VO2 max 37.6, activity 8,317 steps, sleep duration 7.6 hours with 100 sleep score, and Zen wellness score 75/100',
  },
  {
