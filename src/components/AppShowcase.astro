---
const screens = [
  {
    src: '/screenshots/live-stress-levels.webp',
    title: 'Live stress levels',
    caption: 'The Now dial, HRV and resting heart rate at a glance, plus your day\'s average, high and low.',
    badge: 'Now',
    alt: 'Cortisol+ Now screen with an arc dial showing an example score of 26 labeled Low, HRV 58 ms, resting heart rate 58 bpm, and a Cortisol card with average 32, high 48 and low 23',
  },
  {
    src: '/screenshots/wearable-insights.webp',
    title: 'Insights from your wearable',
    caption: 'A daily suggestion, then cortisol, sleep and recovery cards built from Apple Health data.',
    badge: 'Insights',
    alt: 'Cortisol+ Insights tab on iPhone with a day picker, a suggestion card, Cortisol average 26, Sleep 7.8 hours at 96% quality with 1.3 hours deep, and Recovery with HRV 58 ms, resting heart rate 58 bpm and VO2 max 44.0, next to the Apple Health icon',
  },
  {
    src: '/screenshots/sleep-quality.webp',
    title: 'Optimize your sleep quality',
    caption: 'A nightly quality score, time asleep, efficiency and a stage-by-stage timeline.',
    badge: 'Sleep',
    alt: 'Cortisol+ Sleep tab showing an example night scored 93 Excellent, 7 hours 47 minutes asleep, 96% efficiency, fell asleep 11:12 PM, woke 7:00 AM, and awake, REM, light and deep sleep stages',
  },
  {
    src: '/screenshots/activities.webp',
    title: 'Track all your activities',
    caption: 'Weekly readiness, cardio load, steps and VO₂ max, with runs, rides, swims, strength and yoga.',
    badge: 'Fitness',
    alt: 'Cortisol+ Fitness view with a weekly Readiness chart showing 71 Good, cardio load 14, 9,140 steps, VO2 max 44.0, and workout tiles for bike, strength, run, swim and yoga',
  },
  {
    src: '/screenshots/bio-age.webp',
    title: 'Discover your Bio Age',
    caption: 'An estimate of your pace of aging from recovery data, and what\'s affecting it.',
    badge: 'Bio Age',
    alt: 'Cortisol+ Bio Age screen showing an example Bio Age of 26, 4 years younger, a Pace of Aging of 0.88x on a slower-to-faster scale, and sleep, HRV and resting heart rate tiles',
  },
  {
    src: '/screenshots/zen-ai-assistant.webp',
    title: 'Insights from an AI assistant',
    caption: 'Ask Zen what\'s driving your score and get a plain-English answer from your own numbers.',
    badge: 'Ask Zen',
    alt: 'Cortisol+ Zen chat where the user asks "What\'s driving my score today?" and Zen explains the example score of 26 using sleep, HRV and resting heart rate',
  },
];
---

<section class="relative max-w-7xl mx-auto px-6 py-20 border-t border-[color:var(--color-border)] reveal">
  <div class="text-center max-w-2xl mx-auto mb-12">
    <div class="text-xs uppercase tracking-widest text-[color:var(--color-teal-dark)] font-medium mb-3">Inside the app</div>
    <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4">
      Explore the app
    </h2>
    <p class="text-[color:var(--color-ink-muted)]">
      The same screens you'll find on the App Store: the Now dial, Insights, Sleep, Fitness, Bio Age and Zen. Screens show example values; their score labels do not establish hormone levels or clinical outcomes.
    </p>
  </div>

  <div class="flex gap-5 overflow-x-auto snap-x snap-mandatory pb-6 -mx-6 px-6">
    {screens.map((s) => (
      <figure class="shrink-0 w-[240px] md:w-[270px] snap-center group">
        <div class="rounded-3xl overflow-hidden bg-[#cfe6f7] border border-[color:var(--color-border)] shadow-[0_18px_40px_-24px_rgba(15,20,25,0.35)] aspect-[645/1398] relative">
          <img
            src={s.src}
            alt={s.alt}
            width="645"
            height="1398"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500"
          />
        </div>
        <figcaption class="mt-4 px-1">
          <div class="text-xs uppercase tracking-wider text-[color:var(--color-teal-dark)] font-medium mb-1">{s.badge}</div>
          <div class="font-semibold mb-0.5">{s.title}</div>
          <div class="text-sm text-[color:var(--color-ink-muted)]">{s.caption}</div>
        </figcaption>
      </figure>
    ))}
  </div>

  <div class="text-center mt-4 text-xs text-[color:var(--color-ink-muted)]">
    ← scroll for more →
  </div>
</section>
