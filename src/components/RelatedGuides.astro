---
const path = Astro.url.pathname;
const guides = path.startsWith('/hrv/') || path.startsWith('/stress/') || path.startsWith('/features/') || path.startsWith('/compare/')
  ? [
      ['/stress/apple-watch/', 'Apple Watch stress tracking: setup and limitations'],
      ['/compare/apple-watch-stress-apps/', 'Compare five Apple Watch stress apps'],
      ['/blog/welltory-vs-cortisol-plus/', 'Welltory versus Cortisol+'],
      ['/blog/apple-watch-hrv-not-updating/', 'Troubleshoot missing Apple Watch HRV'],
    ]
  : path.startsWith('/cortisol/') || path.startsWith('/faq-')
  ? [
      ['/cortisol/track/', 'Choose between daily tracking and cortisol testing'],
      ['/cortisol/test/', 'Understand cortisol testing at home'],
      ['/cortisol/lower/', 'Stress-management habits and their evidence'],
      ['/resources/stress-sleep-journal/', 'Use the free stress and sleep journal'],
    ]
  : [];
const related = guides.filter(([href]) => href !== path);
---
{related.length > 0 && <nav aria-label="Related guides" class="mt-10 p-6 rounded-xl border border-[color:var(--color-border)]">
  <h2 class="text-xl font-semibold mb-4">Continue exploring</h2>
  <ul class="space-y-3">{related.map(([href, label]) => <li><a href={href} class="text-[color:var(--color-teal-dark)] underline">{label}</a></li>)}</ul>
</nav>}
