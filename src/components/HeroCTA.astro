---
// Hero call to action: one button for the visitor's phone, into the /start/
// onboarding (plan, checkout, then the app). A small link underneath goes
// straight to that phone's store. Desktop gets a generic start button.
// BaseLayout tags <html data-platform="ios|android|other">.
import { SITE } from '../consts';
import GooglePlayIcon from './icons/GooglePlayIcon.astro';
import { APPLE_PATH } from '../lib/storeIcons';
---

<div class="hero-cta">
  <a href="/start/" class="app-btn w-full" data-only-block="ios" data-event="start-cta">
    <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 -mt-0.5" aria-hidden="true"><path d={APPLE_PATH} /></svg>
    Get Cortisol+ for iPhone
  </a>
  <a href="/start/" class="app-btn w-full" data-only-block="android" data-event="start-cta">
    <GooglePlayIcon class="h-5 w-5" />
    Get Cortisol+ for Android
  </a>
  <a href="/start/" class="app-btn w-full" data-only-block="other" data-event="start-cta">Get started ›</a>

  <p class="mt-3 text-center text-sm text-[color:var(--color-ink-muted)]">
    <a href={SITE.appStoreUrl} data-only="ios" data-event="appstore-click" class="underline underline-offset-2">Or download from the App Store</a>
    <a href={SITE.googlePlayUrl} data-only="android" class="underline underline-offset-2">Or download from Google Play</a>
    <span data-only="other">Or download from the <a href={SITE.appStoreUrl} data-event="appstore-click" class="underline underline-offset-2">App Store</a> or <a href={SITE.googlePlayUrl} class="underline underline-offset-2">Google Play</a></span>
  </p>
</div>

<style>
  /* data-only-block shows as display:block; buttons need their flex layout back. */
  :global(html[data-platform]) .hero-cta .app-btn[data-only-block] { display: none; }
  :global(html[data-platform='ios']) .hero-cta .app-btn[data-only-block='ios'],
  :global(html[data-platform='android']) .hero-cta .app-btn[data-only-block='android'],
  :global(html[data-platform='other']) .hero-cta .app-btn[data-only-block='other'],
  :global(html:not([data-platform])) .hero-cta .app-btn[data-only-block='other'] { display: inline-flex; }
</style>
