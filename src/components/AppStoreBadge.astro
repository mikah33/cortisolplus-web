---
import { SITE } from '../consts';

interface Props {
  size?: 'sm' | 'md' | 'lg';
  label?: string;
  variant?: 'teal' | 'dark';
}

const { size = 'md', label = 'Download on the App Store', variant = 'teal' } = Astro.props;

const sizes = {
  sm: 'px-3.5 py-1.5 text-xs gap-1.5',
  md: 'px-5 py-2.5 text-sm gap-2',
  lg: 'px-7 py-3.5 text-base gap-2.5',
};

const variants = {
  teal: 'bg-gradient-to-br from-[color:var(--color-teal)] to-[color:var(--color-teal-dark)] text-white hover:brightness-110',
  dark: 'bg-[color:var(--color-ink)] text-white hover:opacity-90',
};
---

<a
  href={SITE.appStoreUrl}
  class={`inline-flex items-center rounded-full font-semibold shadow-sm transition ${variants[variant]} ${sizes[size]}`}
  data-event="appstore-click"
>
  <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
    <path d="M17.5 12.5c0-2.6 2.1-3.8 2.2-3.9-1.2-1.7-3-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9-1.7 0-3.4 1-4.3 2.6-1.8 3.2-.5 7.9 1.3 10.5.9 1.3 1.9 2.7 3.3 2.7 1.3-.1 1.8-.9 3.4-.9 1.6 0 2 .9 3.4.9 1.4 0 2.3-1.3 3.2-2.6 1-1.5 1.4-3 1.4-3.1-.1 0-2.7-1-2.7-4.1zM15 4.6c.7-.9 1.2-2.1 1.1-3.3-1 0-2.3.7-3 1.5-.7.8-1.2 2-1.1 3.2 1.1.1 2.3-.6 3-1.4z"/>
  </svg>
  {label}
</a>
