---
interface Props {
  score?: number;
  label?: string;
}
const { score = 42, label = 'Normal' } = Astro.props;

// Compact, integrated speedometer where the score lives INSIDE the bowl
// of the arc, not floating below it. Aspect ratio chosen so the SVG height
// roughly equals the visual height of the gauge — no wasted vertical space.
const viewW = 360;
const viewH = 200;
const cx = viewW / 2;
const cy = 165;        // arc center near bottom — bowl opens fully into the readout area
const r = 130;
const stroke = 22;

const pct = Math.min(100, Math.max(0, score));
const t = pct / 100;

// Top-half semicircle parametrization (left→top→right):
//   x(t) = cx - r*cos(t*pi)
//   y(t) = cy - r*sin(t*pi)
function pointAt(s: number, radius = r) {
  const a = s * Math.PI;
  return { x: cx - radius * Math.cos(a), y: cy - radius * Math.sin(a) };
}

const start = pointAt(0);
const end = pointAt(1);
const arcPath = `M ${start.x} ${start.y} A ${r} ${r} 0 0 1 ${end.x} ${end.y}`;
const indicator = pointAt(t);

const tickPositions = [30, 45, 60];
---

<div class="relative w-full max-w-[420px] mx-auto animate-breathe-slow select-none">
  <svg viewBox={`0 0 ${viewW} ${viewH}`} class="w-full h-auto" aria-hidden="true">
    <defs>
      <linearGradient
        id="gauge-grad"
        x1={start.x} y1="0"
        x2={end.x}   y2="0"
        gradientUnits="userSpaceOnUse"
      >
        <stop offset="0%"   stop-color="#22c55e"/>
        <stop offset="22%"  stop-color="#4ade80"/>
        <stop offset="42%"  stop-color="#a3e635"/>
        <stop offset="56%"  stop-color="#facc15"/>
        <stop offset="72%"  stop-color="#f97316"/>
        <stop offset="100%" stop-color="#ef4444"/>
      </linearGradient>

      <filter id="gauge-arc-glow" x="-10%" y="-10%" width="120%" height="120%">
        <feGaussianBlur stdDeviation="3" result="b"/>
        <feMerge>
          <feMergeNode in="b"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>

      <filter id="indicator-glow" x="-100%" y="-100%" width="300%" height="300%">
        <feGaussianBlur stdDeviation="4" result="b"/>
        <feMerge>
          <feMergeNode in="b"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>
    </defs>

    <!-- Background track -->
    <path
      d={arcPath}
      fill="none"
      stroke="var(--color-surface-2)"
      stroke-width={stroke}
      stroke-linecap="round"
    />

    <!-- Colored gradient arc -->
    <path
      class="gauge-arc"
      d={arcPath}
      fill="none"
      stroke="url(#gauge-grad)"
      stroke-width={stroke}
      stroke-linecap="round"
      filter="url(#gauge-arc-glow)"
    />

    <!-- Zone boundary ticks -->
    {tickPositions.map((p) => {
      const inner = pointAt(p / 100, r - stroke / 2 + 2);
      const outer = pointAt(p / 100, r + stroke / 2 - 2);
      return (
        <line
          x1={inner.x} y1={inner.y}
          x2={outer.x} y2={outer.y}
          stroke="white"
          stroke-width="2.5"
          stroke-linecap="round"
          opacity="0.9"
          class="gauge-tick"
        />
      );
    })}

    <!-- LOW / SEVERE labels under the arc tips -->
    <text
      x={start.x + 14} y={start.y + 18}
      text-anchor="middle"
      class="fill-[color:var(--color-ink-muted)]"
      font-size="10" font-weight="700" letter-spacing="2">LOW</text>
    <text
      x={end.x - 14} y={end.y + 18}
      text-anchor="middle"
      class="fill-[color:var(--color-ink-muted)]"
      font-size="10" font-weight="700" letter-spacing="2">SEVERE</text>

    <!-- Indicator (halo + ring + dot) -->
    <circle
      class="gauge-indicator-halo"
      cx={indicator.x} cy={indicator.y} r="18"
      fill="white"
      opacity="0.6"
      filter="url(#indicator-glow)"
    />
    <circle
      class="gauge-indicator-ring"
      cx={indicator.x} cy={indicator.y} r="12"
      fill="white"
      stroke="var(--color-ink)"
      stroke-width="2.5"
    />
    <circle
      class="gauge-indicator-dot"
      cx={indicator.x} cy={indicator.y} r="4.5"
      fill="var(--color-ink)"
    />
  </svg>

  <!-- Readout sits INSIDE the bowl of the arc, anchored to the arc's center area.
       It's vertically positioned to land below the arc's apex but above the bottom
       of the bowl, matching a real speedometer's center display. -->
  <div
    class="absolute inset-x-0 flex flex-col items-center"
    style="top: 38%;"
  >
    <div
      class="text-4xl md:text-5xl font-bold tracking-tight tabular-nums leading-none"
      data-count-target={score}
    >0</div>
    <div class="text-[9px] uppercase tracking-[0.22em] text-[color:var(--color-ink-muted)] font-semibold mt-1.5">cortisol score</div>
    <div class="mt-1.5 inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-gradient-to-br from-[color:var(--color-teal)]/12 to-[color:var(--color-mint)]/12 text-[color:var(--color-teal-dark)] border border-[color:var(--color-teal)]/25">
      <span class="w-1 h-1 rounded-full bg-[color:var(--color-teal)]"></span>
      {label}
    </div>
  </div>
</div>

<style>
  .gauge-arc {
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
    animation: draw-gauge 1.4s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
  }
  @keyframes draw-gauge { to { stroke-dashoffset: 0; } }

  .gauge-tick {
    opacity: 0;
    animation: fade-in 0.5s ease-out 1.2s forwards;
  }
  @keyframes fade-in { to { opacity: 0.9; } }

  .gauge-indicator-halo,
  .gauge-indicator-ring,
  .gauge-indicator-dot {
    opacity: 0;
    transform-origin: center;
    transform-box: fill-box;
  }
  .gauge-indicator-halo {
    animation:
      indicator-pop 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) 1.45s forwards,
      halo-pulse 2.6s ease-in-out 2s infinite;
  }
  .gauge-indicator-ring {
    animation: indicator-pop 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) 1.5s forwards;
  }
  .gauge-indicator-dot {
    animation: indicator-pop 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) 1.55s forwards;
  }
  @keyframes indicator-pop {
    from { opacity: 0; transform: scale(0.4); }
    to   { opacity: var(--final-opacity, 1); transform: scale(1); }
  }
  .gauge-indicator-halo { --final-opacity: 0.6; }
  @keyframes halo-pulse {
    0%, 100% { opacity: 0.6; transform: scale(1); }
    50%      { opacity: 0.15; transform: scale(1.4); }
  }

  @keyframes breathe-slow {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.01); }
  }
  .animate-breathe-slow { animation: breathe-slow 6.5s ease-in-out infinite; }

  @media (prefers-reduced-motion: reduce) {
    .gauge-arc, .gauge-tick, .gauge-indicator-halo, .gauge-indicator-ring,
    .gauge-indicator-dot, .animate-breathe-slow {
      animation: none !important;
      opacity: 1 !important;
      stroke-dashoffset: 0 !important;
      transform: none !important;
    }
    .gauge-indicator-halo { opacity: 0.6 !important; }
    .gauge-tick { opacity: 0.9 !important; }
  }
</style>
