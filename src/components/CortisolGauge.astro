---
interface Props {
  score?: number;
  label?: string;
}
const { score = 42, label = 'Normal' } = Astro.props;

// Score 0-100 → arc position
const pct = Math.min(100, Math.max(0, score));
const radius = 90;
const circumference = Math.PI * radius;
const arcLength = (pct / 100) * circumference;
---

<div class="relative w-full max-w-[320px] aspect-square mx-auto">
  <svg viewBox="0 0 240 240" class="w-full h-full -rotate-90">
    <defs>
      <linearGradient id="gauge-grad" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="var(--color-teal)" />
        <stop offset="50%" stop-color="var(--color-mint)" />
        <stop offset="100%" stop-color="var(--color-coral)" />
      </linearGradient>
    </defs>
    <!-- Background track -->
    <circle
      cx="120" cy="120" r={radius}
      fill="none"
      stroke="var(--color-surface-2)"
      stroke-width="18"
      stroke-linecap="round"
      stroke-dasharray={`${circumference} ${circumference}`}
      stroke-dashoffset="0"
      transform="rotate(180 120 120)"
    />
    <!-- Active arc -->
    <circle
      cx="120" cy="120" r={radius}
      fill="none"
      stroke="url(#gauge-grad)"
      stroke-width="18"
      stroke-linecap="round"
      stroke-dasharray={`${arcLength} ${circumference}`}
      stroke-dashoffset="0"
      transform="rotate(180 120 120)"
      class="drop-shadow-[0_0_12px_var(--color-teal)]"
    />
  </svg>
  <div class="absolute inset-0 flex flex-col items-center justify-center pt-6">
    <div class="text-6xl font-bold tracking-tight tabular-nums">{score}</div>
    <div class="text-xs uppercase tracking-widest text-[color:var(--color-ink-muted)] mt-2">cortisol score</div>
    <div class="mt-3 px-3 py-1 rounded-full text-xs font-medium bg-[color:var(--color-teal)]/10 text-[color:var(--color-teal-dark)]">
      {label}
    </div>
  </div>
</div>
