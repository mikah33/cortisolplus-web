---
interface Props {
  score?: number;
  label?: string;
}
const { score = 42, label = 'Normal' } = Astro.props;

// SVG geometry
const cx = 150;
const cy = 150;
const r = 110;
const strokeWidth = 22;

// Score 0-100 maps to t = 0 (leftmost) to 1 (rightmost) along the bottom semicircle.
const pct = Math.min(100, Math.max(0, score));
const t = pct / 100;

// Position helpers for the bottom semicircle:
//   x(t) = cx - r*cos(t*pi)
//   y(t) = cy + r*sin(t*pi)
function pointAt(t: number, radius = r) {
  const a = t * Math.PI;
  return {
    x: cx - radius * Math.cos(a),
    y: cy + radius * Math.sin(a),
  };
}

const start = pointAt(0);
const end = pointAt(1);

// Full half-circle arc path
const arcPath = `M ${start.x} ${start.y} A ${r} ${r} 0 0 1 ${end.x} ${end.y}`;

// Indicator dot at the score position
const indicator = pointAt(t);

// Zone boundary tick positions (from iOS CortisolLevel enum)
// Low 0-30 | Normal 30-45 | Elevated 45-60 | High 60-100
const ticks = [
  { pct: 30, label: 'low' },
  { pct: 45, label: 'normal' },
  { pct: 60, label: 'elevated' },
];

// Label positions (slightly offset outside the arc)
const labelLow = pointAt(0, r + 18);
const labelSevere = pointAt(1, r + 18);

const viewW = 300;
const viewH = 200;
---

<div class="relative w-full max-w-[360px] mx-auto animate-breathe-slow">
  <svg viewBox={`0 0 ${viewW} ${viewH}`} class="w-full h-auto" aria-hidden="true">
    <defs>
      <!-- Speedometer-style gradient: green (healthy) → red (severe).
           Coordinates in userSpaceOnUse so the gradient maps along the arc's
           horizontal span left-to-right. -->
      <linearGradient
        id="gauge-grad"
        x1={start.x} y1="0"
        x2={end.x}   y2="0"
        gradientUnits="userSpaceOnUse"
      >
        <stop offset="0%"   stop-color="#34c759"/>{/* low (green) */}
        <stop offset="30%"  stop-color="#5bc77a"/>
        <stop offset="45%"  stop-color="#f5c344"/>{/* normal→elevated handoff */}
        <stop offset="60%"  stop-color="#ff9500"/>{/* elevated (orange) */}
        <stop offset="100%" stop-color="#ff3b30"/>{/* high (red) */}
      </linearGradient>

      <filter id="gauge-glow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="2" result="blur"/>
        <feMerge>
          <feMergeNode in="blur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>
    </defs>

    <!-- Background track -->
    <path
      d={arcPath}
      fill="none"
      stroke="var(--color-surface-2)"
      stroke-width={strokeWidth}
      stroke-linecap="round"
    />

    <!-- Animated colored arc (full scale, drawn on mount) -->
    <path
      class="gauge-arc"
      d={arcPath}
      fill="none"
      stroke="url(#gauge-grad)"
      stroke-width={strokeWidth}
      stroke-linecap="round"
      filter="url(#gauge-glow)"
    />

    <!-- Zone boundary tick marks -->
    {ticks.map((tick) => {
      const inner = pointAt(tick.pct / 100, r - strokeWidth / 2 - 4);
      const outer = pointAt(tick.pct / 100, r + strokeWidth / 2 + 4);
      return (
        <line
          x1={inner.x} y1={inner.y}
          x2={outer.x} y2={outer.y}
          stroke="white"
          stroke-width="2"
          stroke-linecap="round"
          opacity="0.85"
          class="gauge-tick"
        />
      );
    })}

    <!-- Indicator dot at the user's score -->
    <circle
      class="gauge-indicator-ring"
      cx={indicator.x} cy={indicator.y} r="14"
      fill="white"
      opacity="0.85"
    />
    <circle
      class="gauge-indicator"
      cx={indicator.x} cy={indicator.y} r="9"
      fill="white"
      stroke="var(--color-ink)"
      stroke-width="3"
    />

    <!-- Side zone labels -->
    <text x={labelLow.x} y={labelLow.y + 6} text-anchor="middle"
          class="fill-[color:var(--color-ink-muted)]"
          font-size="11" font-weight="600"
          letter-spacing="1.5">LOW</text>
    <text x={labelSevere.x} y={labelSevere.y + 6} text-anchor="middle"
          class="fill-[color:var(--color-ink-muted)]"
          font-size="11" font-weight="600"
          letter-spacing="1.5">SEVERE</text>
  </svg>

  <!-- Center readout (positioned over the gauge) -->
  <div class="absolute inset-0 flex flex-col items-center justify-center" style="padding-top: 8%;">
    <div
      class="text-[5.5rem] md:text-[6rem] font-bold tracking-tight tabular-nums leading-none"
      data-count-target={score}
    >0</div>
    <div class="text-[10px] uppercase tracking-[0.18em] text-[color:var(--color-ink-muted)] mt-2 font-medium">cortisol score</div>
    <div class="mt-2 px-3 py-1 rounded-full text-xs font-semibold bg-[color:var(--color-teal)]/10 text-[color:var(--color-teal-dark)] border border-[color:var(--color-teal)]/20">
      {label}
    </div>
  </div>
</div>

<style>
  /* Animate the full-scale gradient arc on mount */
  .gauge-arc {
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
    animation: draw-gauge 1.4s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
  }
  @keyframes draw-gauge {
    to { stroke-dashoffset: 0; }
  }

  /* Zone ticks fade in after the arc finishes */
  .gauge-tick {
    opacity: 0;
    animation: fade-in 0.4s ease-out 1.2s forwards;
  }
  @keyframes fade-in {
    to { opacity: 0.85; }
  }

  /* Indicator dot pops in after ticks settle */
  .gauge-indicator, .gauge-indicator-ring {
    opacity: 0;
    transform-origin: center;
    animation: indicator-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 1.4s forwards;
  }
  .gauge-indicator-ring {
    animation:
      indicator-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 1.4s forwards,
      indicator-ring-pulse 2.4s ease-in-out 2s infinite;
  }
  @keyframes indicator-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes indicator-ring-pulse {
    0%, 100% { opacity: 0.85; transform: scale(1); transform-origin: var(--indicator-cx, 50%) var(--indicator-cy, 50%); }
    50%      { opacity: 0.45; transform: scale(1.25); transform-origin: var(--indicator-cx, 50%) var(--indicator-cy, 50%); }
  }
  .gauge-indicator-ring { transform-box: fill-box; }

  @keyframes breathe-slow {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.012); }
  }
  .animate-breathe-slow { animation: breathe-slow 6s ease-in-out infinite; }
</style>
