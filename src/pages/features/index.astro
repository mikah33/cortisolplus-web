---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RatingBadge from '../../components/RatingBadge.astro';
import AppStoreBadge from '../../components/AppStoreBadge.astro';
import { SITE } from '../../consts';

const features = [
  {
    href: '/features/hrv-stress-monitoring',
    title: 'HRV stress monitoring',
    body: 'Explore available Apple Watch HRV and other inputs in a wellness score, with a published explanation of weights, baselines and limits.',
    badge: 'Wearable trends',
    color: 'teal',
  },
  {
    href: '/features/sleep-cortisol-tracking',
    title: 'Sleep and stress patterns',
    body: 'Review available sleep records alongside wearable trends. Sleep data adds context but cannot identify a hormone cause.',
    badge: 'Overnight',
    color: 'coral',
  },
  {
    href: '/features/breathing-zen-mode',
    title: 'Zen mode & breathwork',
    body: 'Follow an animated breathing timer with phase prompts and a cycle counter. A session is a guided practice, not a hormone test.',
    badge: 'Guided practice',
    color: 'mint',
  },
];

const colorMap: Record<string, string> = {
  teal: 'from-[color:var(--color-teal)]/12 via-[color:var(--color-mint-soft)] to-white border-[color:var(--color-teal)]/20 hover:border-[color:var(--color-teal)]/50 hover:shadow-[color:var(--color-teal)]/25',
  coral: 'from-[color:var(--color-coral)]/12 via-[color:var(--color-coral)]/5 to-white border-[color:var(--color-coral)]/20 hover:border-[color:var(--color-coral)]/50 hover:shadow-[color:var(--color-coral)]/25',
  mint: 'from-[color:var(--color-mint)]/40 via-[color:var(--color-mint-soft)] to-white border-[color:var(--color-mint)]/40 hover:border-[color:var(--color-teal)]/50 hover:shadow-[color:var(--color-mint)]/40',
};

const badgeMap: Record<string, string> = {
  teal: 'bg-[color:var(--color-teal)]/15 text-[color:var(--color-teal-dark)]',
  coral: 'bg-[color:var(--color-coral)]/15 text-[color:var(--color-coral-dark)]',
  mint: 'bg-[color:var(--color-teal)]/15 text-[color:var(--color-teal-dark)]',
};

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Cortisol+ features',
    url: `${SITE.url}/features/`,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: features.map((f, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${SITE.url}${f.href}/`,
        name: f.title,
      })),
    },
  },
];
---

<BaseLayout
  title="Cortisol+ features — HRV, sleep & breathwork"
  description="Explore Cortisol+ HRV stress monitoring, Apple Watch sleep data and guided breathing. See how each feature works and what its results cannot establish."
  image="/screenshots/track-cortisol-levels.png"
  schema={schema}
>
  <article class="max-w-5xl mx-auto px-6 py-16">
    <div class="max-w-3xl mb-12">
      <div class="text-xs uppercase tracking-widest text-[color:var(--color-teal-dark)] font-medium mb-3">Features</div>
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight leading-[1.05] mb-6">
        Everything <span class="bg-gradient-to-r from-[color:var(--color-teal)] to-[color:var(--color-coral)] bg-clip-text text-transparent">Cortisol+</span> does
      </h1>
      <p class="text-xl text-[color:var(--color-ink-muted)] leading-relaxed mb-4">
        Wearable stress trends, sleep context and guided breathing, with clear explanations of what the data means.
      </p>
      <p class="text-[color:var(--color-ink-muted)] leading-relaxed">
        Cortisol+ brings available Apple Watch readings into a wellness view. Start with the underlying HRV and sleep records, understand the assumptions behind the score, and use the breathing exercise as a short guided pause. The app does not measure cortisol or prove that a lifestyle change affected hormone levels.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-5 mb-16">
      {features.map((f) => (
        <a href={f.href} class={`group relative block p-7 rounded-3xl bg-gradient-to-br ${colorMap[f.color]} border hover:-translate-y-1 hover:shadow-[0_20px_60px_-15px] transition-all duration-300 overflow-hidden`}>
          <div class="relative">
            <span class={`inline-block px-2.5 py-1 rounded-full text-xs font-semibold mb-4 ${badgeMap[f.color]}`}>{f.badge}</span>
            <h2 class="text-xl font-bold mb-2 group-hover:text-[color:var(--color-teal-dark)] transition-colors">{f.title}</h2>
            <p class="text-sm text-[color:var(--color-ink-muted)] leading-relaxed mb-4">{f.body}</p>
            <div class="text-sm font-medium text-[color:var(--color-teal-dark)] flex items-center gap-1">
              Learn more
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="max-w-3xl mb-16">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-6">The three features, in depth</h2>

      <h3 class="text-xl font-bold mb-2">1. HRV stress monitoring</h3>
      <p class="text-[color:var(--color-ink-muted)] leading-relaxed mb-3">Review available HRV, heart rate and other factors behind the wellness score. Check timestamps and missing inputs before interpreting a change. Personal baselines provide context; they do not establish clinical accuracy.</p>
      <p class="mb-6"><a href="/features/hrv-stress-monitoring/" class="text-sm font-medium text-[color:var(--color-teal-dark)]">Explore HRV stress monitoring →</a></p>
      <h3 class="text-xl font-bold mb-2">2. Sleep and stress patterns</h3>
      <p class="text-[color:var(--color-ink-muted)] leading-relaxed mb-3">View the sleep information available through Apple Health alongside your wearable history. Record completeness and your own observations matter. The app cannot explain a nighttime awakening or infer a morning cortisol level.</p>
      <p class="mb-6"><a href="/features/sleep-cortisol-tracking/" class="text-sm font-medium text-[color:var(--color-teal-dark)]">Explore sleep tracking →</a></p>
      <h3 class="text-xl font-bold mb-2">3. Guided breathing</h3>
      <p class="text-[color:var(--color-ink-muted)] leading-relaxed mb-3">Use a short animated exercise with breathe-in, hold and breathe-out prompts. You can finish the cycles or end early. A completed timer does not guarantee a particular physiological result.</p>
      <p class="mb-2"><a href="/features/breathing-zen-mode/" class="text-sm font-medium text-[color:var(--color-teal-dark)]">Explore guided breathing →</a></p>
    </div>

    <aside class="p-8 rounded-3xl bg-gradient-to-br from-[color:var(--color-mint-soft)] to-white border border-[color:var(--color-teal)]/20">
      <div class="text-xs uppercase tracking-widest text-[color:var(--color-teal-dark)] font-semibold mb-2">Get started</div>
      <h2 class="text-2xl md:text-3xl font-bold mb-3">Free on the App Store</h2>
      <p class="text-[color:var(--color-ink-muted)] mb-6 max-w-2xl">
        Requires a compatible iPhone and available Apple Health data. Analysis requires an active subscription or an eligible trial; check the current in-app offer.
      </p>
      <div class="flex flex-wrap items-center gap-4">
        <AppStoreBadge size="lg" />
        <RatingBadge size="sm" />
      </div>
    </aside>
  </article>
</BaseLayout>
