---
import AudienceFAQPage from '../components/AudienceFAQPage.astro';

const faqs = [
  {
    "q": "Can a wearable tell me whether I am in perimenopause?",
    "a": "Cortisol+ cannot diagnose perimenopause or measure reproductive hormones. If you are concerned about changes in periods, sleep or other symptoms, discuss those changes directly with a healthcare professional."
  },
  {
    "q": "Does waking at 3 a.m. mean my cortisol is high?",
    "a": "No. A wake-up time or sleep-stage estimate cannot identify a hormone cause. Record the interruption and anything you noticed, rather than labeling it a cortisol spike."
  },
  {
    "q": "Can the app help me track symptoms?",
    "a": "You can compare available HRV and sleep with notes you keep about your experience. The score itself does not identify which symptom caused a change. Keep observations and interpretations separate."
  },
  {
    "q": "Can an app score show that hormone therapy worked?",
    "a": "No. It cannot choose a hormone treatment, measure hormone concentrations or confirm treatment effectiveness. Discuss goals, benefits, side effects and follow-up with the clinician managing your care."
  },
  {
    "q": "Does a change in weight prove a cortisol problem?",
    "a": "No. Cortisol+ cannot explain a change in weight or body composition. A symptom quiz or wearable score cannot determine whether a particular hormone is responsible."
  }
];

const related = [
  {
    "href": "/how-it-works/",
    "title": "Scoring methodology",
    "hint": "Inputs and limitations"
  },
  {
    "href": "/resources/stress-sleep-journal/",
    "title": "Free observation journal",
    "hint": "Notes you control"
  },
  {
    "href": "/features/sleep-cortisol-tracking/",
    "title": "Sleep tracking guide",
    "hint": "Check the records"
  }
];
---

<AudienceFAQPage
  audience="Perimenopause"
  title="Cortisol, Sleep & Perimenopause: Tracking FAQ"
  description="Learn what wearable sleep and HRV records can contribute during perimenopause, and why they cannot identify a hormone cause or choose treatment."
  intro="Use wearable information to describe your experience. It cannot distinguish a menopause symptom from a cortisol disorder."
  {faqs}
  {related}
/>
