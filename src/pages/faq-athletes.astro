---
import AudienceFAQPage from '../components/AudienceFAQPage.astro';

const faqs = [
  {
    "q": "Does a low HRV reading mean I am overtraining?",
    "a": "No. Cortisol+ has no validated HRV threshold for diagnosing overtraining. Check the measurement method, timestamp and your own history. Discuss persistent performance changes or symptoms with an appropriate professional rather than making a diagnosis from the score."
  },
  {
    "q": "What percentage drop means I should deload?",
    "a": "There is no universal Cortisol+ cutoff. Our earlier website suggestion of a 10% HRV drop plus a 5 bpm resting-heart-rate increase was not a validated app rule. Your training plan, performance, symptoms and recovery context matter."
  },
  {
    "q": "Can the app measure my training cortisol?",
    "a": "No. It uses available Apple Health records and model assumptions to create a wellness score. It cannot determine whether an exercise-related hormone response has returned to normal."
  },
  {
    "q": "How can I use the app with my coach?",
    "a": "Review comparable HRV and sleep records alongside a training log. Note the session, how you felt and whether the wearable record was complete. Share only the information you choose; the app score is context, not a prescribed training load."
  },
  {
    "q": "Can the score show whether a recovery supplement worked?",
    "a": "No. A before-and-after change cannot isolate a supplement effect or establish a hormone change. The app should not be used to select supplements or replace advice about persistent symptoms."
  }
];

const related = [
  {
    "href": "/how-it-works/",
    "title": "Scoring methodology",
    "hint": "Inputs and limitations"
  },
  {
    "href": "/resources/stress-sleep-journal/",
    "title": "Free observation journal",
    "hint": "Notes you control"
  },
  {
    "href": "/features/sleep-cortisol-tracking/",
    "title": "Sleep tracking guide",
    "hint": "Check the records"
  }
];
---

<AudienceFAQPage
  audience="Athletes"
  title="Cortisol, HRV & Training: Athlete FAQ"
  description="Use HRV and sleep as training context without treating a wearable score as a cortisol test or an overtraining diagnosis."
  intro="Wearable records can support a training conversation. They cannot tell you that cortisol caused a performance change."
  {faqs}
  {related}
/>
