---
// Landing page for Circle invite links shared from the app:
//   https://cortisolplus.com/circle/join?code=CRT-XXXXXX
//
// On iOS with the app installed this page is never seen — the Universal Link
// declared in /.well-known/apple-app-site-association hands the URL straight to
// the app, which opens JoinCircleConfirmView. This page is the fallback for
// everyone else: no app yet, Android, desktop, or an in-app browser (Instagram /
// TikTok / Messenger) that swallows Universal Links.
//
// The invite code is only in the query string, and this is a static build, so
// it's read client-side. Nothing here talks to Firestore — the code is shown so
// it can be copied and pasted into Connect → Join by code after install.

import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';
---

<BaseLayout
  title="Join a Circle | Cortisol+"
  description="You've been invited to a Cortisol+ Circle. Get the app and enter your invite code to join."
  noindex={true}
>
  <section class="max-w-lg mx-auto px-6 py-12 sm:py-16">
    <!-- Invite header -->
    <div class="text-center">
      <div
        class="mx-auto w-16 h-16 rounded-2xl flex items-center justify-center bg-gradient-to-br from-[color:var(--color-teal)] to-[color:var(--color-teal-dark)] shadow-sm"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
          <circle cx="9" cy="7" r="4" />
          <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
          <path d="M16 3.13a4 4 0 0 1 0 7.75" />
        </svg>
      </div>

      <h1 class="mt-5 text-2xl sm:text-3xl font-bold tracking-tight text-[color:var(--color-ink)]">
        You've been invited to a Circle
      </h1>
      <p class="mt-3 text-[color:var(--color-ink-muted)]">
        Circles let you and a few people share stress, sleep, and recovery
        trends — and cheer each other on.
      </p>
    </div>

    <!-- Invite code card (populated client-side from ?code=) -->
    <div id="code-card" class="mt-8 hidden">
      <p class="text-center text-xs font-semibold uppercase tracking-widest text-[color:var(--color-ink-muted)]">
        Your invite code
      </p>
      <div
        class="mt-3 rounded-2xl border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-5 text-center"
      >
        <p
          id="code-value"
          class="text-3xl sm:text-4xl font-bold tracking-[0.15em] font-mono text-[color:var(--color-ink)] select-all"
        >
        </p>
        <button
          id="copy-btn"
          type="button"
          class="mt-4 inline-flex items-center gap-2 rounded-full border border-[color:var(--color-border)] bg-[color:var(--color-bg)] px-4 py-2 text-sm font-semibold text-[color:var(--color-ink)] transition hover:border-[color:var(--color-teal)] hover:text-[color:var(--color-teal)]"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
          </svg>
          <span id="copy-label">Copy code</span>
        </button>
      </div>
    </div>

    <!-- Shown when the link arrived without a usable code -->
    <div
      id="no-code"
      class="mt-8 hidden rounded-2xl border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-5 text-center"
    >
      <p class="text-sm text-[color:var(--color-ink-muted)]">
        This invite link is missing its code. Ask whoever invited you to share
        the link again, or to send you the <strong>CRT-</strong> code from
        their Circle screen.
      </p>
    </div>

    <!-- Steps -->
    <ol class="mt-10 space-y-5">
      <li class="flex gap-4">
        <span
          class="shrink-0 w-7 h-7 rounded-full bg-[color:var(--color-teal)] text-white text-sm font-bold flex items-center justify-center"
          >1</span
        >
        <div>
          <p class="font-semibold text-[color:var(--color-ink)]">Get Cortisol+</p>
          <p class="mt-1 text-sm text-[color:var(--color-ink-muted)]">
            Free on the App Store, for iPhone and Apple Watch.
          </p>
          <a
            href={SITE.appStoreUrl}
            class="mt-3 inline-flex items-center gap-2 rounded-full bg-gradient-to-br from-[color:var(--color-teal)] to-[color:var(--color-teal-dark)] px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:brightness-110"
            data-event="appstore-click"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
              <path
                d="M17.5 12.5c0-2.6 2.1-3.8 2.2-3.9-1.2-1.7-3-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9-1.7 0-3.4 1-4.3 2.6-1.8 3.2-.5 7.9 1.3 10.5.9 1.3 1.9 2.7 3.3 2.7 1.3-.1 1.8-.9 3.4-.9 1.6 0 2 .9 3.4.9 1.4 0 2.3-1.3 3.2-2.6 1-1.5 1.4-3 1.4-3.1-.1 0-2.7-1-2.7-4.1zM15 4.6c.7-.9 1.2-2.1 1.1-3.3-1 0-2.3.7-3 1.5-.7.8-1.2 2-1.1 3.2 1.1.1 2.3-.6 3-1.4z"
              />
            </svg>
            Download on the App Store
          </a>
        </div>
      </li>

      <li class="flex gap-4">
        <span
          class="shrink-0 w-7 h-7 rounded-full bg-[color:var(--color-teal)] text-white text-sm font-bold flex items-center justify-center"
          >2</span
        >
        <div>
          <p class="font-semibold text-[color:var(--color-ink)]">Open the Connect tab</p>
          <p class="mt-1 text-sm text-[color:var(--color-ink-muted)]">
            Tap <strong>Join by code</strong>, then paste the code above.
            You'll see the Circle before you commit to joining.
          </p>
        </div>
      </li>
    </ol>

    <!-- Escape hatch: app is installed but the Universal Link didn't fire
         (common inside Instagram / TikTok / Messenger web views). -->
    <div class="mt-10 border-t border-[color:var(--color-border)] pt-6 text-center">
      <p class="text-sm text-[color:var(--color-ink-muted)]">Already have the app?</p>
      <a
        id="open-app"
        href="#"
        class="mt-2 inline-block text-sm font-semibold text-[color:var(--color-teal)] hover:text-[color:var(--color-teal-dark)] hidden"
      >
        Open this invite in Cortisol+ →
      </a>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    function initCircleJoin() {
      var card = document.getElementById('code-card');
      if (!card) return; // not on this page

      var value = document.getElementById('code-value');
      var noCode = document.getElementById('no-code');
      var copyBtn = document.getElementById('copy-btn');
      var copyLabel = document.getElementById('copy-label');
      var openApp = document.getElementById('open-app');

      // Normalize the same way CircleService.findCircle(byCode:) does — trim
      // and uppercase — then validate the shape before putting it in the DOM.
      // Codes are "CRT-" + 6 chars from ABCDEFGHJKLMNPQRSTUVWXYZ23456789; the
      // bound is loose so a future format tweak doesn't break this page.
      var raw = new URLSearchParams(window.location.search).get('code') || '';
      var code = raw.trim().toUpperCase();
      var valid = /^CRT-[A-Z0-9]{4,12}$/.test(code);

      if (!valid) {
        noCode.classList.remove('hidden');
        return;
      }

      value.textContent = code;
      card.classList.remove('hidden');

      // Custom-scheme fallback. Only offered on iOS: on any other platform the
      // link is dead and would just look broken.
      if (/iPad|iPhone|iPod/.test(navigator.userAgent)) {
        openApp.href = 'cortisolplus://circle/join?code=' + encodeURIComponent(code);
        openApp.classList.remove('hidden');
      }

      copyBtn.addEventListener('click', function () {
        function done() {
          copyLabel.textContent = 'Copied';
          setTimeout(function () {
            copyLabel.textContent = 'Copy code';
          }, 2000);
        }

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(code).then(done, selectFallback);
        } else {
          selectFallback();
        }

        // Older / in-app browsers with no async clipboard: select the code so
        // a long-press → Copy still works.
        function selectFallback() {
          var range = document.createRange();
          range.selectNodeContents(value);
          var sel = window.getSelection();
          sel.removeAllRanges();
          sel.addRange(range);
        }
      });
    }

    initCircleJoin();
    // BaseLayout uses <ClientRouter />, so re-run after client-side navigation.
    document.addEventListener('astro:page-load', initCircleJoin);
  })();
</script>
