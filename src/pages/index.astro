---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppStoreBadge from '../components/AppStoreBadge.astro';
import RatingBadge from '../components/RatingBadge.astro';
import CortisolGauge from '../components/CortisolGauge.astro';
import TodayPattern from '../components/TodayPattern.astro';
import AppShowcase from '../components/AppShowcase.astro';
import Testimonials from '../components/Testimonials.astro';
import reviewsData from '../data/reviews.json';
import { SITE, SOCIAL_PROFILES, APP_RATING, PUBLISHER } from '../consts';

const homeSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    logo: `${SITE.url}/icon-512.png`,
    sameAs: SOCIAL_PROFILES,
    parentOrganization: {
      '@type': 'Organization',
      name: PUBLISHER.name,
      url: PUBLISHER.url,
      email: PUBLISHER.email,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: SITE.fullName,
    alternateName: SITE.name,
    operatingSystem: 'iOS 17+, watchOS',
    applicationCategory: 'HealthApplication',
    description: SITE.description,
    downloadUrl: SITE.appStoreUrl,
    installUrl: SITE.appStoreUrl,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: APP_RATING.value,
      ratingCount: APP_RATING.count,
      bestRating: APP_RATING.best,
      worstRating: APP_RATING.worst,
    },
    review: reviewsData.reviews.map((r) => ({
      '@type': 'Review',
      reviewRating: {
        '@type': 'Rating',
        ratingValue: r.rating,
        bestRating: 5,
        worstRating: 1,
      },
      author: { '@type': 'Person', name: r.author },
      datePublished: r.datePublished,
      name: r.title,
      reviewBody: r.body,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
  },
];
---

<BaseLayout
  title="Cortisol+ — Track your cortisol on Apple Watch"
  description="Real-time cortisol estimation powered by Apple Watch biometrics. See your stress, sleep, and recovery — decoded."
  image="/screenshots/track-cortisol-levels.png"
  schema={homeSchema}
>
  <!-- HERO with soft mint-to-white gradient (LaunchBg vibe) -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-[color:var(--color-mint-soft)] via-transparent to-transparent pointer-events-none"></div>
    <div class="absolute top-20 -right-32 w-[500px] h-[500px] rounded-full bg-[color:var(--color-coral)]/10 blur-3xl pointer-events-none"></div>
    <div class="absolute top-40 -left-32 w-[400px] h-[400px] rounded-full bg-[color:var(--color-teal)]/10 blur-3xl pointer-events-none"></div>

    <div class="relative max-w-6xl mx-auto px-6 pt-20 pb-24 md:pt-32 md:pb-32">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div class="text-center">
          <div class="flex flex-wrap items-center justify-center gap-2 mb-6">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[color:var(--color-teal)]/10 border border-[color:var(--color-teal)]/20 text-xs font-medium text-[color:var(--color-teal-dark)]">
              <span class="relative flex w-1.5 h-1.5">
                <span class="absolute inline-flex w-full h-full rounded-full bg-[color:var(--color-teal)] opacity-75 animate-ping"></span>
                <span class="relative inline-flex w-1.5 h-1.5 rounded-full bg-[color:var(--color-teal)]"></span>
              </span>
              Trusted by 5,000+ users · 171 countries
            </div>
            <RatingBadge size="sm" />
          </div>

          <h1 class="text-5xl md:text-7xl font-bold tracking-tight leading-[1.02] mb-6">
            Your stress,<br/>
            <span class="bg-gradient-to-r from-[color:var(--color-teal)] to-[color:var(--color-coral)] bg-clip-text text-transparent">decoded.</span>
          </h1>

          <p class="text-xl text-[color:var(--color-ink-muted)] mb-8 max-w-lg mx-auto leading-relaxed">
            Cortisol+ estimates your cortisol in real time using HRV, sleep stages, and 10+ Apple Watch signals — no lab, no needles.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 items-center justify-center mb-8">
            <AppStoreBadge size="lg" />
            <a href="/how-it-works" class="group inline-flex items-center gap-1 text-sm text-[color:var(--color-ink-muted)] hover:text-[color:var(--color-teal)] transition">
              See the science
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>
          </div>

          <!-- Trust pills -->
          <ul class="flex flex-wrap justify-center gap-2 text-xs">
            <li class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[color:var(--color-surface)] border border-[color:var(--color-border)]">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-3.5 h-3.5 text-[color:var(--color-teal)]"><path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Free to download
            </li>
            <li class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[color:var(--color-surface)] border border-[color:var(--color-border)]">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-3.5 h-3.5 text-[color:var(--color-teal)]"><path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              No subscription required
            </li>
            <li class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[color:var(--color-surface)] border border-[color:var(--color-border)]">
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5 text-[color:var(--color-teal)]"><path d="M17.5 12.5c0-2.6 2.1-3.8 2.2-3.9-1.2-1.7-3-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9-1.7 0-3.4 1-4.3 2.6-1.8 3.2-.5 7.9 1.3 10.5.9 1.3 1.9 2.7 3.3 2.7 1.3-.1 1.8-.9 3.4-.9 1.6 0 2 .9 3.4.9 1.4 0 2.3-1.3 3.2-2.6 1-1.5 1.4-3 1.4-3.1-.1 0-2.7-1-2.7-4.1zM15 4.6c.7-.9 1.2-2.1 1.1-3.3-1 0-2.3.7-3 1.5-.7.8-1.2 2-1.1 3.2 1.1.1 2.3-.6 3-1.4z"/></svg>
              Apple Watch
            </li>
            <li class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[color:var(--color-surface)] border border-[color:var(--color-border)]">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-3.5 h-3.5 text-[color:var(--color-teal)]"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke-linecap="round" stroke-linejoin="round"/></svg>
              On-device privacy
            </li>
          </ul>
        </div>

        <div class="relative" id="hero-card-wrap">
          <div class="absolute inset-0 bg-gradient-to-br from-[color:var(--color-teal)]/25 via-[color:var(--color-mint)]/15 to-[color:var(--color-coral)]/25 blur-3xl rounded-full"></div>
          <div
            id="hero-card"
            class="relative p-8 rounded-3xl bg-[color:var(--color-bg)]/70 backdrop-blur-xl border border-white/40 shadow-[0_30px_80px_-20px_rgba(0,191,166,0.25)] transition-transform duration-300 ease-out"
            style="transform-style: preserve-3d; will-change: transform;"
          >
            <!-- Top header strip -->
            <div class="flex items-center justify-between mb-2 text-[10px] uppercase tracking-[0.18em] text-[color:var(--color-ink-muted)]">
              <div class="flex items-center gap-1.5 font-medium">
                <span class="relative flex w-1.5 h-1.5">
                  <span class="absolute inline-flex w-full h-full rounded-full bg-[color:var(--color-level-low)] opacity-75 animate-ping"></span>
                  <span class="relative inline-flex w-1.5 h-1.5 rounded-full bg-[color:var(--color-level-low)]"></span>
                </span>
                Live
              </div>
              <span class="tabular-nums">Tue · 2:34 PM</span>
            </div>

            <CortisolGauge score={42} label="Normal" />

            <div class="flex items-center justify-between text-xs">
              <span class="inline-flex items-center gap-1 text-[color:var(--color-level-low)] font-medium">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-3.5 h-3.5"><path d="M7 17l9.5-9.5M7 7h10v10" stroke-linecap="round" stroke-linejoin="round" transform="rotate(90 12 12)"/></svg>
                5 points lower than earlier
              </span>
              <span class="text-[color:var(--color-ink-muted)]">7-day avg: 38</span>
            </div>

            <TodayPattern />
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    function initHeroTilt() {
      const card = document.getElementById('hero-card');
      const wrap = document.getElementById('hero-card-wrap');
      if (!card || !wrap || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      // Skip on touch devices — tilt feels weird without a cursor
      if (window.matchMedia('(hover: none)').matches) return;
      const max = 6; // degrees
      const onMove = (e: MouseEvent) => {
        const rect = wrap.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width;
        const y = (e.clientY - rect.top) / rect.height;
        const rx = (0.5 - y) * max;
        const ry = (x - 0.5) * max;
        (card as HTMLElement).style.transform = `perspective(1000px) rotateX(${rx}deg) rotateY(${ry}deg)`;
      };
      const reset = () => {
        (card as HTMLElement).style.transform = 'perspective(1000px) rotateX(0) rotateY(0)';
      };
      wrap.addEventListener('mousemove', onMove);
      wrap.addEventListener('mouseleave', reset);
    }
    initHeroTilt();
    document.addEventListener('astro:after-swap', initHeroTilt);
  </script>

  <AppShowcase />

  <!-- SOCIAL PROOF / RATING -->
  <section class="max-w-5xl mx-auto px-6 py-16 border-t border-[color:var(--color-border)] reveal">
    <div class="grid md:grid-cols-3 gap-6 items-center text-center md:text-left">
      <div>
        <div class="flex items-center justify-center md:justify-start gap-1 mb-2">
          {Array.from({ length: 5 }).map((_, i) => (
            <svg
              viewBox="0 0 24 24"
              class="w-6 h-6 text-[#fbbf24] origin-center"
              fill="currentColor"
              style={`animation: float-slow 4s ease-in-out ${i * 0.15}s infinite;`}
            >
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/>
            </svg>
          ))}
        </div>
        <div
          class="text-5xl font-bold tracking-tight tabular-nums bg-gradient-to-br from-[color:var(--color-teal)] to-[color:var(--color-coral)] bg-clip-text text-transparent"
          data-count-target={APP_RATING.value}
          data-count-decimals="1"
        >0.0</div>
        <div class="text-sm text-[color:var(--color-ink-muted)] mt-1">
          <span data-count-target={APP_RATING.count}>0</span> ratings · App Store
        </div>
      </div>
      <div class="md:col-span-2">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-3">Loved by early users</h2>
        <p class="text-[color:var(--color-ink-muted)] mb-4">
          {APP_RATING.value} out of 5 stars across {APP_RATING.count} ratings on the App Store — and growing every week. People with Apple Watches who actually want to understand their stress.
        </p>
        <AppStoreBadge size="md" />
      </div>
    </div>
  </section>

  <script>
    function animateCounters() {
      const elements = document.querySelectorAll<HTMLElement>('[data-count-target]');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const target = parseFloat(el.dataset.countTarget || '0');
          const decimals = parseInt(el.dataset.countDecimals || '0', 10);
          const duration = 1100;
          const start = performance.now();
          const startVal = 0;
          function tick(now: number) {
            const t = Math.min(1, (now - start) / duration);
            const eased = 1 - Math.pow(1 - t, 3);
            const value = startVal + (target - startVal) * eased;
            el.textContent = decimals > 0 ? value.toFixed(decimals) : Math.round(value).toString();
            if (t < 1) requestAnimationFrame(tick);
          }
          requestAnimationFrame(tick);
          observer.unobserve(el);
        });
      }, { threshold: 0.4 });
      elements.forEach((el) => observer.observe(el));
    }
    animateCounters();
    document.addEventListener('astro:after-swap', animateCounters);
  </script>

  <Testimonials />

  <!-- VALUE PROPS -->
  <section class="max-w-6xl mx-auto px-6 py-24 border-t border-[color:var(--color-border)] reveal">
    <div class="max-w-3xl mb-14">
      <div class="text-xs uppercase tracking-widest text-[color:var(--color-teal-dark)] font-medium mb-3">Built for accuracy</div>
      <h2 class="text-4xl md:text-5xl font-bold tracking-tight leading-[1.05]">
        10 sensors. No guessing.<br/>
        <span class="bg-gradient-to-r from-[color:var(--color-teal)] to-[color:var(--color-coral)] bg-clip-text text-transparent">Every factor</span> that drives your stress.
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-5">
      <!-- HRV card -->
      <a href="/features/hrv-stress-monitoring" class="group relative block p-7 rounded-3xl bg-gradient-to-br from-[color:var(--color-teal)]/8 via-[color:var(--color-mint-soft)] to-white border border-[color:var(--color-teal)]/15 hover:border-[color:var(--color-teal)]/50 hover:shadow-[0_20px_60px_-15px] hover:shadow-[color:var(--color-teal)]/30 hover:-translate-y-1 transition-all duration-300 overflow-hidden">
        <div class="absolute -top-12 -right-12 w-40 h-40 rounded-full bg-[color:var(--color-teal)]/15 blur-2xl group-hover:bg-[color:var(--color-teal)]/30 transition-colors duration-500"></div>

        <div class="relative">
          <div class="flex items-center justify-between mb-6">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-[color:var(--color-teal)] to-[color:var(--color-teal-dark)] flex items-center justify-center text-white shadow-lg shadow-[color:var(--color-teal)]/30 group-hover:scale-110 group-hover:rotate-3 transition-transform duration-300">
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-7 h-7">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
              </svg>
            </div>
            <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-[color:var(--color-teal)]/15 text-[color:var(--color-teal-dark)]">Real-time</span>
          </div>

          <h3 class="text-xl font-bold mb-2 group-hover:text-[color:var(--color-teal-dark)] transition-colors">HRV-based cortisol score</h3>
          <p class="text-sm text-[color:var(--color-ink-muted)] leading-relaxed mb-5">
            Continuous estimation from heart rate variability — the gold standard for autonomic stress.
          </p>

          <!-- Mini HRV sparkline -->
          <div class="h-12 mb-4">
            <svg viewBox="0 0 200 40" class="w-full h-full" preserveAspectRatio="none">
              <defs>
                <linearGradient id="hrv-area" x1="0" x2="0" y1="0" y2="1">
                  <stop offset="0%" stop-color="var(--color-teal)" stop-opacity="0.4"/>
                  <stop offset="100%" stop-color="var(--color-teal)" stop-opacity="0"/>
                </linearGradient>
              </defs>
              <path d="M0,28 L20,22 L40,18 L60,25 L80,14 L100,20 L120,12 L140,18 L160,10 L180,15 L200,8 L200,40 L0,40 Z" fill="url(#hrv-area)"/>
              <path d="M0,28 L20,22 L40,18 L60,25 L80,14 L100,20 L120,12 L140,18 L160,10 L180,15 L200,8" fill="none" stroke="var(--color-teal)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>

          <div class="flex items-center text-sm font-medium text-[color:var(--color-teal-dark)]">
            See how it works
            <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
        </div>
      </a>

      <!-- Sleep card -->
      <a href="/features/sleep-cortisol-tracking" class="group relative block p-7 rounded-3xl bg-gradient-to-br from-[color:var(--color-coral)]/10 via-[color:var(--color-coral)]/5 to-white border border-[color:var(--color-coral)]/15 hover:border-[color:var(--color-coral)]/50 hover:shadow-[0_20px_60px_-15px] hover:shadow-[color:var(--color-coral)]/30 hover:-translate-y-1 transition-all duration-300 overflow-hidden">
        <div class="absolute -top-12 -right-12 w-40 h-40 rounded-full bg-[color:var(--color-coral)]/15 blur-2xl group-hover:bg-[color:var(--color-coral)]/30 transition-colors duration-500"></div>

        <div class="relative">
          <div class="flex items-center justify-between mb-6">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-[color:var(--color-coral)] to-[color:var(--color-coral-light)] flex items-center justify-center text-white shadow-lg shadow-[color:var(--color-coral)]/30 group-hover:scale-110 group-hover:-rotate-3 transition-transform duration-300">
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-7 h-7">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
              </svg>
            </div>
            <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-[color:var(--color-coral)]/15 text-[color:var(--color-coral)]">Overnight</span>
          </div>

          <h3 class="text-xl font-bold mb-2 group-hover:text-[color:var(--color-coral)] transition-colors">Sleep × cortisol</h3>
          <p class="text-sm text-[color:var(--color-ink-muted)] leading-relaxed mb-5">
            See how sleep stages drive next-morning cortisol — and what to fix tonight.
          </p>

          <!-- Mini sleep stages chart -->
          <div class="h-12 mb-4 flex items-end gap-1">
            <div class="flex-1 bg-[color:var(--color-coral)]/30 rounded-sm" style="height:35%"></div>
            <div class="flex-1 bg-[color:var(--color-coral)]/50 rounded-sm" style="height:70%"></div>
            <div class="flex-1 bg-[color:var(--color-coral)]/80 rounded-sm" style="height:90%"></div>
            <div class="flex-1 bg-[color:var(--color-coral)]/60 rounded-sm" style="height:55%"></div>
            <div class="flex-1 bg-[color:var(--color-coral)]/90 rounded-sm" style="height:100%"></div>
            <div class="flex-1 bg-[color:var(--color-coral)]/40 rounded-sm" style="height:45%"></div>
            <div class="flex-1 bg-[color:var(--color-coral)]/70 rounded-sm" style="height:75%"></div>
            <div class="flex-1 bg-[color:var(--color-coral)]/50 rounded-sm" style="height:60%"></div>
            <div class="flex-1 bg-[color:var(--color-coral)]/30 rounded-sm" style="height:40%"></div>
            <div class="flex-1 bg-[color:var(--color-coral)]/20 rounded-sm" style="height:30%"></div>
          </div>

          <div class="flex items-center text-sm font-medium text-[color:var(--color-coral)]">
            See your sleep impact
            <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
        </div>
      </a>

      <!-- Zen card -->
      <a href="/features/breathing-zen-mode" class="group relative block p-7 rounded-3xl bg-gradient-to-br from-[color:var(--color-mint)]/40 via-[color:var(--color-mint-soft)] to-white border border-[color:var(--color-mint)]/40 hover:border-[color:var(--color-teal)]/50 hover:shadow-[0_20px_60px_-15px] hover:shadow-[color:var(--color-mint)]/50 hover:-translate-y-1 transition-all duration-300 overflow-hidden">
        <div class="absolute -top-12 -right-12 w-40 h-40 rounded-full bg-[color:var(--color-mint)]/40 blur-2xl group-hover:bg-[color:var(--color-mint)]/60 transition-colors duration-500"></div>

        <div class="relative">
          <div class="flex items-center justify-between mb-6">
            <div class="relative w-14 h-14 rounded-2xl bg-gradient-to-br from-[color:var(--color-mint)] to-[color:var(--color-teal)] flex items-center justify-center text-white shadow-lg shadow-[color:var(--color-mint)]/40 group-hover:scale-110 transition-transform duration-300">
              <div class="absolute inset-2 rounded-xl border-2 border-white/40 group-hover:scale-90 transition-transform duration-[2000ms] ease-in-out"></div>
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6 relative">
                <circle cx="12" cy="12" r="6"/>
              </svg>
            </div>
            <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-[color:var(--color-teal)]/15 text-[color:var(--color-teal-dark)]">Intervene</span>
          </div>

          <h3 class="text-xl font-bold mb-2 group-hover:text-[color:var(--color-teal-dark)] transition-colors">Zen mode &amp; breathwork</h3>
          <p class="text-sm text-[color:var(--color-ink-muted)] leading-relaxed mb-5">
            Guided protocols that measurably drop your cortisol score in minutes.
          </p>

          <!-- Breathing rings -->
          <div class="h-12 mb-4 flex items-center justify-center relative">
            <div class="absolute w-10 h-10 rounded-full border-2 border-[color:var(--color-teal)]/30 animate-ping"></div>
            <div class="absolute w-8 h-8 rounded-full border-2 border-[color:var(--color-teal)]/50"></div>
            <div class="w-4 h-4 rounded-full bg-gradient-to-br from-[color:var(--color-teal)] to-[color:var(--color-teal-dark)] shadow-lg shadow-[color:var(--color-teal)]/40"></div>
          </div>

          <div class="flex items-center text-sm font-medium text-[color:var(--color-teal-dark)]">
            Try a session
            <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
        </div>
      </a>
    </div>
  </section>

  <!-- LEARN -->
  <section class="max-w-6xl mx-auto px-6 py-20 border-t border-[color:var(--color-border)] reveal">
    <div class="grid md:grid-cols-2 gap-12">
