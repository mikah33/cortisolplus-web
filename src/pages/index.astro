---
import BaseLayout from '../layouts/BaseLayout.astro';
import GetAppButton from '../components/GetAppButton.astro';
import RatingBadge from '../components/RatingBadge.astro';
import NowCard from '../components/NowCard.astro';
import reviewsData from '../data/reviews.json';
import { SITE, SOCIAL_PROFILES, APP_RATING, PUBLISHER } from '../consts';

const homeSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    logo: `${SITE.url}/icon-512.png`,
    sameAs: SOCIAL_PROFILES,
    parentOrganization: {
      '@type': 'Organization',
      name: PUBLISHER.name,
      url: PUBLISHER.url,
      email: PUBLISHER.email,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: SITE.fullName,
    alternateName: SITE.name,
    operatingSystem: 'iOS 17+, watchOS',
    applicationCategory: 'HealthApplication',
    description: SITE.description,
    downloadUrl: SITE.appStoreUrl,
    installUrl: SITE.appStoreUrl,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
  },
];

const screens = [
  { src: '/screenshots/live-stress-levels.webp', badge: 'Now', title: 'Live stress score', href: '/features/hrv-stress-monitoring/', caption: 'HRV, resting heart rate and sleep turned into one score through the day.', alt: 'Cortisol+ Now screen with an arc dial showing an example score of 26 labeled Low, HRV 58 ms and resting heart rate 58 bpm' },
  { src: '/screenshots/wearable-insights.webp', badge: 'Insights', title: 'Insights from your wearable', href: '/features/hrv-stress-monitoring/', caption: 'A daily suggestion, then cortisol, sleep and recovery cards from your health data.', alt: 'Cortisol+ Insights tab with a suggestion card and Cortisol, Sleep and Recovery cards' },
  { src: '/screenshots/sleep-quality.webp', badge: 'Sleep', title: 'Sleep quality', href: '/features/sleep-cortisol-tracking/', caption: 'A nightly score with time asleep, efficiency and a stage-by-stage timeline.', alt: 'Cortisol+ Sleep tab showing an example night scored 93 Excellent with sleep stages' },
  { src: '/screenshots/activities.webp', badge: 'Fitness', title: 'Readiness & activities', href: '/download/', caption: 'Weekly readiness, cardio load, steps and VO₂ max, plus your workouts.', alt: 'Cortisol+ Fitness view with a weekly Readiness chart showing 71 Good' },
  { src: '/screenshots/bio-age.webp', badge: 'Bio Age', title: 'Bio Age & Pace of Aging', href: '/download/', caption: 'An estimate of your pace of aging from recovery data. Not a medical test.', alt: 'Cortisol+ Bio Age screen showing an example Pace of Aging of 0.88x' },
  { src: '/screenshots/zen-ai-assistant.webp', badge: 'Zen', title: 'Ask Zen & breathwork', href: '/features/breathing-zen-mode/', caption: 'Ask what is driving your score, then take a short guided breathing session.', alt: 'Cortisol+ Zen chat explaining an example score of 26 using sleep, HRV and resting heart rate' },
];

const reviews = reviewsData.reviews;
---

<BaseLayout
  title="Cortisol+ | Apple Watch Stress &amp; HRV Tracker"
  description="Explore Apple Watch HRV, sleep and recovery with Cortisol+. Understand your stress patterns with a wellness score, guided breathing and clear limitations."
  image="/screenshots/live-stress-levels.png"
  schema={homeSchema}
>
  <!-- The homepage is designed as a phone screen: one column at app width on every device. -->
  <div class="home mx-auto w-full max-w-[30rem] -mt-14">

    <!-- HERO — the app's onboarding sky with Zen -->
    <section class="app-sky relative overflow-hidden px-5 pt-20 pb-8 text-center">
      <div class="flex justify-center mb-5"><RatingBadge size="sm" label="App Store" /></div>

      <img
        src="/app-ui/zen_greet.webp"
        alt="Zen, the Cortisol+ guide, waving hello"
        width="306"
        height="480"
        fetchpriority="high"
        class="zen-float mx-auto h-56 w-auto drop-shadow-[0_18px_24px_rgba(40,96,140,0.25)]"
      />

      <h1 class="mt-4 text-[2.5rem] leading-[1.05] font-extrabold tracking-tight text-balance">
        Understand your stress with Cortisol+.
      </h1>
      <p class="mt-4 text-[1.0625rem] leading-relaxed text-[color:var(--color-ink)]/75 text-pretty">
        <span data-only="ios">Bring your Apple Watch HRV, sleep and activity into one daily view.</span>
        <span data-only="android">Bring your Wear OS and Health Connect HRV, sleep and activity into one daily view.</span>
        <span data-only="other">Bring your Apple Watch or Wear OS HRV, sleep and activity into one daily view.</span>
        Explore recovery habits and try guided breathing.
      </p>

      <div class="mt-7">
        <GetAppButton />
      </div>
      <a href="/how-it-works/" class="mt-4 inline-flex items-center gap-1 text-sm font-bold text-[color:var(--color-teal-dark)]">
        How the score works <span aria-hidden="true">›</span>
      </a>

      <p class="mt-6 text-xs leading-relaxed text-[color:var(--color-ink)]/60">
        Free to download. The wellness score is an estimate; it does not measure cortisol in blood, saliva or urine.
      </p>
    </section>

    <!-- NOW — the real Now card, as it sits in the app -->
    <section class="px-4 -mt-1">
      <div class="app-card p-4">
        <div class="flex items-center justify-between px-1 mb-3 text-xs font-bold text-[color:var(--color-ink-muted)]">
          <span class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-[color:var(--color-level-low)]"></span>
            Now · example
          </span>
          <span class="tabular-nums">Tue · 2:34 PM</span>
        </div>
        <NowCard />
        <p class="text-[11px] text-[color:var(--color-ink-muted)] mt-3 px-1">Example values from the app's Now screen. The score is a wellness estimate, not a hormone measurement.</p>
      </div>
    </section>

    <!-- INSIDE THE APP — swipe through the real screens -->
    <section class="mt-12" aria-labelledby="inside-heading">
      <div class="px-5 mb-4">
        <h2 id="inside-heading" class="text-[1.75rem] font-extrabold tracking-tight leading-tight">Everything in one place</h2>
        <p class="mt-1 text-[color:var(--color-ink-muted)]">Swipe through the app. Screens show example values.</p>
      </div>
      <ul class="app-snap pb-2">
        {screens.map((s) => (
          <li class="w-[72%]">
            <a href={s.href} class="block">
              <div class="rounded-[1.75rem] overflow-hidden bg-[#cfe6f7] aspect-[645/1398] shadow-[0_18px_40px_-24px_rgba(40,96,140,0.55)]">
                <img src={s.src} alt={s.alt} width="645" height="1398" loading="lazy" decoding="async" class="w-full h-full object-cover" />
              </div>
              <div class="mt-3 px-1">
                <span class="text-xs font-extrabold text-[color:var(--color-teal-dark)]">{s.badge}</span>
                <div class="font-extrabold text-[1.0625rem]">{s.title}</div>
                <div class="text-sm text-[color:var(--color-ink-muted)] leading-snug">{s.caption}</div>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- HOW IT WORKS — three steps, platform aware -->
    <section class="mt-12 px-4" aria-labelledby="steps-heading">
      <h2 id="steps-heading" class="px-1 text-[1.75rem] font-extrabold tracking-tight leading-tight mb-4">How it works</h2>
      <ol class="app-card app-list overflow-hidden">
        <li class="flex gap-4 p-4">
          <img src="/app-ui/zen_new_tour_connect.webp" alt="" width="200" height="270" loading="lazy" class="w-14 h-auto shrink-0 self-center" />
          <div>
            <div class="font-extrabold">1. Connect your watch</div>
            <p class="text-sm text-[color:var(--color-ink-muted)] leading-snug mt-0.5">
              <span data-only="ios">Cortisol+ reads HRV, resting heart rate and sleep from Apple Health and your Apple Watch.</span>
              <span data-only="android">Cortisol+ reads HRV, resting heart rate and sleep from Health Connect and your Wear OS watch.</span>
              <span data-only="other">Cortisol+ reads HRV, resting heart rate and sleep from Apple Health or Health Connect.</span>
            </p>
          </div>
        </li>
        <li class="flex gap-4 p-4">
          <img src="/app-ui/zen_new_tour_now.webp" alt="" width="200" height="270" loading="lazy" class="w-14 h-auto shrink-0 self-center" />
          <div>
            <div class="font-extrabold">2. See your daily score</div>
            <p class="text-sm text-[color:var(--color-ink-muted)] leading-snug mt-0.5">One wellness score through the day, with the inputs behind it a tap away.</p>
          </div>
        </li>
        <li class="flex gap-4 p-4">
          <img src="/app-ui/zen_new_breathe.webp" alt="" width="200" height="270" loading="lazy" class="w-14 h-auto shrink-0 self-center" />
          <div>
            <div class="font-extrabold">3. Bring it down with Zen</div>
            <p class="text-sm text-[color:var(--color-ink-muted)] leading-snug mt-0.5">Ask Zen what is driving your score and take a short guided breathing session.</p>
          </div>
        </li>
      </ol>
    </section>

    <!-- REVIEWS -->
    <section class="mt-12" aria-labelledby="reviews-heading">
      <div class="px-5 mb-4">
        <h2 id="reviews-heading" class="text-[1.75rem] font-extrabold tracking-tight leading-tight">Loved by early users</h2>
        <p class="mt-1 text-[color:var(--color-ink-muted)]">
          <strong class="text-[color:var(--color-ink)] tabular-nums">{APP_RATING.value}</strong> out of 5 from {APP_RATING.count} ratings on the US App Store, checked September 27, 2026.
        </p>
      </div>
      <ul class="app-snap pb-2">
        {reviews.map((r) => (
          <li class="w-[82%]">
            <figure class="app-card h-full p-5 flex flex-col">
              <div class="flex gap-0.5 mb-2" aria-label={`${r.rating} out of 5 stars`}>
                {Array.from({ length: r.rating }).map(() => (
                  <svg viewBox="0 0 24 24" class="w-4 h-4 text-[#fbbf24]" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg>
                ))}
              </div>
              <h3 class="font-extrabold mb-1">{r.title}</h3>
              <blockquote class="text-sm text-[color:var(--color-ink-muted)] leading-relaxed line-clamp-6">"{r.body}"</blockquote>
              <figcaption class="mt-auto pt-3 text-xs text-[color:var(--color-ink-muted)]">— {r.author} · App Store review</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </section>

    <!-- WHAT IT IS / PRICING DISCLOSURE (kept for search and honesty) -->
    <section class="mt-12 px-4">
      <div class="app-card p-5">
        <h2 class="text-xl font-extrabold tracking-tight mb-2">Looking for a cortisol tracker app?</h2>
        <p class="text-[color:var(--color-ink-muted)] leading-relaxed mb-5">Cortisol+ helps you understand wearable stress signals. Apple Watch does not measure the cortisol hormone, and the app does not replace a laboratory test. Start with our <a class="underline font-semibold text-[color:var(--color-teal-dark)]" href="/stress/apple-watch/">Apple Watch cortisol guide</a> and <a class="underline font-semibold text-[color:var(--color-teal-dark)]" href="/how-it-works/">score methodology</a>.</p>
        <h2 class="text-xl font-extrabold tracking-tight mb-2">Free download, subscription analysis</h2>
        <p class="text-[color:var(--color-ink-muted)] leading-relaxed">Download Cortisol+ for iOS 17 or later, or from Google Play. Core analysis requires an active subscription or an eligible trial. Prices, trial eligibility and renewal terms are shown in the app before purchase. Our website's <a class="underline font-semibold text-[color:var(--color-teal-dark)]" href="/tools/">reflection tools</a> and <a class="underline font-semibold text-[color:var(--color-teal-dark)]" href="/resources/stress-sleep-journal/">printable journal</a> are free.</p>
      </div>
    </section>

    <!-- LIBRARY -->
    <section class="mt-12 px-4" aria-labelledby="library-heading">
      <h2 id="library-heading" class="px-1 text-[1.75rem] font-extrabold tracking-tight leading-tight">The cortisol library</h2>
      <p class="px-1 mt-1 mb-4 text-[color:var(--color-ink-muted)]">Symptom by symptom, food by food, written by the team building the tracker.</p>
      <ul class="app-card app-list overflow-hidden">
        <li><a href="/cortisol" class="app-row"><span><span class="block font-extrabold">The full cortisol guide</span><span class="block text-sm text-[color:var(--color-ink-muted)]">Start here</span></span><span class="app-chevron">›</span></a></li>
        <li><a href="/cortisol/symptoms/cortisol-face" class="app-row"><span><span class="block font-extrabold">Cortisol face: what it actually is</span><span class="block text-sm text-[color:var(--color-ink-muted)]">Symptom guide</span></span><span class="app-chevron">›</span></a></li>
        <li><a href="/cortisol/lower/foods" class="app-row"><span><span class="block font-extrabold">Foods that lower cortisol</span><span class="block text-sm text-[color:var(--color-ink-muted)]">Evidence-based list</span></span><span class="app-chevron">›</span></a></li>
        <li><a href="/tools/cortisol-calculator" class="app-row"><span><span class="block font-extrabold">Stress &amp; habits check-in</span><span class="block text-sm text-[color:var(--color-ink-muted)]">8 questions · 60 seconds</span></span><span class="app-chevron">›</span></a></li>
      </ul>
    </section>

    <!-- CLOSING -->
    <section class="mt-12 px-5 text-center">
      <img src="/app-ui/zen_celebrate.webp" alt="" width="495" height="480" loading="lazy" class="mx-auto h-40 w-auto" />
      <h2 class="mt-3 text-[1.75rem] font-extrabold tracking-tight leading-tight text-balance">Meet Zen and see your first score today</h2>
      <div class="mt-6"><GetAppButton /></div>
    </section>
  </div>

  <style>
    .zen-float { animation: float-slow 6s ease-in-out infinite; }
    @media (prefers-reduced-motion: reduce) { .zen-float { animation: none; } }
  </style>

</BaseLayout>
