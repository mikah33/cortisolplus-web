---
import BaseLayout from '../layouts/BaseLayout.astro';
import GetAppButton from '../components/GetAppButton.astro';
import HeroCTA from '../components/HeroCTA.astro';
import RatingBadge from '../components/RatingBadge.astro';
import NowCard from '../components/NowCard.astro';
import HeroCompanions from '../components/HeroCompanions.astro';
import SleepCard from '../components/SleepCard.astro';
import BioAgeCard from '../components/BioAgeCard.astro';
import QuizTeaser from '../components/QuizTeaser';
import reviewsData from '../data/reviews.json';
import { PLANS, PERKS } from '../components/start/content';
import { SITE, SOCIAL_PROFILES, APP_RATING, PUBLISHER } from '../consts';

const homeSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    logo: `${SITE.url}/icon-512.png`,
    sameAs: SOCIAL_PROFILES,
    parentOrganization: {
      '@type': 'Organization',
      name: PUBLISHER.name,
      url: PUBLISHER.url,
      email: PUBLISHER.email,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: SITE.fullName,
    alternateName: SITE.name,
    operatingSystem: 'iOS 17+, watchOS',
    applicationCategory: 'HealthApplication',
    description: SITE.description,
    downloadUrl: SITE.appStoreUrl,
    installUrl: SITE.appStoreUrl,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
  },
];

const reviews = reviewsData.reviews;

const faqs = [
  { q: 'Does Cortisol+ measure cortisol?', a: 'No. No watch can. Cortisol+ reads HRV, resting heart rate and sleep from your watch and turns them into a wellness score. It is not a lab test or a diagnosis. <a href="/how-it-works/">See how the score works</a>.' },
  { q: 'Which watches does it work with?', a: 'Apple Watch with an iPhone on iOS 17 or later, and Wear OS watches through Health Connect on Android. Fitbit support through Health Connect is on the way. <a href="/stress/apple-watch/">What Apple Watch can track</a>.' },
  { q: 'What are Pebble, Ripple and Bloom?', a: 'Your watch companion. Pick one and it sits on your watch face: calm when your stress score is low, worried when it runs high, so you can read your day at a glance.' },
  { q: 'How much does it cost?', a: 'The app is free to download. Analysis needs Pro or an eligible trial. On the web, Pro is $14.99 a week or $83.99 a year; in the app, prices and trial terms are shown before you buy. Cancel anytime.' },
  { q: 'Is anything free?', a: 'Yes. The <a href="/tools/">check-ins</a> on this site and the <a href="/resources/stress-sleep-journal/">printable stress and sleep journal</a> are free, no sign-up needed.' },
];

const weekly = PLANS.weekly.price;
const yearly = PLANS.yearly.price;
const savePct = Math.round((1 - yearly / (weekly * 52)) * 100);
const money = (n: number) => `$${n.toFixed(2)}`;
const checkedOn = new Date(`${APP_RATING.lastChecked}T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

// Matches /how-it-works/: the score starts from population defaults, blends
// toward your own history after 10 readings and is fully personal at 28.
const steps = [
  { title: 'Connect', body: 'Reads the HRV, resting heart rate and sleep already on your watch.', image: '/app-ui/zen_new_tour_connect.webp' },
  { title: 'Baseline', body: 'Your score starts today and learns your normal over about 28 readings.', image: '/app-ui/zen_new_tour_now.webp' },
  { title: 'Act', body: 'Zen shows what moved it and walks you through a breathing reset.', image: '/app-ui/zen_new_tour_zen.webp' },
];
---

<BaseLayout
  title="Cortisol+ | Apple Watch Stress &amp; HRV Tracker"
  description="Explore Apple Watch HRV, sleep and recovery with Cortisol+. Understand your stress patterns with a wellness score, guided breathing and clear limitations."
  image="/screenshots/live-stress-levels.png"
  schema={homeSchema}
>
  <!-- The homepage is designed as a phone screen: one column at app width on every device. -->
  <div class="home mx-auto w-full max-w-[30rem] -mt-14">

    <!-- HERO — Zen with the watch companions (device lineup on the back burner: HeroWearables.astro) -->
    <section class="app-sky relative overflow-hidden px-5 pt-20 pb-8 text-center">
      <div class="flex justify-center mb-5"><RatingBadge size="sm" label="App Store" /></div>

      <HeroCompanions />

      <h1 class="mt-4 text-[2.5rem] leading-[1.05] font-extrabold tracking-tight text-balance">
        Meet your stress companion.
      </h1>
      <p class="mt-4 text-[1.0625rem] leading-relaxed text-[color:var(--color-ink)]/75 text-pretty">
        A companion on
        <span data-only="ios">your Apple Watch</span><span data-only="android">your Wear OS watch</span><span data-only="other">your watch</span>
        that shows your stress at a glance. Zen helps you calm it.
      </p>

      <div class="mt-7">
        <HeroCTA />
      </div>
      <a href="/how-it-works/" class="mt-4 inline-flex items-center gap-1 text-sm font-bold text-[color:var(--color-teal-dark)]">
        How the score works <span aria-hidden="true">›</span>
      </a>

    </section>

    <!-- REVIEWS -->
    <section class="mt-2" aria-labelledby="reviews-heading">
      <div class="px-5 mb-4">
        <h2 id="reviews-heading" class="text-[1.75rem] font-extrabold tracking-tight leading-tight">Loved by early users</h2>
        <p class="mt-1 text-[color:var(--color-ink-muted)]">
          <strong class="text-[color:var(--color-ink)] tabular-nums">{APP_RATING.value}</strong> out of 5 from {APP_RATING.count} ratings on the US App Store, checked {checkedOn}.
        </p>
      </div>
      <ul class="app-snap pb-2">
        {reviews.map((r) => (
          <li class="w-[82%]">
            <figure class="app-card h-full p-5 flex flex-col">
              <div class="flex gap-0.5 mb-2" aria-label={`${r.rating} out of 5 stars`}>
                {Array.from({ length: r.rating }).map(() => (
                  <svg viewBox="0 0 24 24" class="w-4 h-4 text-[#fbbf24]" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg>
                ))}
              </div>
              <h3 class="font-extrabold mb-1">{r.title}</h3>
              <blockquote class="text-sm text-[color:var(--color-ink-muted)] leading-relaxed line-clamp-6">"{r.body}"</blockquote>
              <figcaption class="mt-auto pt-3 text-xs text-[color:var(--color-ink-muted)]">— {r.author} · App Store review</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </section>

    <!-- PROBLEM — why one number isn't the whole story -->
    <section class="mt-12 px-4" aria-labelledby="problem-heading">
      <div class="app-card p-5">
        <h2 id="problem-heading" class="text-[1.75rem] font-extrabold tracking-tight leading-tight text-balance">One number doesn't explain how you feel.</h2>
        <ul class="mt-4 space-y-2.5 font-bold">
          <li class="flex gap-2.5"><span class="text-[color:var(--color-level-elevated)]" aria-hidden="true">●</span>Slept 8 hours, still wired?</li>
          <li class="flex gap-2.5"><span class="text-[color:var(--color-level-elevated)]" aria-hidden="true">●</span>HRV dipped, but no idea why?</li>
          <li class="flex gap-2.5"><span class="text-[color:var(--color-level-low)]" aria-hidden="true">●</span>Cortisol+ reads HRV, heart rate and sleep together, so you see the pattern.</li>
        </ul>
      </div>
    </section>

    <!-- HOW IT WORKS — three steps -->
    <section class="mt-12 px-4" aria-labelledby="steps-heading">
      <h2 id="steps-heading" class="px-1 mb-4 text-[1.75rem] font-extrabold tracking-tight leading-tight">How it works</h2>
      <ol class="grid gap-3">
        {steps.map((step, i) => (
          <li class="app-card flex items-center gap-4 p-4">
            <img src={step.image} alt="" width="200" height="270" loading="lazy" class="w-12 h-auto shrink-0" />
            <div>
              <div class="font-extrabold text-[1.0625rem]"><span class="text-[color:var(--color-teal-dark)]">{i + 1}.</span> {step.title}</div>
              <p class="text-sm text-[color:var(--color-ink-muted)] leading-snug mt-0.5">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- CHECK-IN — the site's top search entry, answerable right here -->
    <section class="mt-12 px-4" aria-labelledby="checkin-heading">
      <div class="px-1 mb-4">
        <h2 id="checkin-heading" class="text-[1.75rem] font-extrabold tracking-tight leading-tight">Try the 60-second check-in</h2>
        <p class="mt-1 text-[color:var(--color-ink-muted)]">Free, no sign-up. Start here and finish on the next page.</p>
      </div>
      <QuizTeaser client:visible />
    </section>

    <!-- NOW / SLEEP / BIO AGE — swipe between the app's real cards -->
    <section class="px-4 mt-12" aria-labelledby="glance-heading">
      <div class="px-1 mb-4">
        <h2 id="glance-heading" class="text-[1.75rem] font-extrabold tracking-tight leading-tight">What your watch tells you</h2>
        <p class="mt-1 text-[color:var(--color-ink-muted)]">The stress score your companion reacts to, last night's sleep and your Bio Age, all from the data your watch already collects. Swipe to see each one.</p>
      </div>
      <div class="app-card p-4" data-card-carousel>
        <div class="card-seg mb-3" role="tablist">
          <span class="card-seg__thumb" data-card-thumb aria-hidden="true"></span>
          {['Now', 'Sleep', 'Bio Age'].map((name, i) => (
            <button type="button" role="tab" data-card-tab={i} aria-selected={i === 0 ? 'true' : 'false'} class="card-seg__btn">{name}</button>
          ))}
        </div>
        <div class="card-track" data-card-track>
          <div class="card-slide" role="tabpanel" aria-label="Now">
            <div class="flex items-center justify-between px-1 mb-3 text-xs font-bold text-[color:var(--color-ink-muted)]">
              <span class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-[color:var(--color-level-low)]"></span>
                Now · example
              </span>
              <span class="tabular-nums">Tue · 2:34 PM</span>
            </div>
            <NowCard />
          </div>
          <div class="card-slide" role="tabpanel" aria-label="Sleep">
            <div class="flex items-center justify-between px-1 mb-3 text-xs font-bold text-[color:var(--color-ink-muted)]">
              <span class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-[#6d4fd8]"></span>
                Last night · example
              </span>
              <span class="tabular-nums">Tue, Sep 1</span>
            </div>
            <SleepCard />
          </div>
          <div class="card-slide" role="tabpanel" aria-label="Bio Age">
            <div class="flex items-center justify-between px-1 mb-3 text-xs font-bold text-[color:var(--color-ink-muted)]">
              <span class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-[color:var(--color-teal)]"></span>
                Bio Age · example
              </span>
              <span>Last 30 days</span>
            </div>
            <BioAgeCard />
          </div>
        </div>
        <div class="mt-3 flex justify-center gap-1.5" aria-hidden="true">
          {[0, 1, 2].map((i) => <span data-card-dot={i} class={`card-dot ${i === 0 ? 'is-on' : ''}`}></span>)}
        </div>
        <p class="text-[11px] text-[color:var(--color-ink-muted)] mt-3 px-1">Example values from the app's Now, Sleep and Bio Age screens. Scores are wellness estimates, not hormone measurements or medical tests.</p>
      </div>
    </section>

    <script>
      // astro:page-load fires on the first load and after every client-side
      // navigation, so the carousel is set up however the visitor arrives.
      const initCarousels = () => document.querySelectorAll<HTMLElement>('[data-card-carousel]:not([data-ready])').forEach((root) => {
        root.dataset.ready = '';
        const track = root.querySelector<HTMLElement>('[data-card-track]')!;
        const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-card-tab]')];
        const dots = [...root.querySelectorAll<HTMLElement>('[data-card-dot]')];
        const thumb = root.querySelector<HTMLElement>('[data-card-thumb]')!;
        const slides = [...track.querySelectorAll<HTMLElement>('.card-slide')];
        // The track takes the active slide's height, so a short slide leaves no gap.
        const fit = (i: number) => { track.style.height = `${slides[i].offsetHeight}px`; };
        let current = 0;
        const show = (i: number) => {
          if (i !== current) { current = i; fit(i); }
          tabs.forEach((t, j) => t.setAttribute('aria-selected', String(i === j)));
          dots.forEach((d, j) => d.classList.toggle('is-on', i === j));
        };
        tabs.forEach((t, i) => t.addEventListener('click', () => {
          track.scrollTo({ left: i * track.clientWidth, behavior: 'smooth' });
        }));
        fit(0);
        const ro = new ResizeObserver(() => fit(current));
        slides.forEach((slide) => ro.observe(slide));
        let frame = 0;
        track.addEventListener('scroll', () => {
          cancelAnimationFrame(frame);
          frame = requestAnimationFrame(() => {
            const pos = track.scrollLeft / track.clientWidth;
            thumb.style.transform = `translateX(${pos * 100}%)`;
            show(Math.round(pos));
          });
        }, { passive: true });
      });
      document.addEventListener('astro:page-load', initCarousels);
    </script>

    <!-- FAQ — answers the common doubts before pricing. The live Zen chat
         (components/zen/ZenSalesChat.tsx) is on the back burner until its
         function is deployed; it can go back above this section. -->
    <section class="mt-12 px-4" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="px-1 mb-4 text-[1.75rem] font-extrabold tracking-tight leading-tight">Questions, answered</h2>
      <div class="app-card app-list overflow-hidden">
        {faqs.map((f) => (
          <details class="group">
            <summary class="app-row cursor-pointer list-none font-bold">
              <span>{f.q}</span>
              <span class="app-chevron transition-transform group-open:rotate-90">›</span>
            </summary>
            <p class="faq-answer px-4 pb-4 -mt-1 text-[0.9375rem] leading-relaxed text-[color:var(--color-ink-muted)]" set:html={f.a} />
          </details>
        ))}
      </div>
    </section>

    <!-- PRO — the same plans and wording as the onboarding paywall -->
    <section id="plans" class="mt-12 px-4" aria-labelledby="plans-heading">
      <div class="app-card overflow-hidden">
        <img src="/app-ui/start/paywall_header.webp" alt="" width="480" height="300" loading="lazy" class="w-full [mask-image:linear-gradient(to_bottom,black_60%,transparent)]" />
        <div class="-mt-6 px-5 pb-5">
          <div class="flex justify-center"><RatingBadge size="sm" label="App Store" /></div>
          <h2 id="plans-heading" class="mt-3 text-center text-[1.75rem] font-extrabold tracking-tight leading-tight text-balance">Everything in Cortisol+ Pro</h2>
          <ul class="mt-4 space-y-2">
            {PERKS.map((perk) => (
              <li class="flex items-center gap-3 font-bold">
                <img src={perk.image} alt="" width="36" height="36" loading="lazy" class="h-9 w-9 object-contain" />
                {perk.label}
              </li>
            ))}
            <li class="flex items-center gap-3 font-bold">
              <img src="/app-ui/zen_new_tour_bioage.webp" alt="" width="36" height="36" loading="lazy" class="h-9 w-9 object-contain" />
              Bio Age &amp; pace of aging
            </li>
          </ul>
          <div class="mt-6 grid grid-cols-2 gap-3">
            <div class="relative rounded-[1.25rem] border-[2.5px] border-transparent bg-[color:var(--color-surface-2)] px-3 pb-3 pt-6">
              <span class="absolute -top-3.5 left-3 rounded-full bg-white px-3 py-1 text-[13px] font-extrabold shadow-sm">Popular</span>
              <div class="text-sm font-extrabold">Weekly</div>
              <div class="mt-1 text-2xl font-extrabold tabular-nums">{money(weekly)}<span class="text-sm">/wk</span></div>
              <div class="text-xs font-semibold text-[color:var(--color-ink-muted)]">billed weekly</div>
            </div>
            <div class="relative rounded-[1.25rem] border-[2.5px] border-[rgba(18,24,38,0.9)] bg-white px-3 pb-3 pt-6">
              <span class="absolute -top-3.5 left-3 rounded-full bg-[rgba(18,24,38,0.9)] px-3 py-1 text-[13px] font-extrabold text-white shadow-sm">Save {savePct}%</span>
              <div class="text-sm font-extrabold">Yearly</div>
              <div class="mt-1 text-2xl font-extrabold tabular-nums">{money(yearly / 12)}<span class="text-sm">/mo</span></div>
              <div class="text-xs font-semibold text-[color:var(--color-ink-muted)]">{money(yearly)} billed yearly</div>
            </div>
          </div>
          <p class="mt-5 text-center text-sm font-bold text-[color:var(--color-ink)]/70">Cancel anytime. No commitment.</p>
          <a href="/start/" class="app-btn mt-3 w-full">Build my plan ›</a>
          <div class="mt-5 flex items-center gap-3 text-xs font-bold text-[color:var(--color-ink-muted)]" aria-hidden="true">
            <span class="h-px flex-1 bg-[color:var(--color-surface-2)]"></span>or download free<span class="h-px flex-1 bg-[color:var(--color-surface-2)]"></span>
          </div>
          <div class="mt-3"><GetAppButton variant="light" /></div>
          <p class="mt-3 text-center text-xs leading-relaxed text-[color:var(--color-ink-muted)]">
            Web prices. Plans renew every week or year until you cancel. The app is free to download; analysis needs Pro. Cortisol+ doesn't measure cortisol or diagnose any condition.
          </p>
        </div>
      </div>
    </section>

  </div>

  <style>
    .faq-answer :global(a) { color: var(--color-teal-dark); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
  </style>

</BaseLayout>
