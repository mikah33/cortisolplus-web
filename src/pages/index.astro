---
import BaseLayout from '../layouts/BaseLayout.astro';
import GooglePlayBadge from '../components/GooglePlayBadge.astro';
import AppStoreBadge from '../components/AppStoreBadge.astro';
import RatingBadge from '../components/RatingBadge.astro';
import NowCard from '../components/NowCard.astro';
import AppShowcase from '../components/AppShowcase.astro';
import Testimonials from '../components/Testimonials.astro';
import { SITE, SOCIAL_PROFILES, APP_RATING, PUBLISHER } from '../consts';

const homeSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    logo: `${SITE.url}/icon-512.png`,
    sameAs: SOCIAL_PROFILES,
    parentOrganization: {
      '@type': 'Organization',
      name: PUBLISHER.name,
      url: PUBLISHER.url,
      email: PUBLISHER.email,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: SITE.fullName,
    alternateName: SITE.name,
    operatingSystem: 'iOS 17+, watchOS',
    applicationCategory: 'HealthApplication',
    description: SITE.description,
    downloadUrl: SITE.appStoreUrl,
    installUrl: SITE.appStoreUrl,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
  },
];
---

<BaseLayout
  title="Cortisol+ | Apple Watch Stress &amp; HRV Tracker"
  description="Explore Apple Watch HRV, sleep and recovery with Cortisol+. Understand your stress patterns with a wellness score, guided breathing and clear limitations."
  image="/screenshots/live-stress-levels.png"
  schema={homeSchema}
>
  <!-- HERO — premium mesh-gradient background with ambient HRV-wave decoration -->
  <section class="hero relative overflow-hidden isolate">
    <!-- Layer 1: Warm cream base + soft top mint wash -->
    <div class="absolute inset-0 bg-gradient-to-b from-[color:var(--color-mint-soft)] via-[#fafaf6] to-white pointer-events-none -z-10"></div>

    <!-- Layer 2: Mesh gradient orbs (the depth) -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none -z-10">
      <div class="hero-orb hero-orb--teal absolute top-[-10%] left-[-15%] w-[55rem] h-[55rem] rounded-full bg-[color:var(--color-teal)]/25 blur-3xl"></div>
      <div class="hero-orb hero-orb--coral absolute top-[5%] right-[-15%] w-[50rem] h-[50rem] rounded-full bg-[color:var(--color-coral)]/20 blur-3xl"></div>
      <div class="hero-orb hero-orb--mint absolute bottom-[-30%] left-1/2 -translate-x-1/2 w-[80rem] h-[40rem] rounded-full bg-[color:var(--color-mint)]/45 blur-3xl"></div>
    </div>

    <!-- Layer 3: HRV wave (decorative, low opacity) -->
    <svg
      class="absolute left-0 right-0 top-[42%] w-full h-32 opacity-[0.07] pointer-events-none -z-10"
      viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true"
    >
      <defs>
        <linearGradient id="hero-hrv-grad" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0%" stop-color="var(--color-teal)" stop-opacity="0"/>
          <stop offset="20%" stop-color="var(--color-teal)" stop-opacity="1"/>
          <stop offset="80%" stop-color="var(--color-coral)" stop-opacity="1"/>
          <stop offset="100%" stop-color="var(--color-coral)" stop-opacity="0"/>
        </linearGradient>
      </defs>
      <path
        d="M0,60 Q60,40 120,60 T240,60 T360,60 T480,60 Q540,20 600,60 T720,60 Q780,100 840,60 T960,60 T1080,60 T1200,60 T1320,60 T1440,60"
        fill="none"
        stroke="url(#hero-hrv-grad)"
        stroke-width="2"
        stroke-linecap="round"
      />
    </svg>

    <!-- Layer 4: Ambient floating data points -->
    <div class="absolute inset-0 pointer-events-none -z-10">
      <span class="hero-dot hero-dot--1 absolute top-[18%] left-[12%]"></span>
      <span class="hero-dot hero-dot--2 absolute top-[25%] right-[18%]"></span>
      <span class="hero-dot hero-dot--3 absolute top-[55%] left-[8%]"></span>
      <span class="hero-dot hero-dot--4 absolute top-[68%] right-[10%]"></span>
      <span class="hero-dot hero-dot--5 absolute top-[40%] left-[48%]"></span>
    </div>

    <!-- Layer 5: Bottom fade for clean transition to next section -->
    <div class="absolute bottom-0 inset-x-0 h-40 bg-gradient-to-t from-white to-transparent pointer-events-none -z-10"></div>

    <div class="relative max-w-6xl mx-auto px-6 pt-20 pb-24 md:pt-32 md:pb-32">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div class="text-center">
          <div class="flex flex-wrap items-center justify-center gap-2 mb-6">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[color:var(--color-teal)]/10 border border-[color:var(--color-teal)]/20 text-xs font-medium text-[color:var(--color-teal-dark)]">
              <span class="relative flex w-1.5 h-1.5">
                <span class="absolute inline-flex w-full h-full rounded-full bg-[color:var(--color-teal)] opacity-75 animate-ping"></span>
                <span class="relative inline-flex w-1.5 h-1.5 rounded-full bg-[color:var(--color-teal)]"></span>
              </span>
              Stress &amp; HRV tracking for Apple Watch
            </div>
            <RatingBadge size="sm" />
          </div>

          <h1 class="text-5xl md:text-7xl font-bold tracking-tight leading-[1.02] mb-6">
            Understand your stress<br/>
            <span class="text-[color:var(--color-teal-dark)]">with Cortisol+.</span>
          </h1>

          <p class="text-xl text-[color:var(--color-ink-muted)] mb-8 max-w-lg mx-auto leading-relaxed">
            Bring your Apple Watch HRV, sleep and activity into one daily view. Explore recovery habits and try guided breathing. The wellness score is an estimate; it does not measure cortisol in blood, saliva or urine.
          </p>

          <div class="flex flex-wrap gap-4 items-center justify-center mb-8">
            <AppStoreBadge size="lg" />
            <GooglePlayBadge size="lg" />
            <a href="/how-it-works" class="group inline-flex items-center gap-1 text-sm text-[color:var(--color-ink-muted)] hover:text-[color:var(--color-teal-dark)] transition">
              How the score works
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>
          </div>

          <!-- Trust pills -->
          <ul class="flex flex-wrap justify-center gap-2 text-xs">
            <li class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[color:var(--color-surface)] border border-[color:var(--color-border)]">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-3.5 h-3.5 text-[color:var(--color-teal-dark)]"><path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Free to download
            </li>
            <li class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[color:var(--color-surface)] border border-[color:var(--color-border)]">
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5 text-[color:var(--color-teal-dark)]"><path d="M17.5 12.5c0-2.6 2.1-3.8 2.2-3.9-1.2-1.7-3-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9-1.7 0-3.4 1-4.3 2.6-1.8 3.2-.5 7.9 1.3 10.5.9 1.3 1.9 2.7 3.3 2.7 1.3-.1 1.8-.9 3.4-.9 1.6 0 2 .9 3.4.9 1.4 0 2.3-1.3 3.2-2.6 1-1.5 1.4-3 1.4-3.1-.1 0-2.7-1-2.7-4.1zM15 4.6c.7-.9 1.2-2.1 1.1-3.3-1 0-2.3.7-3 1.5-.7.8-1.2 2-1.1 3.2 1.1.1 2.3-.6 3-1.4z"/></svg>
              Apple Watch
            </li>
            <li class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[color:var(--color-surface)] border border-[color:var(--color-border)]">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-3.5 h-3.5 text-[color:var(--color-teal-dark)]"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Core scoring on-device
            </li>
          </ul>
        </div>

        <div class="relative" id="hero-card-wrap">
          <div class="absolute inset-0 bg-gradient-to-br from-[color:var(--color-teal)]/25 via-[color:var(--color-mint)]/15 to-[color:var(--color-coral)]/25 blur-3xl rounded-full"></div>
          <div
            id="hero-card"
            class="relative p-4 md:p-5 rounded-[2rem] bg-[#eef3f8]/90 backdrop-blur-xl border border-white/60 shadow-[0_30px_80px_-20px_rgba(0,191,166,0.25)] transition-transform duration-300 ease-out"
            style="transform-style: preserve-3d; will-change: transform;"
          >
            <div class="flex items-center justify-between px-1 mb-3 text-[10px] uppercase tracking-[0.18em] text-[color:var(--color-ink-muted)]">
              <div class="flex items-center gap-1.5 font-medium">
                <span class="relative flex w-1.5 h-1.5">
                  <span class="absolute inline-flex w-full h-full rounded-full bg-[color:var(--color-level-low)] opacity-75 animate-ping"></span>
                  <span class="relative inline-flex w-1.5 h-1.5 rounded-full bg-[color:var(--color-level-low)]"></span>
                </span>
                Now · example
              </div>
              <span class="tabular-nums">Tue · 2:34 PM</span>
            </div>

            <NowCard />

            <p class="text-[11px] text-[color:var(--color-ink-muted)] mt-3 px-1">Example values from the app's Now screen. The score is a wellness estimate, not a hormone measurement.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    function initHeroTilt() {
      const card = document.getElementById('hero-card');
      const wrap = document.getElementById('hero-card-wrap');
      if (!card || !wrap || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      // Skip on touch devices — tilt feels weird without a cursor
      if (window.matchMedia('(hover: none)').matches) return;
      const max = 6; // degrees
      const onMove = (e: MouseEvent) => {
        const rect = wrap.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width;
        const y = (e.clientY - rect.top) / rect.height;
        const rx = (0.5 - y) * max;
        const ry = (x - 0.5) * max;
        (card as HTMLElement).style.transform = `perspective(1000px) rotateX(${rx}deg) rotateY(${ry}deg)`;
      };
      const reset = () => {
        (card as HTMLElement).style.transform = 'perspective(1000px) rotateX(0) rotateY(0)';
      };
      wrap.addEventListener('mousemove', onMove);
      wrap.addEventListener('mouseleave', reset);
    }
    initHeroTilt();
    document.addEventListener('astro:after-swap', initHeroTilt);
  </script>

  <AppShowcase />

  <!-- SOCIAL PROOF / RATING -->
  <section class="max-w-5xl mx-auto px-6 py-16 border-t border-[color:var(--color-border)] reveal">
    <div class="grid md:grid-cols-3 gap-6 items-center text-center md:text-left">
      <div>
        <div class="flex items-center justify-center md:justify-start gap-1 mb-2">
          {Array.from({ length: 5 }).map((_, i) => (
            <svg
              viewBox="0 0 24 24"
              class="w-6 h-6 text-[#fbbf24] origin-center"
              fill="currentColor"
              style={`animation: float-slow 4s ease-in-out ${i * 0.15}s infinite;`}
            >
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/>
            </svg>
          ))}
        </div>
        <div
          class="text-5xl font-bold tracking-tight tabular-nums bg-gradient-to-br from-[color:var(--color-teal)] to-[color:var(--color-coral)] bg-clip-text text-transparent"


        >{APP_RATING.value}</div>
        <div class="text-sm text-[color:var(--color-ink-muted)] mt-1">
          <span>{APP_RATING.count}</span> ratings · US App Store
        </div>
      </div>
      <div class="md:col-span-2">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-3">Loved by early users</h2>
        <p class="text-[color:var(--color-ink-muted)] mb-4">
          {APP_RATING.value} out of 5 stars across {APP_RATING.count} ratings on the US App Store, checked September 27, 2026. People with Apple Watches who actually want to understand their stress.
        </p>
        <AppStoreBadge size="md" />
      </div>
    </div>
  </section>

  <script>
    function animateCounters() {
      const elements = document.querySelectorAll<HTMLElement>('[data-count-target]');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const target = parseFloat(el.dataset.countTarget || '0');
          const decimals = parseInt(el.dataset.countDecimals || '0', 10);
          const duration = 1100;
          const start = performance.now();
          const startVal = 0;
          function tick(now: number) {
            const t = Math.min(1, (now - start) / duration);
            const eased = 1 - Math.pow(1 - t, 3);
            const value = startVal + (target - startVal) * eased;
            el.textContent = decimals > 0 ? value.toFixed(decimals) : Math.round(value).toString();
            if (t < 1) requestAnimationFrame(tick);
          }
          requestAnimationFrame(tick);
          observer.unobserve(el);
        });
      }, { threshold: 0.4 });
      elements.forEach((el) => observer.observe(el));
    }
    animateCounters();
    document.addEventListener('astro:after-swap', animateCounters);
  </script>

  <Testimonials />

  <!-- WHAT'S INSIDE — one card per App Store screen, each with a small piece of the real app UI -->
  <section class="max-w-6xl mx-auto px-6 py-24 border-t border-[color:var(--color-border)] reveal">
    <div class="max-w-3xl mb-14">
      <div class="text-xs uppercase tracking-widest text-[color:var(--color-teal-dark)] font-medium mb-3">What's inside</div>
      <h2 class="text-4xl md:text-5xl font-bold tracking-tight leading-[1.05]">
        Your wearable readings,<br/>
        <span class="bg-gradient-to-r from-[color:var(--color-teal)] to-[color:var(--color-coral)] bg-clip-text text-transparent">in one place.</span> Explore stress and recovery patterns.
      </h2>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      <!-- Live score -->
      <a href="/features/hrv-stress-monitoring" class="feature-card group" style="--accent: #00bfa6; --accent-ink: #007569;">
        <span class="feature-badge">Now</span>
        <h3 class="feature-title">Live stress score</h3>
        <p class="feature-body">HRV, resting heart rate and sleep turned into one score through the day, with the inputs a tap away.</p>
        <div class="feature-ui grid grid-cols-2 gap-2" aria-hidden="true">
          <div class="mini-tile">
            <div class="text-[11px] font-semibold text-[#34c759]">HRV</div>
            <div class="text-lg font-bold tabular-nums leading-tight">58 <span class="text-xs font-medium text-[#8a939c]">ms</span></div>
            <svg viewBox="0 0 100 24" class="w-full h-5 mt-1" preserveAspectRatio="none"><path d="M0,18 L12,14 L24,16 L36,9 L48,12 L60,6 L72,10 L84,5 L100,7" fill="none" stroke="#34c759" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="mini-tile">
            <div class="text-[11px] font-semibold text-[#ef4444]">Resting HR</div>
            <div class="text-lg font-bold tabular-nums leading-tight">58 <span class="text-xs font-medium text-[#8a939c]">bpm</span></div>
            <svg viewBox="0 0 100 24" class="w-full h-5 mt-1" preserveAspectRatio="none"><path d="M0,8 L12,10 L24,7 L36,12 L48,11 L60,14 L72,13 L84,16 L100,15" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
        </div>
        <span class="feature-link">See how it works <span class="group-hover:translate-x-1 transition-transform">→</span></span>
      </a>

      <!-- Sleep -->
      <a href="/features/sleep-cortisol-tracking" class="feature-card group" style="--accent: #6e62e5; --accent-ink: #4f46c7;">
        <span class="feature-badge">Sleep</span>
        <h3 class="feature-title">Sleep quality</h3>
        <p class="feature-body">A nightly score with time asleep, efficiency, stages, and an overnight chart of heart rate, HRV, breathing and oxygen.</p>
        <div class="feature-ui" aria-hidden="true">
          <div class="flex items-baseline gap-2 mb-2">
            <span class="text-3xl font-bold tabular-nums leading-none">93</span>
            <span class="text-sm font-semibold text-[#34c759]">Excellent</span>
            <span class="ml-auto text-[11px] text-[#8a939c] tabular-nums">7h 47m</span>
          </div>
          <div class="space-y-1.5 text-[10px] text-[#8a939c]">
            <div class="stage-row"><span>Awake</span><i style="--l:2%; --w:4%; --c:#ff5a5f"></i></div>
            <div class="stage-row"><span>REM</span><i style="--l:18%; --w:30%; --c:#35c2e6"></i></div>
            <div class="stage-row"><span>Light</span><i style="--l:6%; --w:78%; --c:#3b82f6"></i></div>
            <div class="stage-row"><span>Deep</span><i style="--l:10%; --w:22%; --c:#6e62e5"></i></div>
          </div>
        </div>
        <span class="feature-link">See your sleep view <span class="group-hover:translate-x-1 transition-transform">→</span></span>
      </a>

      <!-- Bio Age -->
      <a href="/download/" class="feature-card group" style="--accent: #34c759; --accent-ink: #1f8a3c;">
        <span class="feature-badge">Bio Age</span>
        <h3 class="feature-title">Bio Age &amp; Pace of Aging</h3>
        <p class="feature-body">An estimate of how fast your body is aging from your recovery data, and what's moving it. An estimate, not a medical test.</p>
        <div class="feature-ui" aria-hidden="true">
          <div class="flex items-center justify-between mb-2">
            <span class="text-sm font-semibold">Pace of Aging</span>
            <span class="text-lg font-bold tabular-nums text-[#34c759]">0.88×</span>
          </div>
          <div class="relative h-2 rounded-full" style="background: linear-gradient(90deg, #34c759, #34c759 30%, #00bfa6 45%, #ffcc40 70%, #ff9500 85%, #ff3b30);">
            <span class="absolute top-1/2 -translate-y-1/2 -translate-x-1/2 w-4 h-4 rounded-full bg-white shadow ring-1 ring-black/10" style="left: 18%;"></span>
          </div>
          <div class="flex justify-between mt-1.5 text-[10px] font-medium">
            <span class="text-[#34c759]">Slower</span><span class="text-[#8a939c]">On pace</span><span class="text-[#ff3b30]">Faster</span>
          </div>
        </div>
        <span class="feature-link">Get the app <span class="group-hover:translate-x-1 transition-transform">→</span></span>
      </a>

      <!-- Fitness -->
      <a href="/download/" class="feature-card group" style="--accent: #ff9500; --accent-ink: #b45f00;">
        <span class="feature-badge">Fitness</span>
        <h3 class="feature-title">Readiness &amp; activities</h3>
        <p class="feature-body">Weekly readiness, cardio load, steps and VO₂ max, plus runs, rides, swims, strength and yoga, and a monthly recap.</p>
        <div class="feature-ui" aria-hidden="true">
          <div class="flex items-end justify-between gap-3">
            <div>
              <div class="text-[11px] font-semibold text-[#34c759]">Good</div>
              <div class="text-2xl font-bold tabular-nums leading-none">71</div>
            </div>
            <div class="flex items-end gap-1.5 h-11 flex-1 justify-end">
              {[45, 60, 82, 38, 30, 28, 34].map((v, i) => (
                <div class="flex flex-col items-center gap-1">
                  <div class="w-2.5 h-9 rounded-full bg-[#34c759]/15 relative overflow-hidden">
                    <div class="absolute bottom-0 inset-x-0 rounded-full" style={`height:${v}%; background:${i === 2 ? '#34c759' : 'rgba(52,199,89,0.45)'}`}></div>
                  </div>
                  <span class={`text-[9px] ${i === 2 ? 'font-bold text-[#0f1419]' : 'text-[#8a939c]'}`}>{'SMTWTFS'[i]}</span>
                </div>
              ))}
            </div>
          </div>
          <div class="grid grid-cols-3 gap-1.5 mt-3 text-[10px]">
            <div class="mini-chip"><span class="text-[#ff9500] font-semibold">Cardio load</span><b>14</b></div>
            <div class="mini-chip"><span class="text-[#ff9500] font-semibold">Steps</span><b>9,140</b></div>
            <div class="mini-chip"><span class="text-[#3b82f6] font-semibold">VO₂ max</span><b>44.0</b></div>
          </div>
        </div>
        <span class="feature-link">Get the app <span class="group-hover:translate-x-1 transition-transform">→</span></span>
      </a>

      <!-- Zen -->
      <a href="/features/breathing-zen-mode" class="feature-card group" style="--accent: #00bfa6; --accent-ink: #007569;">
        <span class="feature-badge">Zen</span>
        <h3 class="feature-title">Ask Zen &amp; breathwork</h3>
        <p class="feature-body">Ask what's driving your score and get an answer from your own numbers, then take a short guided breathing session.</p>
        <div class="feature-ui space-y-2 text-[11px] leading-snug" aria-hidden="true">
          <div class="ml-auto w-fit max-w-[85%] px-3 py-1.5 rounded-2xl rounded-br-md bg-[#34c28f] text-white font-medium">What's driving my score today?</div>
          <div class="w-fit max-w-[92%] px-3 py-1.5 rounded-2xl rounded-bl-md bg-[#f1f3f5] text-[#374151]">You're at 26, in the Low band. Sleep was 7.8 hours and your HRV is strong at 58 ms.</div>
        </div>
        <span class="feature-link">Try a session <span class="group-hover:translate-x-1 transition-transform">→</span></span>
      </a>

      <!-- Apple Watch -->
      <a href="/stress/apple-watch/" class="feature-card group" style="--accent: #64748b; --accent-ink: #1f2937;">
        <span class="feature-badge">Apple Watch</span>
        <h3 class="feature-title">On your wrist</h3>
        <p class="feature-body">Pebble, Ripple and Bloom change color and mood with your level, or switch to Score mode. Seven complications and one-tap breathing.</p>
        <div class="feature-ui flex items-center gap-4" aria-hidden="true">
          <div class="shrink-0 w-[68px] h-[82px] rounded-[20px] bg-[#0f1419] ring-4 ring-[#2a2f35] flex flex-col items-center justify-center text-white">
            <span class="text-[7px] tracking-[0.2em] text-white/60 font-semibold">CORTISOL</span>
            <span class="text-2xl font-bold tabular-nums leading-none text-[#34c759]">26</span>
            <span class="text-[8px] font-bold text-[#34c759] mt-0.5">LOW</span>
          </div>
