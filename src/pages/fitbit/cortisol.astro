---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ, { type FAQItem } from '../../components/FAQ.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import InShort from '../../components/article/InShort.astro';
import ZenTip from '../../components/article/ZenTip.astro';
import ZenPicture from '../../components/article/ZenPicture.astro';

import { medicalWebPage } from '../../lib/schema';

const schema = medicalWebPage({
  name: 'Can Fitbit track cortisol?',
  pathname: '/fitbit/cortisol/',
});

const faqs: FAQItem[] = [
  {
    q: 'Can Fitbit measure cortisol?',
    a: 'No. Fitbit — like every consumer wearable — cannot measure cortisol. Cortisol is a hormone measured in blood, saliva, or urine in a lab. Fitbit measures physiological signals that are influenced by cortisol and the stress response, chiefly heart rate, heart-rate variability (HRV), electrodermal activity, and sleep. Its stress features estimate physical strain from those proxies.',
  },
  {
    q: 'Does Fitbit Resilience (formerly the Stress Management Score) reflect cortisol?',
    a: "Indirectly and imperfectly. Resilience, which replaced the Stress Management Score in 2026, is built from HRV, heart rate, EDA, exertion, and sleep — signals that shift with autonomic arousal, which is coupled to the HPA axis that releases cortisol. So a run of Low ratings can accompany a period of elevated cortisol, but Resilience is not a cortisol reading and shouldn't be treated as one.",
  },
  {
    q: 'How is HRV related to cortisol?',
    a: 'They are linked through the body\'s two main stress systems. The autonomic nervous system (which HRV reflects) and the HPA axis (which releases cortisol) are coordinated by overlapping brain regions. Chronic stress tends to lower HRV and dysregulate the cortisol rhythm together, which is why HRV is used as an accessible, non-invasive proxy for stress load even though it is not cortisol itself.',
  },
  {
    q: 'Is there any wearable that measures cortisol directly?',
    a: 'Not in consumer products today. Cortisol-sensing skin patches and sweat biosensors exist in research labs and early prototypes, but no mainstream wrist wearable — Fitbit, Apple Watch, Garmin, Oura, or Whoop — measures cortisol directly. They all infer stress from cardiovascular and electrodermal proxies.',
  },
  {
    q: 'Can Cortisol+ use my Fitbit data?',
    a: 'Fitbit support for Cortisol+ via Health Connect is on the way, but it is not a shipped feature yet. Cortisol+ gives a 0–100 wellness score from wearable signals; it does not measure or estimate cortisol. Today Cortisol+ works with Apple Health on iPhone and Apple Watch, and with Health Connect on Android. If you use a Fitbit, watch for Fitbit support via Health Connect as it becomes available.',
  },
];

const related = [
  { href: '/fitbit/', title: 'Fitbit stress tracking', hint: 'The full overview' },
  { href: '/fitbit/stress-management-score/', title: 'Resilience (Stress Management Score)', hint: 'How it is built' },
  { href: '/fitbit/hrv/', title: 'Fitbit HRV explained', hint: 'The cortisol proxy' },
  { href: '/cortisol/', title: 'Cortisol, explained', hint: 'The hormone itself' },
  { href: '/how-it-works/', title: 'How Cortisol+ works', hint: 'Signals to score' },
  { href: '/features/hrv-stress-monitoring/', title: 'HRV & stress monitoring', hint: 'Inside the app' },
];

const proseCard = `app-card px-5 py-6 sm:px-8 sm:py-8 prose prose-base sm:prose-lg max-w-none
  prose-headings:font-extrabold prose-headings:tracking-tight prose-headings:text-[color:var(--color-ink)]
  prose-headings:text-balance prose-headings:scroll-mt-24
  prose-h2:mt-12 prose-h2:mb-3 prose-h2:text-[1.5rem] sm:prose-h2:text-[1.75rem] prose-h2:leading-tight
  prose-h3:mt-8 prose-h3:mb-2
  prose-p:text-[color:var(--color-ink)] prose-p:leading-[1.75] prose-p:my-4
  prose-li:text-[color:var(--color-ink)] prose-li:leading-[1.7] prose-li:my-1.5
  prose-a:text-[color:var(--color-teal-dark)] prose-a:no-underline hover:prose-a:underline
  prose-strong:text-[color:var(--color-ink)]`;
---

<BaseLayout
  title="Can Fitbit track cortisol?"
  description="No wearable measures cortisol directly — not even Fitbit. What Fitbit actually tracks (HRV, EDA, heart rate), how those signals proxy the cortisol response, and what the gap means."
  image="/screenshots/wearable-insights.png"
  schema={schema}
>
  <article class="max-w-3xl mx-auto px-4 pt-6 pb-16">
    <header class="px-1 mb-6">
    <div class="text-xs uppercase tracking-widest text-[color:var(--color-teal-dark)] font-semibold mb-2">Fitbit</div>
    <h1 class="text-[2rem] md:text-5xl leading-[1.1] font-extrabold tracking-tight mb-3 text-balance">Can Fitbit track cortisol?</h1>
    <p class="text-[1.0625rem] md:text-xl leading-relaxed text-[color:var(--color-ink-muted)] text-pretty">
      Short answer: no. No consumer wearable measures cortisol directly. Not Fitbit, not Apple Watch, not Oura or Whoop. Here's what Fitbit does measure, how it relates to cortisol, and how to think about the gap.
    </p>
    </header>

    <InShort points={[
      'No. <strong>No wearable</strong> can measure cortisol. It needs a lab test.',
      'Fitbit reads <strong>HRV, heart rate, skin sweat and sleep</strong> instead.',
      'These signals move <strong>with</strong> stress, but they are <strong>not</strong> cortisol.',
    ]} />

    <div class={proseCard}>

      <h2>The honest answer</h2>
      <p><strong>Cortisol is a hormone. To measure it, you need a sample of blood, saliva or urine, tested in a lab.</strong></p>
      <p>A wrist device has a light-based heart-rate sensor and a skin-sweat (electrodermal) sensor. Neither can detect a hormone in your bloodstream.</p>
      <p>So when a Fitbit shows you a "stress" number, it is <strong>not</strong> reading cortisol. It's estimating physical stress from signals that tend to move along with your stress response.</p>
      <p>That's not a knock on Fitbit. It's an honest description of what any wearable can do today. The useful question isn't "does Fitbit measure cortisol?" (it doesn't). It's "how good are the stand-in signals, and what can I learn from them?"</p>

      <h2>What Fitbit actually measures</h2>
      <p>Fitbit's stress features rest on a few proven body signals:</p>
      <ul>
        <li><strong>Heart rate variability (HRV):</strong> the change in time between heartbeats. It's a well-studied marker of nervous system balance. See <a href="/fitbit/hrv/">Fitbit HRV explained</a>.</li>
        <li><strong>Heart rate:</strong> resting and raised, tracked all the time.</li>
        <li><strong>Electrodermal activity (EDA):</strong> changes in skin conductance from sweat glands, on devices with the EDA sensor.</li>
        <li><strong>Sleep:</strong> how much and how well. Sleep both reflects stress and helps control it.</li>
      </ul>
      <p>These feed Fitbit's daily <a href="/fitbit/stress-management-score/">Resilience rating (formerly the Stress Management Score)</a> and Readiness Score. They're real signals. They're just not hormones.</p>

      <ZenPicture src="/app-ui/start/zen_watch.webp" caption="Your Fitbit reads heartbeats, skin sweat and sleep, not hormones." />

      <h2>The HRV–cortisol link</h2>
      <p>Why do these stand-in signals work at all? <strong>Your body has two main stress systems, and they're linked:</strong></p>
      <ul>
        <li><strong>The autonomic nervous system (ANS)</strong> is the fast one. Within seconds of a stressor, it speeds up your heart and lowers HRV. This is what HRV shows.</li>
        <li><strong>The HPA axis</strong> (hypothalamic-pituitary-adrenal) is the slower one. It releases <strong>cortisol</strong> over minutes to hours.</li>
      </ul>
      <p>Both systems are controlled by overlapping parts of the brain, including the prefrontal cortex. They tend to move together under stress.</p>
      <p>Studies pooling many results show HRV reliably drops with mental stress. That drop comes from less "rest and digest" (vagal) activity, the same conditions that drive cortisol release. Long-term stress throws both off together.</p>
      <p>That link is exactly why HRV is used as an easy, non-invasive window onto the stress that also drives cortisol.</p>
      <p><strong>The catch: linked is not the same as equal.</strong> HRV and cortisol don't move in step minute by minute. Plenty of things, like exercise, posture and breathing, move HRV without a matching cortisol change. HRV is a useful stand-in for a <em>pattern</em>, not a replacement for a cortisol test.</p>

      <ZenTip image="/app-ui/zen_new_tour_fitness.webp">
        Just worked out? Wait a while before you read anything into your HRV. <strong>Exercise moves HRV</strong> without telling you much about cortisol.
      </ZenTip>

      <h2>Cortisol has a daily rhythm — that's the real target</h2>
      <p><strong>Cortisol isn't one number. It's a curve through the day.</strong></p>
      <ul>
        <li>In healthy people, it surges in the first 30–45 minutes after waking (the cortisol awakening response).</li>
        <li>Then it falls through the day to a low at night.</li>
        <li>Long-term stress, poor sleep and shift work can flatten or shift that curve.</li>
      </ul>
      <p>A wearable can't sample the hormone. But the daily patterns it <em>can</em> see, in HRV, heart rate and sleep, carry information about how your stress system behaves across the day. That pattern matters more than any single reading.</p>

      <a href="/start/" data-start-cta class="not-prose my-8 flex items-center gap-4 rounded-2xl bg-[color:var(--color-ink)] p-5 text-white no-underline shadow-sm transition hover:brightness-110">
        <img src="/apple-touch-icon.png" alt="" width="48" height="48" class="h-12 w-12 shrink-0 rounded-[13px]" />
        <span class="min-w-0 flex-1 leading-snug">
          <span class="block font-extrabold">Get your personal stress plan</span>
          <span class="block text-sm text-white/75">A one-minute check-in with Zen, then your plan in Cortisol+</span>
        </span>
        <span class="shrink-0 rounded-full bg-white px-4 py-2 text-sm font-extrabold text-[color:var(--color-ink)]">Start ›</span>
      </a>

      <h2>Where Cortisol+ fits — honestly</h2>
      <p>Cortisol+ is an app that gives you a 0–100 wellness score from wearable data: the same stand-in signals (HRV, resting heart rate, sleep and more) described above. It shows them as a day-by-day trend, not a lab value.</p>
      <p><strong>To be clear: it doesn't measure or estimate your cortisol level or cortisol pattern.</strong> No app can replace a blood or saliva test when you need a medical answer.</p>
      <p>Which devices work?</p>
      <ul>
        <li><strong>Today:</strong> Apple Health on iPhone and Apple Watch, and Health Connect on Android.</li>
        <li><strong>On the way:</strong> <strong>Fitbit support via Health Connect</strong>. That isn't a shipped feature yet.</li>
      </ul>
      <p>Whatever device you use, the same honest framing holds. You're looking at a wellness score built from signals your wearable already uses for stress, not a cortisol reading. Read <a href="/how-it-works/">our methodology</a> to see what it can and can't tell you.</p>

      <h2>Sources</h2>
      <ul>
        <li><a href="https://pubmed.ncbi.nlm.nih.gov/29486547/" rel="nofollow">Kim HG et al. Stress and Heart Rate Variability: A Meta-Analysis. Psychiatry Investig. 2018.</a></li>
        <li><a href="https://pubmed.ncbi.nlm.nih.gov/22178086/" rel="nofollow">Thayer JF et al. A meta-analysis of HRV and neuroimaging studies. Neurosci Biobehav Rev. 2012.</a></li>
        <li><a href="https://pubmed.ncbi.nlm.nih.gov/19488073/" rel="nofollow">Chrousos GP. Stress and disorders of the stress system (HPA axis &amp; cortisol). Nat Rev Endocrinol. 2009.</a></li>
        <li><a href="https://support.google.com/googlehealth/answer/14237928?hl=en" rel="nofollow">Google Health Help — Manage stress &amp; mindfulness (Resilience, formerly the Stress Management Score)</a></li>
      </ul>
    </div>

    <FAQ items={faqs} />
    <RelatedLinks links={related} />
  </article>
</BaseLayout>
