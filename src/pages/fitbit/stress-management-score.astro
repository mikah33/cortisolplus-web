---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ, { type FAQItem } from '../../components/FAQ.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import InShort from '../../components/article/InShort.astro';
import ZenTip from '../../components/article/ZenTip.astro';
import ZenPicture from '../../components/article/ZenPicture.astro';

import { medicalWebPage } from '../../lib/schema';

const UPDATED = '2026-11-12';

const schema = medicalWebPage({
  name: 'Fitbit Stress Management Score is now Resilience: how it works',
  pathname: '/fitbit/stress-management-score/',
  lastReviewed: UPDATED,
});

// The FAQ component renders every answer visibly and emits the FAQPage
// JSON-LD from this same array, so visible text and schema always match.
const faqs: FAQItem[] = [
  {
    q: 'What happened to the Fitbit Stress Management Score?',
    a: 'It was replaced by Resilience. On May 19, 2026 the Fitbit app became the Google Health app, and in the Mental wellbeing section Resilience replaced the Stress Management Score. Instead of a number from 1 to 100, Resilience is shown as Optimal, Balanced or Low.',
  },
  {
    q: 'What is Resilience in the Google Health app?',
    a: "Resilience is Google's daily rating of your capacity for the day ahead — in Google's words, your body's ability to absorb and bounce back from physical and mental strain. It is shown as Optimal, Balanced or Low. It is a wellness estimate built from heart, skin and sleep signals, not a hormone or cortisol reading.",
  },
  {
    q: 'How is Fitbit Resilience calculated?',
    a: 'Google says Resilience is built from more than 10 factors grouped into three categories: responsiveness (heart rate, heart-rate variability and EDA data, showing how hard your body worked to manage demands), exertion balance (recent exercise compared with your movement over the past week), and sleep patterns (the quality and quantity of your sleep last night and over the last week).',
  },
  {
    q: 'Where do I find Resilience in the Google Health app?',
    a: 'Open the Google Health app (formerly the Fitbit app) and tap the Health tab. Under Focus areas, tap Mental wellbeing, then Resilience. You need a compatible device: Fitbit Charge 4, 5 or 6, Inspire 2 or 3, Luxe, the Sense series, Versa 2, 3 or 4, Google Pixel Watch 2 and later, or Google Fitbit Air.',
  },
  {
    q: 'What is a good Fitbit Resilience or stress score?',
    a: 'Optimal is the best of the three ratings, followed by Balanced, then Low. Google does not publish the cutoffs behind each label, and the old 1–100 number is no longer shown, so there is no official "good score" to aim for. Your own trend over a week or two tells you more than any single day.',
  },
  {
    q: 'Do I need Premium to see Resilience?',
    a: 'No. Google lists Resilience as not Premium-exclusive; you need a compatible device. Google Health Premium (formerly Fitbit Premium) adds extra guided meditations and the Gemini-based Google Health Coach.',
  },
  {
    q: 'How do I improve my Resilience rating?',
    a: "Google's suggestions are regular exercise, a consistent bedtime with at least 7 hours of sleep a night, and relaxing activities such as meditation, mindfulness or breathing exercises. Because sleep and exertion balance feed the rating, avoiding sudden spikes in training load can help too. Expect changes over days to weeks, not overnight.",
  },
];

const toc = [
  { id: 'what-changed', label: 'What happened to the Stress Management Score?' },
  { id: 'what-is-resilience', label: 'What Resilience is' },
  { id: 'how-it-works', label: 'What feeds Resilience' },
  { id: 'where-to-find', label: 'Where to find Resilience' },
  { id: 'how-to-read', label: 'How to read Optimal, Balanced and Low' },
  { id: 'why-low', label: 'Why your rating dropped' },
  { id: 'improve', label: 'How to improve Resilience' },
  { id: 'limits', label: 'What it can’t tell you' },
  { id: 'faq', label: 'FAQ' },
];

const related = [
  { href: '/fitbit/', title: 'Fitbit stress tracking', hint: 'The full overview' },
  { href: '/fitbit/hrv/', title: 'Fitbit HRV explained', hint: 'The key input' },
  { href: '/fitbit/cortisol/', title: 'Can Fitbit track cortisol?', hint: 'The honest answer' },
  { href: '/stress/', title: 'Stress & cortisol', hint: 'The bigger picture' },
  { href: '/hrv/', title: 'HRV, explained', hint: 'Why it matters' },
  { href: '/how-it-works/', title: 'How Cortisol+ works', hint: 'From signals to score' },
];

const proseCard = `app-card px-5 py-6 sm:px-8 sm:py-8 prose prose-base sm:prose-lg max-w-none
  prose-headings:font-extrabold prose-headings:tracking-tight prose-headings:text-[color:var(--color-ink)]
  prose-headings:text-balance prose-headings:scroll-mt-24
  prose-h2:mt-12 prose-h2:mb-3 prose-h2:text-[1.5rem] sm:prose-h2:text-[1.75rem] prose-h2:leading-tight
  prose-h3:mt-8 prose-h3:mb-2
  prose-p:text-[color:var(--color-ink)] prose-p:leading-[1.75] prose-p:my-4
  prose-li:text-[color:var(--color-ink)] prose-li:leading-[1.7] prose-li:my-1.5
  prose-a:text-[color:var(--color-teal-dark)] prose-a:no-underline hover:prose-a:underline
  prose-strong:text-[color:var(--color-ink)]`;
---

<BaseLayout
  title="Fitbit Stress Management Score Is Now Resilience: How It Works"
  description="Fitbit's 1–100 Stress Management Score is now Resilience, rated Optimal, Balanced or Low in the Google Health app. What feeds it, where to find it, how to improve it."
  image="/screenshots/wearable-insights.png"
  schema={schema}
>
  <article class="max-w-3xl mx-auto px-4 pt-6 pb-16">
    <header class="px-1 mb-6">
      <div class="text-xs uppercase tracking-widest text-[color:var(--color-teal-dark)] font-semibold mb-2">Fitbit</div>
      <h1 class="text-[2rem] md:text-5xl leading-[1.1] font-extrabold tracking-tight mb-3 text-balance">Fitbit Stress Management Score is now Resilience</h1>
      <p class="text-[1.0625rem] md:text-xl leading-relaxed text-[color:var(--color-ink-muted)] text-pretty">
        Looking for your 1–100 stress number? It's gone. Fitbit's Stress Management Score was replaced by Resilience, a daily Optimal, Balanced or Low rating in the Google Health app. Here's what feeds it, where to find it, and the habits that really move it.
      </p>
      <p class="text-sm text-[color:var(--color-ink-muted)] mt-4">
        Updated {new Date(UPDATED).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })} · By <a href="/about/" class="underline underline-offset-2">Cortisol+ Editorial</a>
      </p>
    </header>

    <InShort points={[
      'Since May 19, 2026, the Stress Management Score is called <strong>Resilience</strong>.',
      'It\'s now <strong>Optimal, Balanced or Low</strong>, not a number from 1 to 100.',
      'Find it: Google Health app → <strong>Health</strong> → <strong>Mental wellbeing</strong>. Not Premium-only.',
    ]} />

    <!-- On this page -->
    <nav class="app-card overflow-hidden mb-6" aria-label="On this page">
      <div class="px-5 pt-4 pb-2 text-xs uppercase tracking-widest font-semibold text-[color:var(--color-ink-muted)]">On this page</div>
      <ol class="app-list">
        {toc.map((item) => (
          <li><a href={`#${item.id}`} class="app-row text-[0.98rem] font-semibold text-[color:var(--color-ink)]"><span>{item.label}</span><span class="app-chevron" aria-hidden="true">›</span></a></li>
        ))}
      </ol>
    </nav>

    <div class={proseCard}>
      <h2 id="what-changed">What happened to the Fitbit Stress Management Score?</h2>
      <p><strong>It was replaced by Resilience.</strong></p>
      <p>On May 19, 2026, the Fitbit app became the <strong>Google Health app</strong> (<a href="https://blog.google/products-and-platforms/products/google-health/google-health-app/">Google's announcement</a>).</p>
      <p>In Google's own words, "in the Mental Wellbeing section, Resilience replaces Stress score." It is "described as Optimal, Balanced, or Low, instead of a numerical value" (<a href="https://support.google.com/googlehealth/answer/17068213?hl=en">Google Health Help — what's new</a>).</p>
      <p>If you remember the old score, Resilience will feel familiar. It uses the same three groups of inputs. What changed:</p>
      <ul>
        <li>the name</li>
        <li>where it sits in the app</li>
        <li>you now get a label instead of a 1–100 number</li>
      </ul>
      <p>Your Fitbit device keeps working the same way.</p>

      <h2 id="what-is-resilience">What Resilience is</h2>
      <p>Google describes Resilience as a measure of "your capacity for the day ahead": "your body's ability to absorb and bounce back from physical and mental strain" (<a href="https://support.google.com/googlehealth/answer/14237928?hl=en">Google Health Help — Manage stress &amp; mindfulness</a>).</p>
      <p><strong>Like the old score, it reads <em>physical</em> signals, not your mood.</strong></p>
      <ul>
        <li>You can feel calm and get a Low rating after a hard workout or a short night.</li>
        <li>You can feel frazzled and see Optimal if your body's signals stayed steady.</li>
      </ul>
      <p>And it's not a hormone test. No Fitbit measures cortisol.</p>

      <h2 id="how-it-works">What feeds Resilience</h2>
      <p>Google says more than ten factors feed the rating, in three groups:</p>

      <div class="not-prose my-6 grid gap-3">
        <div class="rounded-2xl border border-[color:var(--color-border)] p-4">
          <h3 class="font-extrabold text-[color:var(--color-ink)]">Responsiveness</h3>
          <p class="mt-1 text-[0.9375rem] leading-snug text-[color:var(--color-ink)]">Uses <strong>heart rate</strong>, <strong>heart rate variability (HRV)</strong> and <strong>electrodermal activity (EDA)</strong> data to see how hard your body worked to handle physical and mental demands. A body that worked hard yesterday tends to show a lower <a class="text-[color:var(--color-teal-dark)]" href="/fitbit/hrv/">overnight HRV</a> and a higher heart rate.</p>
        </div>
        <div class="rounded-2xl border border-[color:var(--color-border)] p-4">
          <h3 class="font-extrabold text-[color:var(--color-ink)]">Exertion balance</h3>
          <p class="mt-1 text-[0.9375rem] leading-snug text-[color:var(--color-ink)]">Weighs the short-term demand of recent exercise against the longer-term benefit of your movement over the past week. One very hard session in an otherwise quiet week can lower your rating, even though exercise is good for you.</p>
        </div>
        <div class="rounded-2xl border border-[color:var(--color-border)] p-4">
          <h3 class="font-extrabold text-[color:var(--color-ink)]">Sleep patterns</h3>
          <p class="mt-1 text-[0.9375rem] leading-snug text-[color:var(--color-ink)]">How well and how much you slept last night and over the last week. A short or broken night is one of the quickest ways to see your rating dip.</p>
        </div>
      </div>

      <ZenTip image="/app-ui/zen_new_tour_sleep.webp">
        Want a steadier rating? Start with sleep. It's one of the <strong>quickest ways</strong> to see your Resilience change.
      </ZenTip>

      <h2 id="where-to-find">Where to find Resilience in the Google Health app</h2>
      <ol>
        <li><strong>Wear a compatible device and let it sync.</strong> Resilience works on Fitbit Charge 4, 5 and 6, Inspire 2 and 3, Luxe, the Sense series, Versa 2, 3 and 4, Google Pixel Watch 2 and later, and Google Fitbit Air.</li>
        <li><strong>Open the Google Health app</strong> (formerly the Fitbit app) and tap the <strong>Health</strong> tab.</li>
        <li>Under <em>Focus areas</em>, tap <strong>Mental wellbeing</strong>, then <strong>Resilience</strong>.</li>
      </ol>
      <p>From Mental wellbeing, you can also open <strong>Body responses</strong> on Sense devices and Pixel Watch 2 and later. See <a href="/fitbit/">our Fitbit stress tracking overview</a>.</p>
      <p><strong>Resilience is not a Premium-only feature.</strong> Google Health Premium (formerly Fitbit Premium) adds extra guided meditations and the Gemini-based Google Health Coach.</p>
      <p>Menus and device lists come from <a href="https://support.google.com/googlehealth/answer/14237928?hl=en">Google Health Help</a>. They can differ by app version and region.</p>

      <h2 id="how-to-read">How to read Optimal, Balanced and Low</h2>
      <p><strong>Optimal is the best of the three ratings, then Balanced, then Low.</strong></p>
      <p>Google doesn't publish the cutoffs behind each label. So old advice about "good" numbers on the 1–100 scale no longer applies. There's no official line to compare with anyone else.</p>
      <p><strong>The most useful habit: ignore any one day and watch the trend.</strong> One Low after a big workout or a bad night is expected. A run of Low days over one to two weeks is the signal worth acting on.</p>

      <a href="/start/" data-start-cta class="not-prose my-8 flex items-center gap-4 rounded-2xl bg-[color:var(--color-ink)] p-5 text-white no-underline shadow-sm transition hover:brightness-110">
        <img src="/apple-touch-icon.png" alt="" width="48" height="48" class="h-12 w-12 shrink-0 rounded-[13px]" />
        <span class="min-w-0 flex-1 leading-snug">
          <span class="block font-extrabold">Get your personal stress plan</span>
          <span class="block text-sm text-white/75">A one-minute check-in with Zen, then your plan in Cortisol+</span>
        </span>
        <span class="shrink-0 rounded-full bg-white px-4 py-2 text-sm font-extrabold text-[color:var(--color-ink)]">Start ›</span>
      </a>

      <h2 id="why-low">Why your rating dropped</h2>
      <p>The rating is built from responsiveness, exertion balance and sleep. So a Low day usually comes back to one of these:</p>
      <ul>
        <li><strong>Sleep:</strong> a short or broken night, or several in a row.</li>
        <li><strong>Training spike:</strong> a hard session that's out of line with your past week.</li>
        <li><strong>Lower HRV or higher heart rate than usual:</strong> alcohol, illness or a stressful evening can all cause this.</li>
      </ul>

      <h2 id="improve">How to improve Resilience (and the old Stress Management Score)</h2>
      <p>Google's own tips are simple, and they match the inputs above:</p>
      <ol>
        <li><strong>Protect sleep.</strong> Keep a regular bedtime and aim for at least 7 hours a night.</li>
        <li><strong>Move regularly.</strong> Regular exercise helps mood and health. Steady weekly activity also keeps exertion balance from swinging.</li>
        <li><strong>Build up training slowly</strong> and keep real easy days, rather than stacking hard sessions.</li>
        <li><strong>Try something relaxing,</strong> such as meditation, mindfulness or breathing exercises.</li>
        <li><strong>Go easy on alcohol,</strong> especially close to bedtime. It tends to disturb sleep and lower overnight HRV.</li>
      </ol>
      <p>Expect changes over days to weeks. HRV and sleep move slowly, so the rating rewards steady habits, not one good day.</p>

      <ZenPicture src="/app-ui/zen_new_breathe.webp" caption="Breathing exercises are one of Google's own tips for a better rating." />

      <h2 id="limits">What Resilience can't tell you</h2>
      <p><strong>Resilience is a stand-in signal.</strong> It can't measure cortisol, and it can't tell a stressful day from a hard workout.</p>
      <p>Want to understand cortisol, the hormone people usually mean by "stress"? See <a href="/fitbit/cortisol/">Can Fitbit track cortisol?</a></p>
      <p>Cortisol+ gives a 0–100 wellness score from wearable signals such as HRV, sleep and resting heart rate. It doesn't measure or estimate cortisol, and its score is not a cortisol test (<a href="/how-it-works/">see the methodology</a>). It works with Apple Health on iPhone and Apple Watch, and with Health Connect on Android. Fitbit support via Health Connect is on the way. It isn't a shipped feature yet.</p>

      <h2>Sources</h2>
      <ul>
        <li><a href="https://support.google.com/googlehealth/answer/14237928?hl=en" rel="nofollow">Google Health Help — Manage stress &amp; mindfulness (Resilience)</a></li>
        <li><a href="https://support.google.com/googlehealth/answer/17068213?hl=en" rel="nofollow">Google Health Help — What is new with the redesigned Google Health app</a></li>
        <li><a href="https://blog.google/products-and-platforms/products/google-health/google-health-app/" rel="nofollow">Google — Introducing the Google Health app</a></li>
        <li><a href="https://pubmed.ncbi.nlm.nih.gov/29486547/" rel="nofollow">Kim HG et al. Stress and Heart Rate Variability: A Meta-Analysis. Psychiatry Investig. 2018.</a></li>
        <li><a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC5624990/" rel="nofollow">Shaffer F, Ginsberg JP. An Overview of Heart Rate Variability Metrics and Norms. Front Public Health. 2017.</a></li>
      </ul>
    </div>

    <div id="faq" class="scroll-mt-24">
      <FAQ items={faqs} />
    </div>
    <RelatedLinks links={related} />

    <aside class="mt-6 app-card p-5 text-sm text-[color:var(--color-ink-muted)] leading-relaxed">
      <strong class="text-[color:var(--color-ink)]">Not medical advice.</strong> This page is educational. Fitbit, Google and Cortisol+ wearable scores are not hormone tests. For diagnosis, testing, or treatment of any medical condition, consult a qualified healthcare provider.
    </aside>
  </article>
</BaseLayout>
