---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ, { type FAQItem } from '../../components/FAQ.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import InShort from '../../components/article/InShort.astro';
import ZenTip from '../../components/article/ZenTip.astro';
import ZenPicture from '../../components/article/ZenPicture.astro';

import { medicalWebPage } from '../../lib/schema';

const UPDATED = '2026-11-12';

const schema = medicalWebPage({
  name: 'Fitbit HRV: where to find it and what it means',
  pathname: '/fitbit/hrv/',
  lastReviewed: UPDATED,
});

// The FAQ component renders every answer visibly and emits the FAQPage
// JSON-LD from this same array, so visible text and schema always match.
const faqs: FAQItem[] = [
  {
    q: 'Where do I find HRV on my Fitbit?',
    a: "Open the Google Health app (formerly the Fitbit app), tap the Health tab, then tap Vitals and look for Heart rate variability. Vitals replaces Health Metrics; in the old Fitbit app the path was formerly Today tab → Health Metrics. HRV needs a compatible device worn to sleep; Google says most metrics need at least 3 hours of quality sleep, so check after you wake up.",
  },
  {
    q: 'What is a normal HRV on Fitbit?',
    a: 'There is no single normal. HRV varies enormously by age, sex, fitness, and genetics — healthy adults can sit anywhere from the teens to over 100 ms. Because of that spread, your own baseline and trend matter far more than comparing your number to anyone else. Watch whether your nightly HRV is holding steady, rising, or falling relative to your personal average.',
  },
  {
    q: 'Why does Fitbit measure HRV overnight?',
    a: 'During the day, HRV is pushed around by movement, posture, caffeine, meals, and stress, which makes it noisy. Measuring overnight, while you are still and relaxed, gives a cleaner, more comparable reading of your recovery. Google says it uses the RMSSD formula on your heart-rate data, and its vitals are read from your sleep.',
  },
  {
    q: 'What does low HRV mean?',
    a: 'A lower-than-usual HRV generally reflects a shift toward sympathetic ("fight or flight") dominance — commonly from stress, poor sleep, alcohol, illness, overtraining, or dehydration. One low night is usually noise. A downward trend over one to two weeks is a more meaningful sign your body is under sustained load.',
  },
  {
    q: 'Is Fitbit HRV accurate?',
    a: 'Wrist optical (PPG) HRV is a reasonable estimate of overnight parasympathetic activity and is best used for tracking your own trend, not for clinical precision. It is less exact than a chest-strap ECG, and readings can be affected by fit, motion, and skin contact. Treat the nightly number as a data point and the multi-day trend as the signal.',
  },
];

const related = [
  { href: '/fitbit/', title: 'Fitbit stress tracking', hint: 'The full overview' },
  { href: '/fitbit/stress-management-score/', title: 'Resilience (Stress Management Score)', hint: 'Where HRV feeds in' },
  { href: '/fitbit/cortisol/', title: 'Can Fitbit track cortisol?', hint: 'HRV as a proxy' },
  { href: '/hrv/', title: 'HRV, explained', hint: 'The complete guide' },
  { href: '/stress/', title: 'Stress & cortisol', hint: 'The bigger picture' },
  { href: '/features/hrv-stress-monitoring/', title: 'HRV & stress monitoring', hint: 'Inside Cortisol+' },
];

const toc = [
  { id: 'where-to-find', label: 'Where to find HRV in the Google Health app' },
  { id: 'what-is-hrv', label: 'What HRV actually is' },
  { id: 'how-measured', label: 'How Fitbit measures it: overnight RMSSD' },
  { id: 'normal-hrv', label: 'What’s a normal HRV?' },
  { id: 'hrv-stress', label: 'HRV, stress and recovery' },
  { id: 'raise-hrv', label: 'How to raise your HRV' },
  { id: 'hrv-cortisol', label: 'HRV and cortisol' },
  { id: 'faq', label: 'FAQ' },
];

const proseCard = `app-card px-5 py-6 sm:px-8 sm:py-8 prose prose-base sm:prose-lg max-w-none
  prose-headings:font-extrabold prose-headings:tracking-tight prose-headings:text-[color:var(--color-ink)]
  prose-headings:text-balance prose-headings:scroll-mt-24
  prose-h2:mt-12 prose-h2:mb-3 prose-h2:text-[1.5rem] sm:prose-h2:text-[1.75rem] prose-h2:leading-tight
  prose-h3:mt-8 prose-h3:mb-2
  prose-p:text-[color:var(--color-ink)] prose-p:leading-[1.75] prose-p:my-4
  prose-li:text-[color:var(--color-ink)] prose-li:leading-[1.7] prose-li:my-1.5
  prose-a:text-[color:var(--color-teal-dark)] prose-a:no-underline hover:prose-a:underline
  prose-strong:text-[color:var(--color-ink)]`;
---

<BaseLayout
  title="Fitbit HRV: where to find it, what it means"
  description="Where HRV lives in the Google Health app (formerly Fitbit), how Fitbit measures overnight RMSSD in milliseconds, what a normal HRV is, and how it relates to stress."
  image="/screenshots/wearable-insights.png"
  schema={schema}
>
  <article class="max-w-3xl mx-auto px-4 pt-6 pb-16">
    <header class="px-1 mb-6">
      <div class="text-xs uppercase tracking-widest text-[color:var(--color-teal-dark)] font-semibold mb-2">Fitbit</div>
      <h1 class="text-[2rem] md:text-5xl leading-[1.1] font-extrabold tracking-tight mb-3 text-balance">Fitbit HRV: where to find it and what it means</h1>
      <p class="text-[1.0625rem] md:text-xl leading-relaxed text-[color:var(--color-ink-muted)] text-pretty">
        Heart rate variability is one of the most useful numbers your Fitbit collects. It's also one of the most misread. Here's where it lives in the Google Health app, how it's measured, and how to read it.
      </p>
      <p class="text-sm text-[color:var(--color-ink-muted)] mt-4">
        Updated {new Date(UPDATED).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })} · By <a href="/about/" class="underline underline-offset-2">Cortisol+ Editorial</a>
      </p>
    </header>

    <InShort image="/app-ui/start/zen_watch.webp" points={[
      'Find it: Google Health app → <strong>Health</strong> → <strong>Vitals</strong> → <strong>Heart rate variability</strong>.',
      'Measured <strong>while you sleep</strong> (RMSSD). Wear your device to bed.',
      'There\'s <strong>no single normal</strong>. Compare with your own baseline and trend.',
    ]} />

    <!-- On this page -->
    <nav class="app-card overflow-hidden mb-6" aria-label="On this page">
      <div class="px-5 pt-4 pb-2 text-xs uppercase tracking-widest font-semibold text-[color:var(--color-ink-muted)]">On this page</div>
      <ol class="app-list">
        {toc.map((item) => (
          <li><a href={`#${item.id}`} class="app-row text-[0.98rem] font-semibold text-[color:var(--color-ink)]"><span>{item.label}</span><span class="app-chevron" aria-hidden="true">›</span></a></li>
        ))}
      </ol>
    </nav>

    <div class={proseCard}>
      <p class="!text-[color:var(--color-ink-muted)] text-sm sm:text-base"><strong>2026 name changes:</strong> on May 19, 2026, the Fitbit app became the <strong>Google Health app</strong>, and Health Metrics moved under <strong>Vitals</strong> (<a href="https://support.google.com/googlehealth/answer/17068213?hl=en">Google Health Help — what's new</a>). Your Fitbit still measures HRV the same way. Only the app labels moved.</p>

      <h2 id="where-to-find">Where to find HRV in the Google Health app</h2>
      <p><strong>HRV isn't on the main Today screen.</strong> To find it:</p>
      <ol>
        <li><strong>Wear a compatible device to sleep and let it sync.</strong> Google lists HRV on Fitbit Air, Alta HR, Blaze, Charge 2 to 6, Inspire 2 and 3, Inspire HR, Luxe, the Sense and Versa series, and Pixel Watch models. Most vitals need at least 3 hours of quality sleep, so check after you wake up.</li>
        <li><strong>Open the Google Health app</strong> (formerly the Fitbit app) and tap the <strong>Health</strong> tab.</li>
        <li>Tap <strong>Vitals</strong> and look for <strong>Heart rate variability</strong>.</li>
      </ol>
      <p>In the old Fitbit app, HRV was under the Today tab → Health Metrics.</p>
      <p>Google works out your personal ranges for vitals from up to 30 days of data. So the history view is where HRV becomes really useful.</p>
      <p>The steps above come from <a href="https://support.google.com/googlehealth/answer/14236917?hl=en">Google Health Help — Track your vitals</a>. Menus can differ by app version and region.</p>

      <h2 id="what-is-hrv">What HRV actually is</h2>
      <p>Your heart doesn't beat like a metronome. The gap between beats keeps changing by milliseconds. That change is <strong>heart rate variability (HRV)</strong>.</p>
      <p>Your autonomic nervous system controls it:</p>
      <ul>
        <li>The "rest and digest" side (parasympathetic) <strong>increases</strong> the variation.</li>
        <li>The "fight or flight" side (sympathetic) <strong>reduces</strong> it.</li>
      </ul>
      <p>So, oddly, <strong>more</strong> variation usually means better recovery and stronger vagal tone.</p>

      <h2 id="how-measured">How Fitbit measures it: overnight RMSSD</h2>
      <p><strong>Google says it uses the RMSSD formula to work out HRV from your heart-rate data, while you sleep.</strong></p>
      <p>RMSSD stands for "root mean square of successive differences" between heartbeats. It's a standard measure of short-term variation, driven mostly by the "rest and digest" side. Like the other vitals, it's read <strong>while you sleep</strong>.</p>
      <p>Measuring overnight is on purpose. During the day, HRV gets pushed around by movement, posture, meals, caffeine and passing stress. That makes daytime readings noisy and hard to compare.</p>
      <p>Measuring while you're still and relaxed gives a cleaner nightly number. It better reflects how your body is recovering from the day.</p>

      <ZenTip image="/app-ui/zen_new_tour_sleep.webp">
        No HRV this morning? Check you <strong>wore your device to bed</strong> and slept at least 3 hours, then let it sync.
      </ZenTip>

      <h2 id="normal-hrv">What's a normal HRV?</h2>
      <p><strong>There is no universal "normal".</strong> HRV is one of the most personal numbers in the body.</p>
      <p>It drops with age. It differs by sex, fitness, genes and how it's measured. Google itself notes that age, sex, sleep, hormones, circadian rhythm (your body clock), caffeine, alcohol, exercise and stress can all affect HRV.</p>
      <p>Healthy adults can range from the teens to well over 100 ms. Published research on HRV norms stresses this spread. That's why comparing your number with a friend's is close to meaningless.</p>
      <p><strong>What matters is your baseline and your trend.</strong> After a few weeks of overnight readings, you'll have a personal range. Then the useful questions are:</p>
      <ul>
        <li>Is tonight's number within your range?</li>
        <li>Is the trend over several days rising (recovering) or falling (building load)?</li>
      </ul>

      <a href="/start/" data-start-cta class="not-prose my-8 flex items-center gap-4 rounded-2xl bg-[color:var(--color-ink)] p-5 text-white no-underline shadow-sm transition hover:brightness-110">
        <img src="/apple-touch-icon.png" alt="" width="48" height="48" class="h-12 w-12 shrink-0 rounded-[13px]" />
        <span class="min-w-0 flex-1 leading-snug">
          <span class="block font-extrabold">Get your personal stress plan</span>
          <span class="block text-sm text-white/75">A one-minute check-in with Zen, then your plan in Cortisol+</span>
        </span>
        <span class="shrink-0 rounded-full bg-white px-4 py-2 text-sm font-extrabold text-[color:var(--color-ink)]">Start ›</span>
      </a>

      <h2 id="hrv-stress">HRV, stress, and recovery</h2>
      <p><strong>HRV is one of the best-proven non-invasive markers of stress load.</strong></p>
      <p>A meta-analysis (a study pooling many studies) found HRV keeps falling under mental stress, driven by less "rest and digest" activity. Google puts it plainly: "a significant drop in HRV suggests that your body may be experiencing stress, strain, or showing potential signs of illness."</p>
      <p>In real life, a low overnight HRV often comes with:</p>
      <ul>
        <li>poor or short sleep</li>
        <li>alcohol the evening before</li>
        <li>illness, or the start of one</li>
        <li>hard training or overtraining without recovery</li>
        <li>sudden mental stress, and dehydration</li>
      </ul>
      <p>That's also why HRV feeds Fitbit's daily <a href="/fitbit/stress-management-score/">Resilience rating (formerly the Stress Management Score)</a> and Readiness Score. It is not a cortisol reading.</p>
      <p><strong>One low night is usually noise. A steady downward trend is the signal worth acting on.</strong> Often that means protecting sleep, easing training and cutting evening alcohol.</p>

      <h2 id="raise-hrv">How to raise your HRV</h2>
      <p>HRV is a slow-moving average. It responds to steady habits, not one-off efforts:</p>
      <ul>
        <li><strong>Sleep:</strong> the biggest single lever. A steady 7+ hours matters most.</li>
        <li><strong>Limit alcohol.</strong> It lowers overnight HRV for hours.</li>
        <li><strong>Slow breathing:</strong> a few minutes of slow, relaxed breathing can help you wind down.</li>
        <li><strong>Aerobic fitness</strong>, built up slowly over weeks.</li>
      </ul>

      <ZenPicture src="/app-ui/zen_new_breathe.webp" caption="A few minutes of slow breathing is one of the easiest habits to start." />

      <h2 id="hrv-cortisol">HRV and cortisol</h2>
      <p>HRV reflects your autonomic nervous system. That system is linked to the HPA axis, which releases cortisol. So HRV is widely used as an easy stand-in for the stress that also drives cortisol.</p>
      <p><strong>It isn't a cortisol measurement. No wearable does that.</strong> But the pattern is informative. We cover this fully in <a href="/fitbit/cortisol/">Can Fitbit track cortisol?</a></p>
      <p>Cortisol+ uses body signals like HRV, sleep and resting heart rate to give a 0–100 wellness score. It doesn't measure or estimate cortisol; its score is not a cortisol test (<a href="/how-it-works/">see the methodology</a>). It works with Apple Health on iPhone and Apple Watch, and with Health Connect on Android. Fitbit support via Health Connect is on the way. It isn't a shipped feature yet.</p>

      <h2>Sources</h2>
      <ul>
        <li><a href="https://support.google.com/googlehealth/answer/14236917?hl=en" rel="nofollow">Google Health Help — Track your vitals in the Google Health app (HRV)</a></li>
        <li><a href="https://support.google.com/googlehealth/answer/17068213?hl=en" rel="nofollow">Google Health Help — What is new with the redesigned Google Health app</a></li>
        <li><a href="https://support.google.com/googlehealth/answer/14237928?hl=en" rel="nofollow">Google Health Help — Manage stress &amp; mindfulness (Resilience)</a></li>
        <li><a href="https://support.google.com/googlehealth/answer/14237938?hl=en" rel="nofollow">Google Health Help — Track your heart rate</a></li>
        <li><a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC5624990/" rel="nofollow">Shaffer F, Ginsberg JP. An Overview of Heart Rate Variability Metrics and Norms. Front Public Health. 2017.</a></li>
        <li><a href="https://pubmed.ncbi.nlm.nih.gov/29486547/" rel="nofollow">Kim HG et al. Stress and Heart Rate Variability: A Meta-Analysis. Psychiatry Investig. 2018.</a></li>
      </ul>
    </div>

    <div id="faq" class="scroll-mt-24">
      <FAQ items={faqs} />
    </div>
    <RelatedLinks links={related} />

    <aside class="mt-6 app-card p-5 text-sm text-[color:var(--color-ink-muted)] leading-relaxed">
      <strong class="text-[color:var(--color-ink)]">Not medical advice.</strong> This page is educational. Fitbit, Google and Cortisol+ wearable scores are not hormone tests. For diagnosis, testing, or treatment of any medical condition, consult a qualified healthcare provider.
    </aside>
  </article>
</BaseLayout>
