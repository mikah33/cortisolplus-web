---
import AudienceFAQPage from '../components/AudienceFAQPage.astro';

const faqs = [
  {
    "q": "Does Cortisol+ diagnose burnout?",
    "a": "No. It does not establish a cortisol pattern that identifies burnout, and it cannot distinguish burnout from depression, a sleep disorder or another cause of symptoms. A check-in or chart can describe your experience without diagnosing it."
  },
  {
    "q": "Can a lower score confirm that I have recovered?",
    "a": "No. The app score depends on available wearable records and model assumptions. It can change without your work situation or symptoms improving. How you are functioning and feeling matters independently of the number."
  },
  {
    "q": "How long should recovery take?",
    "a": "Cortisol+ cannot predict a recovery timeline. The earlier website ranges for mild, moderate and severe burnout were not supported as app-specific forecasts and have been removed."
  },
  {
    "q": "What is useful to record?",
    "a": "Keep brief notes about work demands, sleep and how you feel. If you use the app, check record completeness and compare like measurements. You do not need to wait for a trend or finish a journal before seeking support."
  },
  {
    "q": "Should a score determine whether I change work or treatment?",
    "a": "No. Decisions about work support or clinical care should consider your situation and professional advice. The app cannot determine whether you should stop working, change medication or begin a treatment."
  }
];

const related = [
  {
    "href": "/how-it-works/",
    "title": "Scoring methodology",
    "hint": "Inputs and limitations"
  },
  {
    "href": "/resources/stress-sleep-journal/",
    "title": "Free observation journal",
    "hint": "Notes you control"
  },
  {
    "href": "/features/sleep-cortisol-tracking/",
    "title": "Sleep tracking guide",
    "hint": "Check the records"
  }
];
---

<AudienceFAQPage
  audience="Burnout"
  title="Burnout & Wearable Stress Scores: FAQ"
  description="Understand what Cortisol+ can show during a difficult work period, why a score cannot diagnose burnout, and how to keep tracking in perspective."
  intro="A wellness number cannot diagnose burnout or put a deadline on recovery."
  {faqs}
  {related}
/>
