---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GetAppButton from '../../components/GetAppButton.astro';
import FAQ, { type FAQItem } from '../../components/FAQ.astro';
import { SITE } from '../../consts';

const tools = [
  {
    href: '/tools/cortisol-calculator/',
    title: "Stress & habits check-in",
    body: "Eight questions about daily routines. No hormone estimate or diagnostic score.",
    duration: '8 Q · 60 sec',
  },
  {
    href: '/tools/morning-cortisol-test/',
    title: "Morning routine check-in",
    body: "Reflect on waking and morning habits. This is not a cortisol awakening response test.",
    duration: '6 Q · 60 sec',
  },
  {
    href: '/tools/stress-score/',
    title: "Daily stress check-in",
    body: "Make time to notice your daily stress and recovery.",
    duration: '6 Q · 60 sec',
  },
  {
    href: '/tools/burnout-risk/',
    title: "Work & burnout check-in",
    body: "Reflect on work, exhaustion and recovery; not a validated burnout assessment.",
    duration: '7 Q · 90 sec',
  },
  {
    href: '/tools/sleep-debt-cortisol/',
    title: "Sleep habits check-in",
    body: "Notice sleep timing and evening habits. No sleep-debt or cortisol calculation.",
    duration: '6 Q · 60 sec',
  },
];

const faqs: FAQItem[] = [
  {
    "q": "Can an online quiz measure cortisol?",
    "a": "No. These questions summarize your own observations. They have not been validated to diagnose a condition or estimate hormone levels. Clinical cortisol testing uses a biological sample and medical interpretation."
  },
  {
    "q": "Are my answers stored or sent to analytics?",
    "a": "If your privacy choice allows website analytics, we count which option you pick for each question and when you start or finish, so we can improve the quiz. That count has no name, email or account attached, and nothing you type is sent. You can turn analytics off under Privacy choices at the bottom of any page."
  },
  {
    "q": "What should I do with my check-in?",
    "a": "Use it to choose a routine to observe, or to organize questions for a healthcare professional. Seek advice for persistent or concerning symptoms regardless of how you answered."
  }
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Free cortisol & stress tools',
    url: `${SITE.url}/tools/`,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: tools.map((t, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${SITE.url}${t.href}/`,
        name: t.title,
      })),
    },
  },
];
---

<BaseLayout
  title="Free Cortisol Quiz: 60-Second Stress &amp; Habits Check-in"
  description="Take a free 60-second cortisol quiz to reflect on stress, sleep and daily habits. Five short check-ins — no account needed, results stay on your screen."
  image="/screenshots/wearable-insights.png"
  schema={schema}
>
  <article class="max-w-[30rem] md:max-w-3xl mx-auto px-4 pt-4 pb-16 lg:max-w-6xl lg:px-8 lg:pt-6">
    <!-- Searchers arrive here for a "60 second cortisol quiz": put it first. -->
    <header class="app-sky -mx-4 -mt-4 px-5 pt-6 pb-8 text-center md:rounded-b-[2rem] lg:mx-0 lg:mt-0 lg:grid lg:grid-cols-[minmax(0,1fr)_auto] lg:grid-rows-[1fr_auto_auto_auto_1fr] lg:items-center lg:gap-x-16 lg:rounded-[2rem] lg:px-14 lg:py-12 lg:text-left">
      <img src="/app-ui/zen_presenting_new.webp" alt="" width="306" height="480" class="mx-auto h-36 w-auto lg:col-start-2 lg:row-start-1 lg:row-span-5 lg:mx-0 lg:mr-6 lg:h-72" />
      <h1 class="mt-3 text-[2rem] md:text-5xl leading-[1.08] font-extrabold tracking-tight text-balance lg:col-start-1 lg:row-start-2 lg:mt-0 lg:text-[3.5rem]">
        Free 60-second cortisol quiz &amp; stress tools
      </h1>
      <p class="mt-3 text-[1.0625rem] leading-relaxed text-[color:var(--color-ink)]/75 text-pretty lg:col-start-1 lg:row-start-3 lg:mt-4 lg:max-w-xl lg:text-lg">
        Try a 60-second cortisol quiz to reflect on stress, sleep and habits. These tools summarize what you report; they cannot determine hormone levels or diagnose a condition.
      </p>
      <a href={`${tools[0].href}/`} class="app-btn w-full mt-6 lg:col-start-1 lg:row-start-4 lg:w-auto lg:justify-self-start lg:px-10">Start the 60-second quiz</a>
      <p class="mt-3 text-xs font-semibold text-[color:var(--color-ink)]/60 lg:col-start-1 lg:row-start-5 lg:self-start">No account needed · answers stay on your screen</p>
    </header>

    <h2 class="px-1 mt-8 mb-2 text-xl font-extrabold tracking-tight lg:mt-14 lg:mb-4 lg:text-[1.75rem]">All 5 check-ins</h2>
    <ul class="app-card app-list overflow-hidden mb-10 lg:mb-14 lg:grid lg:grid-cols-3 lg:gap-4 lg:overflow-visible lg:rounded-none! lg:bg-transparent! lg:shadow-none! lg:[&>*+*]:border-t-0! lg:[&>li:first-child]:col-span-2">
      {tools.map((t) => (
        <li class="lg:rounded-3xl lg:bg-white/92 lg:shadow-[0_1px_2px_rgba(18,24,38,0.04),0_12px_32px_-18px_rgba(40,96,140,0.35)] lg:transition-transform lg:hover:-translate-y-0.5">
          <a href={`${t.href}/`} class="app-row !items-start !py-4 lg:h-full lg:rounded-3xl lg:px-6! lg:py-6!">
            <span class="min-w-0">
              <span class="block font-extrabold text-[1.0625rem] lg:text-lg">{t.title}</span>
              <span class="block text-sm text-[color:var(--color-ink-muted)] leading-snug mt-0.5">{t.body}</span>
              <span class="inline-block mt-2 px-2 py-0.5 rounded-full bg-[color:var(--color-surface-2)] text-xs font-bold lg:mt-4">{t.duration}</span>
            </span>
            <span class="app-chevron mt-1">›</span>
          </a>
        </li>
      ))}
    </ul>

    <aside class="app-sky rounded-3xl overflow-hidden px-5 py-6 text-center mb-12 lg:grid lg:grid-cols-[auto_minmax(0,1fr)_18rem] lg:grid-rows-[auto_auto] lg:items-center lg:gap-x-10 lg:rounded-[2rem] lg:px-12 lg:py-10 lg:text-left lg:[&>.get-app]:col-start-3 lg:[&>.get-app]:row-start-1 lg:[&>.get-app]:row-span-2">
      <img src="/app-ui/zen_new_tour_now.webp" alt="" width="200" height="270" loading="lazy" class="mx-auto h-24 w-auto lg:col-start-1 lg:row-start-1 lg:row-span-2 lg:h-36" />
      <h2 class="mt-2 text-2xl font-extrabold tracking-tight lg:col-start-2 lg:row-start-1 lg:mt-0 lg:self-end lg:text-[1.75rem]">Explore your wearable stress signals</h2>
      <p class="mt-2 mb-5 text-[color:var(--color-ink)]/75 leading-relaxed lg:col-start-2 lg:row-start-2 lg:mb-0 lg:self-start">
        Cortisol+ brings your watch's HRV, sleep and activity into one view. Its wellness score is a model output, not a hormone measurement. <a href="/" class="underline font-semibold">See how Cortisol+ works</a>.
      </p>
      <GetAppButton />
    </aside>

    <div class="lg:mx-auto lg:max-w-3xl"><FAQ items={faqs} title="Tool FAQs" /></div>
  </article>
</BaseLayout>
