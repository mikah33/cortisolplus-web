---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RatingBadge from '../../components/RatingBadge.astro';
import FAQ, { type FAQItem } from '../../components/FAQ.astro';
import { SITE } from '../../consts';

const tools = [
  {
    href: '/tools/cortisol-calculator',
    title: "Stress & habits check-in",
    body: "Eight questions about daily routines. No hormone estimate or diagnostic score.",
    duration: '8 Q · 60 sec',
    color: 'teal',
  },
  {
    href: '/tools/morning-cortisol-test',
    title: "Morning routine check-in",
    body: "Reflect on waking and morning habits. This is not a cortisol awakening response test.",
    duration: '6 Q · 60 sec',
    color: 'coral',
  },
  {
    href: '/tools/stress-score',
    title: "Daily stress check-in",
    body: "Make time to notice your daily stress and recovery.",
    duration: '6 Q · 60 sec',
    color: 'mint',
  },
  {
    href: '/tools/burnout-risk',
    title: "Work & burnout check-in",
    body: "Reflect on work, exhaustion and recovery; not a validated burnout assessment.",
    duration: '7 Q · 90 sec',
    color: 'coral',
  },
  {
    href: '/tools/sleep-debt-cortisol',
    title: "Sleep habits check-in",
    body: "Notice sleep timing and evening habits. No sleep-debt or cortisol calculation.",
    duration: '6 Q · 60 sec',
    color: 'teal',
  },
];

const colorMap: Record<string, string> = {
  teal: 'from-[color:var(--color-teal)]/12 via-[color:var(--color-mint-soft)] to-white border-[color:var(--color-teal)]/20 hover:border-[color:var(--color-teal)]/50 hover:shadow-[color:var(--color-teal)]/25',
  coral: 'from-[color:var(--color-coral)]/12 via-[color:var(--color-coral)]/5 to-white border-[color:var(--color-coral)]/20 hover:border-[color:var(--color-coral)]/50 hover:shadow-[color:var(--color-coral)]/25',
  mint: 'from-[color:var(--color-mint)]/40 via-[color:var(--color-mint-soft)] to-white border-[color:var(--color-mint)]/40 hover:border-[color:var(--color-teal)]/50 hover:shadow-[color:var(--color-mint)]/40',
};

const faqs: FAQItem[] = [
  {
    "q": "Can an online quiz measure cortisol?",
    "a": "No. These questions summarize your own observations. They have not been validated to diagnose a condition or estimate hormone levels. Clinical cortisol testing uses a biological sample and medical interpretation."
  },
  {
    "q": "Are my answers stored or sent to analytics?",
    "a": "Answers stay in this page while it is open. We do not send answers or results to analytics. Optional website analytics only measures page visits and App Store clicks, according to your privacy choice."
  },
  {
    "q": "What should I do with my check-in?",
    "a": "Use it to choose a routine to observe, or to organize questions for a healthcare professional. Seek advice for persistent or concerning symptoms regardless of how you answered."
  }
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Free cortisol & stress tools',
    url: `${SITE.url}/tools/`,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: tools.map((t, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${SITE.url}${t.href}/`,
        name: t.title,
      })),
    },
  },
];
---

<BaseLayout
  title="Free Cortisol Quizzes &amp; Stress Check-ins"
  description="Free stress, sleep and habit check-ins. Try a 60-second cortisol quiz with clear limitations: no hormone measurement or diagnosis."
  image="/screenshots/health-breakdown.png"
  schema={schema}
>
  <article class="max-w-5xl mx-auto px-6 py-16">
    <div class="max-w-3xl mb-12">
      <div class="text-xs uppercase tracking-widest text-[color:var(--color-teal-dark)] font-medium mb-3">Free tools</div>
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight leading-[1.05] mb-6">
        <span class="bg-gradient-to-r from-[color:var(--color-teal)] to-[color:var(--color-coral)] bg-clip-text text-transparent">5 free</span> cortisol &amp; stress tools
      </h1>
      <p class="text-xl text-[color:var(--color-ink-muted)] leading-relaxed">
        Try a 60-second cortisol quiz to reflect on stress, sleep and habits. These tools summarize what you report; they cannot determine hormone levels or diagnose a condition.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-5 mb-20">
      {tools.map((t) => (
        <a href={t.href} class={`group relative block p-7 rounded-3xl bg-gradient-to-br ${colorMap[t.color]} border hover:-translate-y-1 hover:shadow-[0_20px_60px_-15px] transition-all duration-300 overflow-hidden`}>
          <div class="relative">
            <div class="flex items-center justify-between mb-3">
              <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-white/60 text-[color:var(--color-ink)] backdrop-blur">{t.duration}</span>
              <span class="text-[color:var(--color-ink-muted)] group-hover:translate-x-1 transition-transform">→</span>
            </div>
            <h2 class="text-2xl font-bold mb-2 group-hover:text-[color:var(--color-teal-dark)] transition-colors">{t.title}</h2>
            <p class="text-[color:var(--color-ink-muted)] leading-relaxed">{t.body}</p>
          </div>
        </a>
      ))}
    </div>

    <aside class="p-8 rounded-3xl bg-gradient-to-br from-[color:var(--color-mint-soft)] to-white border border-[color:var(--color-teal)]/20 mb-16">
      <div class="text-xs uppercase tracking-widest text-[color:var(--color-teal-dark)] font-semibold mb-2">Beyond quizzes</div>
      <h2 class="text-2xl md:text-3xl font-bold mb-3">Explore your wearable stress signals</h2>
      <p class="text-[color:var(--color-ink-muted)] mb-6 max-w-2xl">
        Cortisol+ brings Apple Watch HRV, sleep and activity into one view. Its wellness score is a model output, not a hormone measurement.
      </p>
      <div class="flex flex-wrap items-center gap-4">
        <a href="/" class="inline-flex items-center px-5 py-2.5 rounded-full bg-gradient-to-br from-[color:var(--color-teal)] to-[color:var(--color-teal-dark)] text-white font-semibold text-sm shadow-sm hover:brightness-110 transition">
          See how Cortisol+ works →
        </a>
        <RatingBadge size="sm" />
      </div>
    </aside>

    <FAQ items={faqs} title="Tool FAQs" />
  </article>
</BaseLayout>
