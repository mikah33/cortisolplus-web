---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuizHero from '../../components/QuizHero.astro';
import { webApplication } from '../../lib/schema';
import FAQ, { type FAQItem } from '../../components/FAQ.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Quiz, { type QuizQuestion, type QuizBand } from '../../components/Quiz.tsx';

const questions: QuizQuestion[] = [
  {
    id: 'pace',
    prompt: 'How would you describe the pace of your day?',
    options: [
      { label: 'Steady and manageable', weight: 0 },
      { label: 'Busy but contained', weight: 1 },
      { label: 'Constantly behind', weight: 2 },
      { label: 'Surviving, not living', weight: 3 },
    ],
  },
  {
    id: 'sleep-quality',
    prompt: 'How rested do you feel?',
    options: [
      { label: 'Most days', weight: 0 },
      { label: 'Some days', weight: 1 },
      { label: 'Rarely', weight: 2 },
      { label: 'Never', weight: 3 },
    ],
  },
  {
    id: 'switch-off',
    prompt: 'Can you switch off after work?',
    options: [
      { label: 'Yes, easily', weight: 0 },
      { label: 'Takes an hour or so', weight: 1 },
      { label: 'Not really', weight: 2 },
      { label: 'Brain never stops', weight: 3 },
    ],
  },
  {
    id: 'phys-symptoms',
    prompt: 'Physical symptoms (headaches, tense shoulders, gut issues)?',
    options: [
      { label: 'None', weight: 0 },
      { label: 'Mild', weight: 1 },
      { label: 'Frequent', weight: 2 },
      { label: 'Daily', weight: 3 },
    ],
  },
  {
    id: 'irritability',
    prompt: 'Are you snapping at people more than usual?',
    options: [
      { label: 'No', weight: 0 },
      { label: 'A little', weight: 1 },
      { label: 'Often', weight: 2 },
      { label: 'Constantly', weight: 3 },
    ],
  },
  {
    id: 'energy',
    prompt: 'Afternoon energy?',
    options: [
      { label: 'Steady', weight: 0 },
      { label: 'Slight dip', weight: 1 },
      { label: '2–4 PM crash', weight: 2 },
      { label: 'Wiped all afternoon', weight: 3 },
    ],
  },
];

const bands: QuizBand[] = [];

const faqs: FAQItem[] = [
  {
    "q": "Can an online quiz measure cortisol?",
    "a": "No. These questions summarize your own observations. They have not been validated to diagnose a condition or estimate hormone levels. Clinical cortisol testing uses a biological sample and medical interpretation."
  },
  {
    "q": "Are my answers stored or sent to analytics?",
    "a": "If your privacy choice allows website analytics, we count which option you pick for each question and when you start or finish, so we can improve the quiz. That count has no name, email or account attached, and nothing you type is sent. You can turn analytics off under Privacy choices at the bottom of any page."
  },
  {
    "q": "What should I do with my check-in?",
    "a": "Use it to choose a routine to observe, or to organize questions for a healthcare professional. Seek advice for persistent or concerning symptoms regardless of how you answered."
  }
];

const related = [
  { href: '/tools/cortisol-calculator/', title: 'Cortisol risk calculator', hint: '8 questions' },
  { href: '/tools/burnout-risk/', title: 'Burnout check-in', hint: '7 questions' },
  { href: '/cortisol/lower/', title: 'How to lower cortisol', hint: 'Evidence-ranked' },
];

const schema = webApplication({
  name: "Daily stress check-in",
  description: "Reflect on your daily stress and recovery habits with a free six-question check-in. No diagnosis, hormone estimate, signup or validated stress score.",
  pathname: "Daily stress check-in",
});
---

<BaseLayout
  title="Stress check-in: free daily reflection quiz"
  description="Reflect on your daily stress and recovery habits with a free six-question check-in. No diagnosis, hormone estimate, signup or validated stress score."
  image="/screenshots/wearable-insights.png"
  schema={schema}
>
  <!-- Desktop (lg+): the intro sits beside the quiz on one sky; below lg the markup renders exactly as before. -->
  <div class="lg:relative lg:isolate">
    <div aria-hidden="true" class="app-sky hidden lg:block lg:absolute lg:inset-x-0 lg:-top-[5.5rem] lg:-z-10 lg:h-[54rem]"></div>
    <div class="lg:mx-auto lg:grid lg:max-w-6xl lg:grid-cols-[minmax(0,1fr)_34rem] xl:grid-cols-[minmax(0,1fr)_40rem] lg:items-start lg:gap-x-10 xl:gap-x-16 lg:px-8 lg:pt-6">
    <div class="quiz-intro lg:sticky lg:top-24 lg:pt-4 lg:[&>section]:mt-0 lg:[&>section]:overflow-visible lg:[&>section]:bg-none! lg:[&>section]:p-0 lg:[&>section]:text-left lg:[&>section>div]:max-w-none lg:[&_.justify-center]:justify-start lg:[&_.quiz-hero-art]:mx-0 lg:[&_.quiz-hero-art]:mt-8 lg:[&_.quiz-hero-art]:h-56 lg:[&_h1]:mt-6 lg:[&_p]:mx-0 lg:[&_p]:mt-4 lg:[&_p]:text-lg lg:[&_ul]:mt-6">
    <QuizHero
      title="How heavy is your week?"
      subtitle="A quick stress check-in on pace, rest, tension and energy. See what stands out."
      image="/app-ui/start/symptom_stressed.webp"
      questions={6}
    />
    </div>
  <section class="relative mx-auto max-w-xl px-4 -mt-10 pb-2 lg:mx-0 lg:mt-0 lg:max-w-none lg:px-0">
    <Quiz client:load questions={questions} bands={bands} scoreLabel="Your stress load" />
    <aside class="mt-6 rounded-2xl bg-white/60 p-4 text-sm leading-relaxed text-[color:var(--color-ink-muted)]" aria-label="About this check-in">
      <div class="mb-1 font-bold text-[color:var(--color-ink)]">About this check-in</div>
      <p>6 questions to help you reflect on daily stress and recovery. For medical context, see <a class="font-semibold text-[color:var(--color-teal-dark)] underline underline-offset-2" href="https://medlineplus.gov/lab-tests/cortisol-test/">MedlinePlus on cortisol testing</a> and our <a class="font-semibold text-[color:var(--color-teal-dark)] underline underline-offset-2" href="/how-it-works/">wearable score limitations</a>.</p>
    </aside>
    <FAQ items={faqs} />
    <RelatedLinks title="Keep going" links={related} />
  </section>
    </div>
  </div>
</BaseLayout>
