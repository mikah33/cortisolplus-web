---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { webApplication } from '../../lib/schema';
import FAQ, { type FAQItem } from '../../components/FAQ.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Quiz, { type QuizQuestion, type QuizBand } from '../../components/Quiz.tsx';

const questions: QuizQuestion[] = [
  {
    id: 'avg-hours',
    prompt: 'Average hours of sleep on a weeknight?',
    options: [
      { label: '8+ hours', weight: 0 },
      { label: '7–8 hours', weight: 1 },
      { label: '6–7 hours', weight: 2 },
      { label: 'Under 6 hours', weight: 3 },
    ],
  },
  {
    id: 'weekend-recovery',
    prompt: 'Do you "catch up" on sleep on weekends?',
    options: [
      { label: "I don’t need to", weight: 0 },
      { label: '1 extra hour', weight: 1 },
      { label: '2–3 extra hours', weight: 2 },
      { label: '4+ extra hours / sleep until noon', weight: 3 },
    ],
  },
  {
    id: 'fall-asleep',
    prompt: 'How long does it take you to fall asleep?',
    options: [
      { label: 'Under 15 min', weight: 0 },
      { label: '15–30 min', weight: 1 },
      { label: '30–60 min', weight: 2 },
      { label: '60+ min / racing thoughts', weight: 3 },
    ],
  },
  {
    id: 'middle-night',
    prompt: 'Do you wake during the night?',
    options: [
      { label: 'Rarely', weight: 0 },
      { label: 'Once briefly', weight: 1 },
      { label: 'Multiple times', weight: 2 },
      { label: 'Awake 3–5 AM regularly', weight: 3 },
    ],
  },
  {
    id: 'alcohol',
    prompt: 'Alcohol within 3 hours of bed?',
    options: [
      { label: 'Never', weight: 0 },
      { label: 'Occasionally', weight: 1 },
      { label: '2–3 nights/week', weight: 2 },
      { label: 'Most nights', weight: 3 },
    ],
  },
  {
    id: 'screens',
    prompt: 'Screens within 30 min of sleep?',
    options: [
      { label: 'Never', weight: 0 },
      { label: 'Sometimes', weight: 1 },
      { label: 'Most nights', weight: 2 },
      { label: 'Phone in bed until I pass out', weight: 3 },
    ],
  },
];

const bands: QuizBand[] = [];

const faqs: FAQItem[] = [
  {
    "q": "Can an online quiz measure cortisol?",
    "a": "No. These questions summarize your own observations. They have not been validated to diagnose a condition or estimate hormone levels. Clinical cortisol testing uses a biological sample and medical interpretation."
  },
  {
    "q": "Are my answers stored or sent to analytics?",
    "a": "Answers stay in this page while it is open. We do not send answers or results to analytics. Optional website analytics only measures page visits and App Store clicks, according to your privacy choice."
  },
  {
    "q": "What should I do with my check-in?",
    "a": "Use it to choose a routine to observe, or to organize questions for a healthcare professional. Seek advice for persistent or concerning symptoms regardless of how you answered."
  }
];

const related = [
  { href: '/tools/cortisol-calculator', title: 'Cortisol risk calculator', hint: 'Full 8-Q assessment' },
  { href: '/tools/morning-cortisol-test', title: 'Morning energy check-in', hint: 'Morning reflection' },
  { href: '/cortisol/lower/sleep', title: 'Sleep to lower cortisol', hint: 'Evidence-ranked tactics' },
];

const schema = webApplication({
  name: "Sleep habits check-in",
  description: "Reflect on sleep duration, wake-ups and evening routines. This quiz does not calculate sleep debt or estimate how much cortisol you produce.",
  pathname: "Sleep habits check-in",
});
---

<BaseLayout
  title="Sleep & cortisol quiz: a sleep habits check-in"
  description="Reflect on sleep duration, wake-ups and evening routines. This quiz does not calculate sleep debt or estimate how much cortisol you produce."
  image="/screenshots/sleep-analysis.png"
  schema={schema}
>
  <section class="max-w-2xl mx-auto px-6 py-16">
    <div class="text-xs uppercase tracking-widest text-[color:var(--color-teal-dark)] font-medium mb-3">Calculator</div>
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4">Sleep habits check-in</h1>
    <p class="text-xl text-[color:var(--color-ink-muted)] mb-10">6 questions about sleep habits. This tool does not calculate sleep debt or cortisol levels.</p>

    <Quiz client:load questions={questions} bands={bands} scoreLabel="Your sleep-cortisol load" />

    <p class="mt-8 text-sm">For medical context, see <a class="underline" href="https://medlineplus.gov/lab-tests/cortisol-test/">MedlinePlus on cortisol testing</a> and our <a class="underline" href="/how-it-works/">wearable score limitations</a>.</p>
    <FAQ items={faqs} />
    <RelatedLinks links={related} />
  </section>
</BaseLayout>
