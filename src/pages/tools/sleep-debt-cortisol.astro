---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuizHero from '../../components/QuizHero.astro';
import { webApplication } from '../../lib/schema';
import FAQ, { type FAQItem } from '../../components/FAQ.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Quiz, { type QuizQuestion, type QuizBand } from '../../components/Quiz.tsx';

const questions: QuizQuestion[] = [
  {
    id: 'avg-hours',
    prompt: 'Average hours of sleep on a weeknight?',
    options: [
      { label: '8+ hours', weight: 0 },
      { label: '7–8 hours', weight: 1 },
      { label: '6–7 hours', weight: 2 },
      { label: 'Under 6 hours', weight: 3 },
    ],
  },
  {
    id: 'weekend-recovery',
    prompt: 'Do you "catch up" on sleep on weekends?',
    options: [
      { label: "I don’t need to", weight: 0 },
      { label: '1 extra hour', weight: 1 },
      { label: '2–3 extra hours', weight: 2 },
      { label: '4+ extra hours / sleep until noon', weight: 3 },
    ],
  },
  {
    id: 'fall-asleep',
    prompt: 'How long does it take you to fall asleep?',
    options: [
      { label: 'Under 15 min', weight: 0 },
      { label: '15–30 min', weight: 1 },
      { label: '30–60 min', weight: 2 },
      { label: '60+ min / racing thoughts', weight: 3 },
    ],
  },
  {
    id: 'middle-night',
    prompt: 'Do you wake during the night?',
    options: [
      { label: 'Rarely', weight: 0 },
      { label: 'Once briefly', weight: 1 },
      { label: 'Multiple times', weight: 2 },
      { label: 'Awake 3–5 AM regularly', weight: 3 },
    ],
  },
  {
    id: 'alcohol',
    prompt: 'Alcohol within 3 hours of bed?',
    options: [
      { label: 'Never', weight: 0 },
      { label: 'Occasionally', weight: 1 },
      { label: '2–3 nights/week', weight: 2 },
      { label: 'Most nights', weight: 3 },
    ],
  },
  {
    id: 'screens',
    prompt: 'Screens within 30 min of sleep?',
    options: [
      { label: 'Never', weight: 0 },
      { label: 'Sometimes', weight: 1 },
      { label: 'Most nights', weight: 2 },
      { label: 'Phone in bed until I pass out', weight: 3 },
    ],
  },
];

const bands: QuizBand[] = [];

const faqs: FAQItem[] = [
  {
    "q": "Can an online quiz measure cortisol?",
    "a": "No. These questions summarize your own observations. They have not been validated to diagnose a condition or estimate hormone levels. Clinical cortisol testing uses a biological sample and medical interpretation."
  },
  {
    "q": "Are my answers stored or sent to analytics?",
    "a": "If your privacy choice allows website analytics, we count which option you pick for each question and when you start or finish, so we can improve the quiz. That count has no name, email or account attached, and nothing you type is sent. You can turn analytics off under Privacy choices at the bottom of any page."
  },
  {
    "q": "What should I do with my check-in?",
    "a": "Use it to choose a routine to observe, or to organize questions for a healthcare professional. Seek advice for persistent or concerning symptoms regardless of how you answered."
  }
];

const related = [
  { href: '/tools/cortisol-calculator/', title: 'Cortisol risk calculator', hint: 'Full 8-Q assessment' },
  { href: '/tools/morning-cortisol-test/', title: 'Morning energy check-in', hint: 'Morning reflection' },
  { href: '/cortisol/lower/sleep/', title: 'Sleep to lower cortisol', hint: 'Evidence-ranked tactics' },
];

const schema = webApplication({
  name: "Sleep habits check-in",
  description: "Reflect on sleep duration, wake-ups and evening routines. This quiz does not calculate sleep debt or estimate how much cortisol you produce.",
  pathname: "Sleep habits check-in",
});
---

<BaseLayout
  title="Sleep & cortisol quiz: a sleep habits check-in"
  description="Reflect on sleep duration, wake-ups and evening routines. This quiz does not calculate sleep debt or estimate how much cortisol you produce."
  image="/screenshots/sleep-quality.png"
  schema={schema}
>
  <!-- Desktop (lg+): the intro sits beside the quiz on one sky; below lg the markup renders exactly as before. -->
  <div class="lg:relative lg:isolate">
    <div aria-hidden="true" class="app-sky hidden lg:block lg:absolute lg:inset-x-0 lg:-top-[5.5rem] lg:-z-10 lg:h-[54rem]"></div>
    <div class="lg:mx-auto lg:grid lg:max-w-6xl lg:grid-cols-[minmax(0,1fr)_34rem] xl:grid-cols-[minmax(0,1fr)_40rem] lg:items-start lg:gap-x-10 xl:gap-x-16 lg:px-8 lg:pt-6">
    <div class="quiz-intro lg:sticky lg:top-24 lg:pt-4 lg:[&>section]:mt-0 lg:[&>section]:overflow-visible lg:[&>section]:bg-none! lg:[&>section]:p-0 lg:[&>section]:text-left lg:[&>section>div]:max-w-none lg:[&_.justify-center]:justify-start lg:[&_.quiz-hero-art]:mx-0 lg:[&_.quiz-hero-art]:mt-8 lg:[&_.quiz-hero-art]:h-56 lg:[&_h1]:mt-6 lg:[&_p]:mx-0 lg:[&_p]:mt-4 lg:[&_p]:text-lg lg:[&_ul]:mt-6">
    <QuizHero
      title="Is your sleep working for you?"
      subtitle="A sleep habits check-in on hours, wake-ups and evenings. See what to change first."
      image="/app-ui/start/goal_sleep.webp"
      questions={6}
    />
    </div>
  <section class="relative mx-auto max-w-xl px-4 -mt-10 pb-2 lg:mx-0 lg:mt-0 lg:max-w-none lg:px-0">
    <Quiz client:load questions={questions} bands={bands} scoreLabel="Your sleep-cortisol load" />
    <aside class="mt-6 rounded-2xl bg-white/60 p-4 text-sm leading-relaxed text-[color:var(--color-ink-muted)]" aria-label="About this check-in">
      <div class="mb-1 font-bold text-[color:var(--color-ink)]">About this check-in</div>
      <p>6 questions about sleep habits. This tool does not calculate sleep debt or cortisol levels. For medical context, see <a class="font-semibold text-[color:var(--color-teal-dark)] underline underline-offset-2" href="https://medlineplus.gov/lab-tests/cortisol-test/">MedlinePlus on cortisol testing</a> and our <a class="font-semibold text-[color:var(--color-teal-dark)] underline underline-offset-2" href="/how-it-works/">wearable score limitations</a>.</p>
    </aside>
    <FAQ items={faqs} />
    <RelatedLinks title="Keep going" links={related} />
  </section>
    </div>
  </div>
</BaseLayout>
