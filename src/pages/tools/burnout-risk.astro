---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuizHero from '../../components/QuizHero.astro';
import { webApplication } from '../../lib/schema';
import FAQ, { type FAQItem } from '../../components/FAQ.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Quiz, { type QuizQuestion, type QuizBand } from '../../components/Quiz.tsx';

const questions: QuizQuestion[] = [
  {
    id: 'exhausted',
    prompt: 'Do you feel emotionally exhausted by the end of most workdays?',
    options: [
      { label: 'Never', weight: 0 },
      { label: 'Sometimes', weight: 1 },
      { label: 'Often', weight: 2 },
      { label: 'Always', weight: 3 },
    ],
  },
  {
    id: 'cynical',
    prompt: 'Have you become more cynical or detached about your work?',
    options: [
      { label: 'No', weight: 0 },
      { label: 'A little', weight: 1 },
      { label: 'Noticeably', weight: 2 },
      { label: 'I\'m completely checked out', weight: 3 },
    ],
  },
  {
    id: 'effective',
    prompt: 'Do you feel you\'re accomplishing meaningful things?',
    options: [
      { label: 'Yes, regularly', weight: 0 },
      { label: 'Some weeks', weight: 1 },
      { label: 'Rarely', weight: 2 },
      { label: 'No, just going through motions', weight: 3 },
    ],
  },
  {
    id: 'tired-rested',
    prompt: 'Do you feel tired even after a full night of sleep?',
    options: [
      { label: 'Rarely', weight: 0 },
      { label: 'Sometimes', weight: 1 },
      { label: 'Most days', weight: 2 },
      { label: 'Always', weight: 3 },
    ],
  },
  {
    id: 'getting-sick',
    prompt: 'Are you getting sick more often than you used to?',
    options: [
      { label: 'No', weight: 0 },
      { label: 'Slightly more', weight: 1 },
      { label: 'Noticeably more', weight: 2 },
      { label: 'Constantly run down', weight: 3 },
    ],
  },
  {
    id: 'weekends',
    prompt: 'Do weekends or time off restore you?',
    options: [
      { label: 'Yes', weight: 0 },
      { label: 'Somewhat', weight: 1 },
      { label: 'Barely', weight: 2 },
      { label: 'Not at all', weight: 3 },
    ],
  },
  {
    id: 'dreading',
    prompt: 'Do you dread Mondays (or the start of your work week)?',
    options: [
      { label: 'No', weight: 0 },
      { label: 'A bit', weight: 1 },
      { label: 'Yes, regularly', weight: 2 },
      { label: 'Severe Sunday dread', weight: 3 },
    ],
  },
];

const bands: QuizBand[] = [];

const faqs: FAQItem[] = [
  {
    "q": "Can an online quiz measure cortisol?",
    "a": "No. These questions summarize your own observations. They have not been validated to diagnose a condition or estimate hormone levels. Clinical cortisol testing uses a biological sample and medical interpretation."
  },
  {
    "q": "Are my answers stored or sent to analytics?",
    "a": "If your privacy choice allows website analytics, we count which option you pick for each question and when you start or finish, so we can improve the quiz. That count has no name, email or account attached, and nothing you type is sent. You can turn analytics off under Privacy choices at the bottom of any page."
  },
  {
    "q": "What should I do with my check-in?",
    "a": "Use it to choose a routine to observe, or to organize questions for a healthcare professional. Seek advice for persistent or concerning symptoms regardless of how you answered."
  }
];

const related = [
  { href: '/tools/stress-score/', title: 'Stress score quiz', hint: 'Day-to-day load' },
  { href: '/tools/sleep-debt-cortisol/', title: 'Sleep debt × cortisol', hint: 'Sleep deficit impact' },
  { href: '/cortisol/lower/', title: 'How to lower cortisol', hint: 'Recovery interventions' },
];

const schema = webApplication({
  name: "Work & burnout check-in",
  description: "Seven questions about work, exhaustion and recovery. A free reflection tool, not the Maslach Burnout Inventory or a clinical assessment.",
  pathname: "Work & burnout check-in",
});
---

<BaseLayout
  title="Burnout check-in: work & recovery reflection"
  description="Seven questions about work, exhaustion and recovery. A free reflection tool, not the Maslach Burnout Inventory or a clinical assessment."
  image="/screenshots/zen-ai-assistant.png"
  schema={schema}
>
  <!-- Desktop (lg+): the intro sits beside the quiz on one sky; below lg the markup renders exactly as before. -->
  <div class="lg:relative lg:isolate">
    <div aria-hidden="true" class="app-sky hidden lg:block lg:absolute lg:inset-x-0 lg:-top-[5.5rem] lg:-z-10 lg:h-[54rem]"></div>
    <div class="lg:mx-auto lg:grid lg:max-w-6xl lg:grid-cols-[minmax(0,1fr)_34rem] xl:grid-cols-[minmax(0,1fr)_40rem] lg:items-start lg:gap-x-10 xl:gap-x-16 lg:px-8 lg:pt-6">
    <div class="quiz-intro lg:sticky lg:top-24 lg:pt-4 lg:[&>section]:mt-0 lg:[&>section]:overflow-visible lg:[&>section]:bg-none! lg:[&>section]:p-0 lg:[&>section]:text-left lg:[&>section>div]:max-w-none lg:[&_.justify-center]:justify-start lg:[&_.quiz-hero-art]:mx-0 lg:[&_.quiz-hero-art]:mt-8 lg:[&_.quiz-hero-art]:h-56 lg:[&_h1]:mt-6 lg:[&_p]:mx-0 lg:[&_p]:mt-4 lg:[&_p]:text-lg lg:[&_ul]:mt-6">
    <QuizHero
      title="Running on empty?"
      subtitle="A burnout check-in on exhaustion, detachment and recovery. See which patterns stand out."
      image="/app-ui/start/symptom_fatigued.webp"
      questions={7}
    />
    </div>
  <section class="relative mx-auto max-w-xl px-4 -mt-10 pb-2 lg:mx-0 lg:mt-0 lg:max-w-none lg:px-0">
    <Quiz client:load questions={questions} bands={bands} scoreLabel="Your burnout risk" />
    <aside class="mt-6 rounded-2xl bg-white/60 p-4 text-sm leading-relaxed text-[color:var(--color-ink-muted)]" aria-label="About this check-in">
      <div class="mb-1 font-bold text-[color:var(--color-ink)]">About this check-in</div>
      <p>7 questions about work and recovery. This is not the Maslach Burnout Inventory and does not diagnose burnout. For medical context, see <a class="font-semibold text-[color:var(--color-teal-dark)] underline underline-offset-2" href="https://medlineplus.gov/lab-tests/cortisol-test/">MedlinePlus on cortisol testing</a> and our <a class="font-semibold text-[color:var(--color-teal-dark)] underline underline-offset-2" href="/how-it-works/">wearable score limitations</a>.</p>
    </aside>
    <FAQ items={faqs} />
    <RelatedLinks title="Keep going" links={related} />
  </section>
    </div>
  </div>
</BaseLayout>
