---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuizHero from '../../components/QuizHero.astro';
import { webApplication } from '../../lib/schema';
import FAQ, { type FAQItem } from '../../components/FAQ.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Quiz, { type QuizQuestion, type QuizBand } from '../../components/Quiz.tsx';

const questions: QuizQuestion[] = [
  {
    id: 'wake',
    prompt: 'How do you feel within 30 minutes of waking?',
    options: [
      { label: 'Alert and energized', weight: 0 },
      { label: 'Slow but functional', weight: 1 },
      { label: 'Groggy, need caffeine', weight: 2 },
      { label: 'Exhausted, can barely move', weight: 3 },
    ],
  },
  {
    id: 'racing',
    prompt: 'Do you wake with a racing heart or sense of dread?',
    options: [
      { label: 'Never', weight: 0 },
      { label: 'Occasionally', weight: 1 },
      { label: 'Often', weight: 2 },
      { label: 'Most days', weight: 3 },
    ],
  },
  {
    id: 'early-wake',
    prompt: 'Do you wake before your alarm — specifically between 3–5 AM?',
    options: [
      { label: 'No', weight: 0 },
      { label: 'Rarely', weight: 1 },
      { label: 'A few times a week', weight: 2 },
      { label: 'Almost nightly', weight: 3 },
    ],
  },
  {
    id: 'jaw',
    prompt: 'Do you wake with a clenched jaw or tension headache?',
    options: [
      { label: 'No', weight: 0 },
      { label: 'Sometimes', weight: 1 },
      { label: 'Most mornings', weight: 2 },
      { label: 'Daily', weight: 3 },
    ],
  },
  {
    id: 'appetite',
    prompt: 'Morning appetite?',
    options: [
      { label: 'Hungry within 60 min', weight: 0 },
      { label: 'Mild hunger', weight: 1 },
      { label: 'No appetite for hours', weight: 2 },
      { label: 'Nauseous in the morning', weight: 3 },
    ],
  },
  {
    id: 'caffeine-need',
    prompt: 'How soon do you need caffeine after waking?',
    options: [
      { label: "I don't drink caffeine", weight: 0 },
      { label: '90+ minutes after waking', weight: 0 },
      { label: 'Within 60 minutes', weight: 1 },
      { label: 'Within 30 minutes / before food', weight: 2 },
    ],
  },
];

const bands: QuizBand[] = [];

const faqs: FAQItem[] = [
  {
    "q": "Can an online quiz measure cortisol?",
    "a": "No. These questions summarize your own observations. They have not been validated to diagnose a condition or estimate hormone levels. Clinical cortisol testing uses a biological sample and medical interpretation."
  },
  {
    "q": "Are my answers stored or sent to analytics?",
    "a": "If your privacy choice allows website analytics, we count which option you pick for each question and when you start or finish, so we can improve the quiz. That count has no name, email or account attached, and nothing you type is sent. You can turn analytics off under Privacy choices at the bottom of any page."
  },
  {
    "q": "What should I do with my check-in?",
    "a": "Use it to choose a routine to observe, or to organize questions for a healthcare professional. Seek advice for persistent or concerning symptoms regardless of how you answered."
  }
];

const related = [
  { href: '/tools/cortisol-calculator/', title: 'Full cortisol risk calculator', hint: '8 questions · 60 sec' },
  { href: '/tools/stress-score/', title: 'Stress score quiz', hint: 'Day-to-day load' },
  { href: '/cortisol/symptoms/', title: 'Symptoms of high cortisol', hint: 'Full symptom guide' },
];

const schema = webApplication({
  name: "Morning routine check-in",
  description: "Reflect on how you feel after waking. This free morning quiz cannot measure your cortisol awakening response or replace a clinical test.",
  pathname: "Morning routine check-in",
});
---

<BaseLayout
  title="Morning cortisol quiz: sleep & wake-up check-in"
  description="Reflect on how you feel after waking. This free morning quiz cannot measure your cortisol awakening response or replace a clinical test."
  image="/screenshots/live-stress-levels.png"
  schema={schema}
>
  <!-- Desktop (lg+): the intro sits beside the quiz on one sky; below lg the markup renders exactly as before. -->
  <div class="lg:relative lg:isolate">
    <div aria-hidden="true" class="app-sky hidden lg:block lg:absolute lg:inset-x-0 lg:-top-[5.5rem] lg:-z-10 lg:h-[54rem]"></div>
    <div class="lg:mx-auto lg:grid lg:max-w-6xl lg:grid-cols-[minmax(0,1fr)_34rem] xl:grid-cols-[minmax(0,1fr)_40rem] lg:items-start lg:gap-x-10 xl:gap-x-16 lg:px-8 lg:pt-6">
    <div class="quiz-intro lg:sticky lg:top-24 lg:pt-4 lg:[&>section]:mt-0 lg:[&>section]:overflow-visible lg:[&>section]:bg-none! lg:[&>section]:p-0 lg:[&>section]:text-left lg:[&>section>div]:max-w-none lg:[&_.justify-center]:justify-start lg:[&_.quiz-hero-art]:mx-0 lg:[&_.quiz-hero-art]:mt-8 lg:[&_.quiz-hero-art]:h-56 lg:[&_h1]:mt-6 lg:[&_p]:mx-0 lg:[&_p]:mt-4 lg:[&_p]:text-lg lg:[&_ul]:mt-6">
    <QuizHero
      title="How do your mornings really feel?"
      subtitle="A morning check-in on waking, tension and that first coffee. See your patterns side by side."
      image="/app-ui/zen_new_normal.webp"
      questions={6}
    />
    </div>
  <section class="relative mx-auto max-w-xl px-4 -mt-10 pb-2 lg:mx-0 lg:mt-0 lg:max-w-none lg:px-0">
    <Quiz client:load questions={questions} bands={bands} scoreLabel="Your CAR pattern" />
    <aside class="mt-6 rounded-2xl bg-white/60 p-4 text-sm leading-relaxed text-[color:var(--color-ink-muted)]" aria-label="About this check-in">
      <div class="mb-1 font-bold text-[color:var(--color-ink)]">About this check-in</div>
      <p>6 questions about mornings. Your answers describe your experience, not your cortisol awakening response. For medical context, see <a class="font-semibold text-[color:var(--color-teal-dark)] underline underline-offset-2" href="https://medlineplus.gov/lab-tests/cortisol-test/">MedlinePlus on cortisol testing</a> and our <a class="font-semibold text-[color:var(--color-teal-dark)] underline underline-offset-2" href="/how-it-works/">wearable score limitations</a>.</p>
    </aside>
    <FAQ items={faqs} />
    <RelatedLinks title="Keep going" links={related} />
  </section>
    </div>
  </div>
</BaseLayout>
