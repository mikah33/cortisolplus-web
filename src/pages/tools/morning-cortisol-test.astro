---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { webApplication } from '../../lib/schema';
import FAQ, { type FAQItem } from '../../components/FAQ.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Quiz, { type QuizQuestion, type QuizBand } from '../../components/Quiz.tsx';

const questions: QuizQuestion[] = [
  {
    id: 'wake',
    prompt: 'How do you feel within 30 minutes of waking?',
    options: [
      { label: 'Alert and energized', weight: 0 },
      { label: 'Slow but functional', weight: 1 },
      { label: 'Groggy, need caffeine', weight: 2 },
      { label: 'Exhausted, can barely move', weight: 3 },
    ],
  },
  {
    id: 'racing',
    prompt: 'Do you wake with a racing heart or sense of dread?',
    options: [
      { label: 'Never', weight: 0 },
      { label: 'Occasionally', weight: 1 },
      { label: 'Often', weight: 2 },
      { label: 'Most days', weight: 3 },
    ],
  },
  {
    id: 'early-wake',
    prompt: 'Do you wake before your alarm — specifically between 3–5 AM?',
    options: [
      { label: 'No', weight: 0 },
      { label: 'Rarely', weight: 1 },
      { label: 'A few times a week', weight: 2 },
      { label: 'Almost nightly', weight: 3 },
    ],
  },
  {
    id: 'jaw',
    prompt: 'Do you wake with a clenched jaw or tension headache?',
    options: [
      { label: 'No', weight: 0 },
      { label: 'Sometimes', weight: 1 },
      { label: 'Most mornings', weight: 2 },
      { label: 'Daily', weight: 3 },
    ],
  },
  {
    id: 'appetite',
    prompt: 'Morning appetite?',
    options: [
      { label: 'Hungry within 60 min', weight: 0 },
      { label: 'Mild hunger', weight: 1 },
      { label: 'No appetite for hours', weight: 2 },
      { label: 'Nauseous in the morning', weight: 3 },
    ],
  },
  {
    id: 'caffeine-need',
    prompt: 'How soon do you need caffeine after waking?',
    options: [
      { label: "I don't drink caffeine", weight: 0 },
      { label: '90+ minutes after waking', weight: 0 },
      { label: 'Within 60 minutes', weight: 1 },
      { label: 'Within 30 minutes / before food', weight: 2 },
    ],
  },
];

const bands: QuizBand[] = [];

const faqs: FAQItem[] = [
  {
    "q": "Can an online quiz measure cortisol?",
    "a": "No. These questions summarize your own observations. They have not been validated to diagnose a condition or estimate hormone levels. Clinical cortisol testing uses a biological sample and medical interpretation."
  },
  {
    "q": "Are my answers stored or sent to analytics?",
    "a": "Answers stay in this page while it is open. We do not send answers or results to analytics. Optional website analytics only measures page visits and App Store clicks, according to your privacy choice."
  },
  {
    "q": "What should I do with my check-in?",
    "a": "Use it to choose a routine to observe, or to organize questions for a healthcare professional. Seek advice for persistent or concerning symptoms regardless of how you answered."
  }
];

const related = [
  { href: '/tools/cortisol-calculator', title: 'Full cortisol risk calculator', hint: '8 questions · 60 sec' },
  { href: '/tools/stress-score', title: 'Stress score quiz', hint: 'Day-to-day load' },
  { href: '/cortisol/symptoms', title: 'Symptoms of high cortisol', hint: 'Full symptom guide' },
];

const schema = webApplication({
  name: "Morning routine check-in",
  description: "Reflect on how you feel after waking. This free morning quiz cannot measure your cortisol awakening response or replace a clinical test.",
  pathname: "Morning routine check-in",
});
---

<BaseLayout
  title="Morning cortisol quiz: sleep & wake-up check-in"
  description="Reflect on how you feel after waking. This free morning quiz cannot measure your cortisol awakening response or replace a clinical test."
  image="/screenshots/daily-insights.png"
  schema={schema}
>
  <section class="max-w-2xl mx-auto px-6 py-16">
    <div class="text-xs uppercase tracking-widest text-[color:var(--color-teal-dark)] font-medium mb-3">Test</div>
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4">Morning routine check-in</h1>
    <p class="text-xl text-[color:var(--color-ink-muted)] mb-10">6 questions about mornings. Your answers describe your experience, not your cortisol awakening response.</p>

    <Quiz client:load questions={questions} bands={bands} scoreLabel="Your CAR pattern" />

    <p class="mt-8 text-sm">For medical context, see <a class="underline" href="https://medlineplus.gov/lab-tests/cortisol-test/">MedlinePlus on cortisol testing</a> and our <a class="underline" href="/how-it-works/">wearable score limitations</a>.</p>
    <FAQ items={faqs} />
    <RelatedLinks links={related} />
  </section>
</BaseLayout>
