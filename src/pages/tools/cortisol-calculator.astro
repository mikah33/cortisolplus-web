---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuizHero from '../../components/QuizHero.astro';
import { webApplication } from '../../lib/schema';
import CortisolCalculator from '../../components/CortisolCalculator.tsx';
import FAQ, { type FAQItem } from '../../components/FAQ.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';

const faqs: FAQItem[] = [
  {
    "q": "Can an online quiz measure cortisol?",
    "a": "No. These questions summarize your own observations. They have not been validated to diagnose a condition or estimate hormone levels. Clinical cortisol testing uses a biological sample and medical interpretation."
  },
  {
    "q": "Are my answers stored or sent to analytics?",
    "a": "If your privacy choice allows website analytics, we count which option you pick for each question and when you start or finish, so we can improve the quiz. That count has no name, email or account attached, and nothing you type is sent. You can turn analytics off under Privacy choices at the bottom of any page."
  },
  {
    "q": "What should I do with my check-in?",
    "a": "Use it to choose a routine to observe, or to organize questions for a healthcare professional. Seek advice for persistent or concerning symptoms regardless of how you answered."
  }
];

const related = [
  { href: '/tools/morning-cortisol-test/', title: 'Morning energy check-in', hint: 'Morning reflection' },
  { href: '/tools/stress-score/', title: 'Stress score quiz', hint: 'Day-to-day load' },
  { href: '/tools/burnout-risk/', title: 'Burnout check-in', hint: '7 questions' },
];

const schema = webApplication({
  name: "Cortisol quiz: stress & habits check-in",
  description: "Reflect on stress, sleep and everyday habits in eight questions. This free cortisol quiz cannot measure hormones or diagnose a condition.",
  pathname: "Cortisol quiz: stress & habits check-in",
});
---

<BaseLayout
  title="Cortisol quiz: a 60-second stress & habits check-in"
  description="Reflect on stress, sleep and everyday habits in eight questions. This free cortisol quiz cannot measure hormones or diagnose a condition."
  image="/screenshots/live-stress-levels.png"
  schema={schema}
>
  <QuizHero
    title="The 60-second cortisol quiz"
    subtitle="8 quick questions on sleep, caffeine, mood and training. See which patterns to watch first."
    image="/app-ui/start/zen_explain.webp"
    questions={8}
  />
  <section class="relative mx-auto max-w-xl px-4 -mt-10 pb-2">
    <CortisolCalculator client:load />
    <aside class="mt-6 rounded-2xl bg-white/60 p-4 text-sm leading-relaxed text-[color:var(--color-ink-muted)]" aria-label="About this check-in">
      <div class="mb-1 font-bold text-[color:var(--color-ink)]">About this check-in</div>
      <p>8 questions about your habits. A useful check-in, without a hormone estimate. For medical context, see <a class="font-semibold text-[color:var(--color-teal-dark)] underline underline-offset-2" href="https://medlineplus.gov/lab-tests/cortisol-test/">MedlinePlus on cortisol testing</a> and our <a class="font-semibold text-[color:var(--color-teal-dark)] underline underline-offset-2" href="/how-it-works/">wearable score limitations</a>.</p>
    </aside>
    <FAQ items={faqs} />
    <RelatedLinks title="Keep going" links={related} />
  </section>
</BaseLayout>
