---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../consts';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Cortisol+ blog',
    description: 'Cortisol, stress, sleep, HRV, and wearable health science — explained.',
    url: `${SITE.url}/blog/`,
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Cortisol+ blog',
    url: `${SITE.url}/blog/`,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: posts.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${SITE.url}/blog/${p.id}/`,
        name: p.data.title,
      })),
    },
  },
];
---

<BaseLayout
  title="Cortisol+ Blog — Stress, Sleep & Wearables"
  description="Evidence-first articles on cortisol, stress, HRV, and wearables — app comparisons, supplement deep-dives, and what the research actually supports."
  schema={schema}
>
  <section class="max-w-3xl mx-auto px-6 py-16 lg:max-w-6xl lg:py-20">
    <div class="text-xs uppercase tracking-widest text-[color:var(--color-teal-dark)] font-medium mb-3">Notes</div>
    <h1 class="text-5xl font-bold tracking-tight mb-6 lg:text-6xl">Blog</h1>
    <p class="text-xl text-[color:var(--color-ink-muted)] mb-12 lg:max-w-2xl">
      Cortisol, stress, sleep, HRV — explained.
    </p>

    {posts.length === 0 ? (
      <p class="text-[color:var(--color-ink-muted)]">First posts coming soon.</p>
    ) : (
      <ul class="space-y-4 lg:grid lg:grid-cols-3 lg:gap-5 lg:space-y-0">
        {posts.map((post) => (
          <li class="lg:flex">
            <a href={`/blog/${post.id}/`} class="block p-6 lg:flex lg:w-full lg:flex-col rounded-2xl border border-[color:var(--color-border)] hover:border-[color:var(--color-teal)]/40 hover:bg-[color:var(--color-surface)] transition">
              <div class="text-xs text-[color:var(--color-ink-muted)] mb-1">
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
              </div>
              <h2 class="text-xl font-semibold mb-1 lg:text-lg lg:leading-snug lg:mb-2">{post.data.title}</h2>
              <p class="text-sm text-[color:var(--color-ink-muted)]">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
