---
import FunnelLayout from '../../layouts/FunnelLayout.astro';
import StartFlow from '../../components/start/StartFlow.tsx';
import reviewsData from '../../data/reviews.json';
import QRCode from 'qrcode';
import { SITE, APP_RATING } from '../../consts';

const qrSvg = await QRCode.toString(`${SITE.url}/download/`, { type: 'svg', margin: 0, color: { dark: '#121826', light: '#ffffff' } });
const reviews = reviewsData.reviews.map(({ title, body, author, rating }) => ({ title, body, author, rating }));
---

<FunnelLayout
  title="Meet Zen — Build your Cortisol+ plan"
  description="Answer a few questions and Zen builds your personal plan for calmer, lower-stress days."
>
  <StartFlow
    client:load
    reviews={reviews}
    rating={{ value: APP_RATING.value, count: APP_RATING.count }}
    appStoreUrl={SITE.appStoreUrl}
    googlePlayUrl={SITE.googlePlayUrl}
    qrSvg={qrSvg}
  />
</FunnelLayout>

<style is:global>
  .start-screen { animation: start-in 280ms cubic-bezier(0.2, 0.8, 0.2, 1) both; }
  @keyframes start-in { from { opacity: 0; transform: translateX(14px); } to { opacity: 1; transform: none; } }

  .compare-in { animation: compare-in 420ms 900ms cubic-bezier(0.2, 0.8, 0.2, 1) both; }
  @keyframes compare-in { from { opacity: 0; transform: translateX(24px); } to { opacity: 1; transform: none; } }

  .ecg path { stroke-dasharray: 2400; stroke-dashoffset: 2400; animation: ecg-draw 1.6s ease-out forwards; }
  @keyframes ecg-draw { to { stroke-dashoffset: 0; } }

  .draw-line { stroke-dasharray: 420; stroke-dashoffset: 420; animation: ecg-draw 1.2s ease-out forwards; }

  .notif-in { animation: notif-in 420ms cubic-bezier(0.2, 0.8, 0.2, 1) both; }
  @keyframes notif-in { from { opacity: 0; transform: translateY(-10px) scale(0.97); } to { opacity: 1; transform: none; } }

  .confetti-pop { animation: pop 520ms cubic-bezier(0.3, 1.4, 0.5, 1) both; }
  @keyframes pop { from { opacity: 0; transform: scale(0.6); } to { opacity: 1; transform: none; } }

  .start-range { -webkit-appearance: none; appearance: none; height: 0.5rem; border-radius: 999px; background: rgba(18, 24, 38, 0.12); }
  .start-range::-webkit-slider-thumb { -webkit-appearance: none; width: 2rem; height: 2rem; border-radius: 999px; background: rgba(18, 24, 38, 0.9); border: 4px solid white; box-shadow: 0 4px 12px rgba(18, 24, 38, 0.3); }
  .start-range::-moz-range-thumb { width: 1.5rem; height: 1.5rem; border-radius: 999px; background: rgba(18, 24, 38, 0.9); border: 4px solid white; }

  @media (prefers-reduced-motion: reduce) {
    .start-screen, .compare-in, .confetti-pop, .notif-in { animation: none; }
    .ecg path, .draw-line { animation: none; stroke-dashoffset: 0; }
  }
</style>
