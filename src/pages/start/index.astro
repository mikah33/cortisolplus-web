---
import FunnelLayout from '../../layouts/FunnelLayout.astro';
import StartFlow from '../../components/start/StartFlow.tsx';
import reviewsData from '../../data/reviews.json';
import QRCode from 'qrcode';
import { SITE, APP_RATING } from '../../consts';

const qrSvg = await QRCode.toString(`${SITE.url}/download/`, { type: 'svg', margin: 0, color: { dark: '#121826', light: '#ffffff' } });
const reviews = reviewsData.reviews.map(({ title, body, author, rating }) => ({ title, body, author, rating }));
---

<FunnelLayout
  title="Meet Zen — Build your Cortisol+ plan"
  description="Answer a few questions and Zen builds your personal plan for calmer, lower-stress days."
>
  <link rel="preload" as="image" href="/app-ui/ob/onboarding_sky.webp" />
  <link rel="preload" as="video" href="/app-ui/ob/launch.mp4" type="video/mp4" />
  <!-- Desktop only: a calm panel beside the phone-sized frame (ob.css) -->
  <aside class="hidden lg:block fixed top-1/2 -translate-y-1/2 right-[calc(50%+2.25rem+3.5rem)] w-[19rem] xl:w-[21rem] text-[color:var(--color-ink)]" aria-label="About Cortisol+">
    <div class="flex items-center gap-3">
      <img src="/icon-192.png" alt="" width="192" height="192" class="w-14 h-14 rounded-[1rem] shadow-[0_8px_20px_-8px_rgba(40,96,140,0.55)]" />
      <div>
        <div class="text-xl font-extrabold tracking-tight leading-tight">Cortisol+</div>
        <div class="text-sm font-bold leading-snug" aria-label={`Rated ${APP_RATING.value} out of 5 from ${APP_RATING.count} App Store ratings`}>
          <span class="text-[#fbbf24]" aria-hidden="true">★</span> {APP_RATING.value}
          <span class="font-semibold text-[color:var(--color-ink-muted)]">· {APP_RATING.count} App Store ratings</span>
        </div>
      </div>
    </div>
    <p class="mt-6 text-2xl font-extrabold tracking-tight leading-snug">Meet Zen and build your plan.</p>
    <ul class="mt-5 space-y-3 text-[color:var(--color-ink-muted)] leading-snug">
      <li class="flex gap-3"><span class="mt-1.5 h-2 w-2 flex-none rounded-full bg-[color:var(--color-teal)]" aria-hidden="true"></span>A personal plan built from your answers</li>
      <li class="flex gap-3"><span class="mt-1.5 h-2 w-2 flex-none rounded-full bg-[color:var(--color-teal)]" aria-hidden="true"></span>A daily wellness score from your wearable's HRV, heart rate and sleep</li>
      <li class="flex gap-3"><span class="mt-1.5 h-2 w-2 flex-none rounded-full bg-[color:var(--color-teal)]" aria-hidden="true"></span>Guided breathing with Zen when you need a reset</li>
    </ul>
  </aside>
  <StartFlow
    client:load
    reviews={reviews}
    rating={{ value: APP_RATING.value, count: APP_RATING.count }}
    appStoreUrl={SITE.appStoreUrl}
    googlePlayUrl={SITE.googlePlayUrl}
    qrSvg={qrSvg}
  />
</FunnelLayout>
