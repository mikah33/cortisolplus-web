---
import FunnelLayout from '../../layouts/FunnelLayout.astro';
import StartFlow from '../../components/start/StartFlow.tsx';
import reviewsData from '../../data/reviews.json';
import QRCode from 'qrcode';
import { SITE, APP_RATING } from '../../consts';

const qrSvg = await QRCode.toString(`${SITE.url}/download/`, { type: 'svg', margin: 0, color: { dark: '#121826', light: '#ffffff' } });
const reviews = reviewsData.reviews.map(({ title, body, author, rating }) => ({ title, body, author, rating }));
---

<FunnelLayout
  title="Meet Zen — Build your Cortisol+ plan"
  description="Answer a few questions and Zen builds your personal plan for calmer, lower-stress days."
>
  <link rel="preload" as="image" href="/app-ui/ob/onboarding_sky.webp" />
  <link rel="preload" as="video" href="/app-ui/ob/launch.mp4" type="video/mp4" />
  <StartFlow
    client:load
    reviews={reviews}
    rating={{ value: APP_RATING.value, count: APP_RATING.count }}
    appStoreUrl={SITE.appStoreUrl}
    googlePlayUrl={SITE.googlePlayUrl}
    qrSvg={qrSvg}
  />
</FunnelLayout>
