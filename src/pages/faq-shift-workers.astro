---
import AudienceFAQPage from '../components/AudienceFAQPage.astro';

const faqs = [
  {
    "q": "Can Cortisol+ measure my cortisol curve across shifts?",
    "a": "No. The app does not measure cortisol at any time of day. Its wellness model includes time-of-day assumptions; those should not be treated as a validated measurement of your individual circadian rhythm."
  },
  {
    "q": "Does the app automatically understand my night-shift schedule?",
    "a": "Do not assume that every default or clock-time interpretation adapts to your work pattern. Check the actual sleep record and the published methodology. The earlier website promise that the score assumed no daytime chronotype was too broad."
  },
  {
    "q": "How can I check a daytime sleep record?",
    "a": "Compare the start and end times recorded in Apple Health with when you actually slept. Look for missing periods or records from different sources. A short record may reflect missing data rather than your full sleep opportunity."
  },
  {
    "q": "What should I compare after a shift?",
    "a": "Use comparable workdays and note whether a reading was taken before work, after work or after sleep. Keep the timestamp with the value; comparing two different points in your routine can hide important context."
  },
  {
    "q": "Can the score tell me when it is safe to drive or work?",
    "a": "No. A wellness score is not a fitness-for-duty or alertness assessment. Do not use a reassuring number to override sleepiness, symptoms or workplace fatigue procedures."
  }
];

const related = [
  {
    "href": "/how-it-works/",
    "title": "Scoring methodology",
    "hint": "Inputs and limitations"
  },
  {
    "href": "/resources/stress-sleep-journal/",
    "title": "Free observation journal",
    "hint": "Notes you control"
  },
  {
    "href": "/features/sleep-cortisol-tracking/",
    "title": "Sleep tracking guide",
    "hint": "Check the records"
  }
];
---

<AudienceFAQPage
  audience="Shift workers"
  title="Apple Watch Stress Tracking for Shift Workers: FAQ"
  description="Learn how to interpret Cortisol+ sleep records and score assumptions around night shifts without treating a wearable as a cortisol rhythm test."
  intro="Your schedule is essential context. A clock-time score or incomplete sleep record can be misleading when you work nights."
  {faqs}
  {related}
/>
