---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FAQ, { type FAQItem } from '../../../components/FAQ.astro';
import RelatedLinks from '../../../components/RelatedLinks.astro';
import InShort from '../../../components/article/InShort.astro';
import ZenTip from '../../../components/article/ZenTip.astro';
import ZenPicture from '../../../components/article/ZenPicture.astro';
import { getCollection } from 'astro:content';
import { medicalWebPage } from '../../../lib/schema';
import { SITE } from '../../../consts';

const foods = await getCollection('foods');

const effectColor: Record<string, string> = {
  lowers: 'bg-[color:var(--color-level-low)]/15 text-[color:var(--color-level-low)]',
  raises: 'bg-[color:var(--color-level-high)]/15 text-[color:var(--color-level-high)]',
  neutral: 'bg-[color:var(--color-ink-muted)]/15 text-[color:var(--color-ink-muted)]',
};

const evidenceColor: Record<string, string> = {
  strong: 'bg-[color:var(--color-teal)]/15 text-[color:var(--color-teal-dark)]',
  moderate: 'bg-[color:var(--color-warn,#fbbf24)]/15 text-[color:var(--color-warn,#fbbf24)]',
  limited: 'bg-[color:var(--color-coral)]/15 text-[color:var(--color-coral-dark)]',
};

const schema = [
  medicalWebPage({
    name: 'Foods × cortisol database — does it lower, raise, or do nothing?',
    pathname: '/cortisol/foods/',
    lastReviewed: '2026-11-12',
  }),
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Foods × cortisol database',
    url: `${SITE.url}/cortisol/foods/`,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: foods.map((f, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${SITE.url}/cortisol/foods/${f.id}/`,
        name: f.data.title,
      })),
    },
  },
];

const UPDATED = '2026-11-12';

// The FAQ component renders every answer visibly and emits the FAQPage
// JSON-LD from this same array, so visible text and schema always match.
const faqs: FAQItem[] = [
  {
    q: 'Which foods lower cortisol the most?',
    a: 'No food has been shown to reliably lower cortisol. Dark chocolate, oily fish (salmon, sardines) and magnesium-rich foods (leafy greens, pumpkin seeds, almonds) are often mentioned, as are fermented foods and berries, green tea and olive oil. Evidence on cortisol specifically is limited and mixed, but these foods fit a healthy eating pattern.',
  },
  {
    q: 'What foods raise cortisol?',
    a: 'Caffeine can raise cortisol for a while, especially on an empty stomach or if you don\'t usually drink it. Alcohol can disturb sleep. Refined carbs on an empty stomach, a diet heavy in ultra-processed foods and skipping meals when you\'re very stressed may also add to stress on your body.',
  },
  {
    q: 'Does food matter more than supplements for cortisol?',
    a: 'Food is the foundation. Cutting back on late caffeine and alcohol and eating regular, balanced meals are sensible first steps. Evidence for supplements such as ashwagandha and magnesium is limited and mixed. Ask a doctor or pharmacist before taking one, especially if you take medicines.',
  },
];

const proseCard = `app-card px-5 py-6 sm:px-8 sm:py-8 prose prose-base sm:prose-lg max-w-none
  prose-headings:font-extrabold prose-headings:tracking-tight prose-headings:text-[color:var(--color-ink)]
  prose-headings:text-balance prose-headings:scroll-mt-24
  prose-h2:mt-12 prose-h2:mb-3 prose-h2:text-[1.5rem] sm:prose-h2:text-[1.75rem] prose-h2:leading-tight
  prose-h3:mt-8 prose-h3:mb-2
  prose-p:text-[color:var(--color-ink)] prose-p:leading-[1.75] prose-p:my-4
  prose-li:text-[color:var(--color-ink)] prose-li:leading-[1.7] prose-li:my-1.5
  prose-a:text-[color:var(--color-teal-dark)] prose-a:no-underline hover:prose-a:underline
  prose-strong:text-[color:var(--color-ink)]`;
---

<BaseLayout
  title="Foods that lower cortisol — full database"
  description="How diet shapes your cortisol: the foods and habits that raise it, the ones that calm it, and evidence-ranked per-food reviews with citations."
  image="/screenshots/wearable-insights.png"
  schema={schema}
>
  <article class="max-w-4xl mx-auto px-4 pt-6 pb-16">
    <header class="px-1 mb-6 max-w-3xl">
      <div class="text-xs uppercase tracking-widest text-[color:var(--color-teal-dark)] font-semibold mb-2">Database</div>
      <h1 class="text-[2rem] md:text-5xl leading-[1.1] font-extrabold tracking-tight mb-3 text-balance">Foods × cortisol</h1>
      <p class="text-[1.0625rem] md:text-xl leading-relaxed text-[color:var(--color-ink-muted)] text-pretty">
        Per-food evidence reviews. Does it lower cortisol, raise it, or do nothing? With citations.
      </p>
      <p class="text-sm text-[color:var(--color-ink-muted)] mt-4">
        Updated {new Date(UPDATED).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })} · By <a href="/about/" class="underline underline-offset-2">Cortisol+ Editorial</a>
      </p>
    </header>

    <div class="max-w-3xl">
      <InShort image="/app-ui/zen/zen-meal.webp" points={[
        '<strong>No single food</strong> resets your cortisol.',
        'Your <strong>overall eating pattern</strong> matters more than any one food.',
        'Each review rates the <strong>effect</strong> and how strong the <strong>evidence</strong> is.',
      ]} />

      <div class={proseCard}>
        <h2>How does food affect cortisol?</h2>
        <p><strong>Food may affect cortisol in a few ways, but the evidence is limited and mixed.</strong> The main ideas researchers look at:</p>
        <ul>
          <li><strong>Blood sugar.</strong> Big swings, for example from refined carbs on an empty stomach, may add to stress on your body.</li>
          <li><strong>Nutrients</strong> such as magnesium, vitamin C and omega-3 fats. Your body needs them, but whether more of them lowers cortisol isn't clear.</li>
          <li><strong>Stimulants and alcohol.</strong> Caffeine can raise cortisol for a while. Alcohol can disturb sleep.</li>
        </ul>

        <h2>What actually helps?</h2>
        <p><strong>No single food "resets" your cortisol.</strong> The pattern matters more:</p>
        <ul>
          <li>Eat at regular times.</li>
          <li>Build meals around protein and fibre.</li>
          <li>Include foods like oily fish, leafy greens, nuts and seeds.</li>
          <li>Keep caffeine and alcohol modest.</li>
        </ul>
        <p>These habits support your general health. Their effect on cortisol specifically hasn't been well proven.</p>

        <h2>Caffeine, alcohol and water</h2>
        <p><strong>Caffeine</strong> can raise cortisol for a while. The effect seems bigger in people who don't usually drink it. Having coffee with food, and not late in the day, is kinder to your sleep.</p>
        <p><strong>Alcohol</strong> can make you sleepy at first. Later in the night it tends to break up your sleep.</p>
        <p><strong>Omega-3 fats</strong> from oily fish are often mentioned for stress. Studies on cortisol are limited and mixed.</p>
        <p><strong>Water</strong> matters for your health in general. Steady drinking through the day is a simple, free habit.</p>

        <ZenTip image="/app-ui/zen/zen-water.webp">
          Keep a <strong>water bottle where you can see it</strong>, on your desk or by the kettle. You'll drink more without thinking.
        </ZenTip>

        <h2>How we rate evidence</h2>
        <ul>
          <li><strong>Strong:</strong> several controlled human trials point the same way.</li>
          <li><strong>Moderate:</strong> real human data, but thinner or mixed.</li>
          <li><strong>Limited:</strong> the claim leans on small studies, animal work or theory alone.</li>
        </ul>
        <p>For a plain-English guide to common foods, see <a href="/cortisol/lower/foods/" class="text-[color:var(--color-teal-dark)] underline underline-offset-2">foods that lower cortisol</a>.</p>
      </div>
    </div>

    <h2 class="px-1 mt-12 mb-4 text-[1.5rem] md:text-3xl font-extrabold tracking-tight leading-tight">Food reviews</h2>
    {foods.length === 0 ? (
      <p class="text-[color:var(--color-ink-muted)]">Food pages coming soon.</p>
    ) : (
      <div class="grid md:grid-cols-2 gap-4 mb-8">
        {foods.map((f) => (
          <a href={`/cortisol/foods/${f.id}/`} class="group block p-6 rounded-2xl bg-[color:var(--color-surface)] border border-[color:var(--color-border)] hover:border-[color:var(--color-teal)]/40 hover:-translate-y-0.5 transition">
            <div class="flex items-center gap-2 mb-3">
              <span class={`px-2 py-0.5 rounded-full text-xs font-semibold ${effectColor[f.data.effect]}`}>{f.data.effect}</span>
              <span class={`px-2 py-0.5 rounded-full text-xs font-semibold ${evidenceColor[f.data.evidenceLevel]}`}>{f.data.evidenceLevel} evidence</span>
            </div>
            <h3 class="text-xl font-semibold mb-1 group-hover:text-[color:var(--color-teal-dark)] transition capitalize">{f.data.food}</h3>
            <p class="text-sm text-[color:var(--color-ink-muted)]">{f.data.description}</p>
          </a>
        ))}
      </div>
    )}

    <div class="max-w-3xl">
      <a href="/start/" data-start-cta class="not-prose my-8 flex items-center gap-4 rounded-2xl bg-[color:var(--color-ink)] p-5 text-white no-underline shadow-sm transition hover:brightness-110">
        <img src="/apple-touch-icon.png" alt="" width="48" height="48" class="h-12 w-12 shrink-0 rounded-[13px]" />
        <span class="min-w-0 flex-1 leading-snug">
          <span class="block font-extrabold">Get your personal stress plan</span>
          <span class="block text-sm text-white/75">A one-minute check-in with Zen, then your plan in Cortisol+</span>
        </span>
        <span class="shrink-0 rounded-full bg-white px-4 py-2 text-sm font-extrabold text-[color:var(--color-ink)]">Start ›</span>
      </a>

      <ZenPicture src="/app-ui/start/zen_explain.webp" caption="Check the evidence label before you believe the hype." />

      <FAQ items={faqs} />
      <RelatedLinks links={[
        { href: '/cortisol/lower/foods/', title: 'Foods that lower cortisol', hint: 'Plain-English guide' },
        { href: '/cortisol/lower/supplements/', title: 'Supplements and cortisol', hint: 'Evidence and limits' },
        { href: '/cortisol/lower/', title: 'Full how-to-lower guide', hint: 'All interventions' },
      ]} />

      <aside class="mt-6 app-card p-5 text-sm text-[color:var(--color-ink-muted)] leading-relaxed">
        <strong class="text-[color:var(--color-ink)]">Not medical advice.</strong> This page is educational. Cortisol+ does not measure cortisol directly — the app offers a wellness score derived from biometric signals, not a hormone test. For diagnosis, testing, or treatment of any medical condition, consult a qualified healthcare provider.
      </aside>
    </div>
  </article>
</BaseLayout>
