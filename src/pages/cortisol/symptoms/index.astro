---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../../consts';

const symptoms = await getCollection('symptoms');

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalWebPage',
    name: 'Symptoms of high cortisol',
    about: { '@type': 'MedicalCondition', name: 'Hypercortisolism' },
    audience: { '@type': 'MedicalAudience', audienceType: 'Patient' },
    lastReviewed: '2026-05-23',
    dateModified: '2026-05-23',
    mainEntityOfPage: `${SITE.url}/cortisol/symptoms/`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Symptoms of high cortisol',
    url: `${SITE.url}/cortisol/symptoms/`,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: symptoms.map((s, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${SITE.url}/cortisol/symptoms/${s.id}/`,
        name: s.data.title,
      })),
    },
  },
];
---

<BaseLayout
  title="Symptoms of high cortisol — full index by Cortisol+ (2026)"
  description="Complete index of high cortisol symptoms: cortisol face, cortisol belly, sleep issues, weight gain, hair loss. Each backed by science — what's clinical, what's TikTok."
  image="/screenshots/health-breakdown.png"
  schema={schema}
>
  <section class="max-w-4xl mx-auto px-6 py-16">
    <div class="text-xs uppercase tracking-widest text-[color:var(--color-coral)] font-medium mb-3">Symptoms</div>
    <h1 class="text-5xl font-bold tracking-tight mb-6">Symptoms of high cortisol</h1>
    <p class="text-xl text-[color:var(--color-ink-muted)] mb-12">
      Recognize the signs your cortisol may be chronically elevated.
    </p>

    {symptoms.length === 0 ? (
      <p class="text-[color:var(--color-ink-muted)]">Symptom pages coming soon.</p>
    ) : (
      <ul class="grid md:grid-cols-2 gap-3">
        {symptoms.map((s) => (
          <li>
            <a href={`/cortisol/symptoms/${s.id}`} class="block p-4 rounded-xl border border-[color:var(--color-border)] hover:border-[color:var(--color-teal)]/40 hover:bg-[color:var(--color-surface)] transition">
              <div class="font-medium">{s.data.title}</div>
              <div class="text-sm text-[color:var(--color-ink-muted)] mt-1">{s.data.description}</div>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
