---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppStoreBadge from '../components/AppStoreBadge.astro';
import RatingBadge from '../components/RatingBadge.astro';
import { SITE } from '../consts';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Download Cortisol+ — Stress & HRV App',
    url: `${SITE.url}/download/`,
    description: 'Download Cortisol+ for iPhone. Explore Apple Watch stress and HRV trends. Requires iOS 17+; analysis requires a subscription or eligible trial.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: SITE.fullName,
    alternateName: SITE.name,
    operatingSystem: 'iOS 17+, watchOS',
    applicationCategory: 'HealthApplication',
    description: SITE.description,
    downloadUrl: SITE.appStoreUrl,
    installUrl: SITE.appStoreUrl,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
];
---

<BaseLayout
  title="Download Cortisol+ — Stress & HRV App"
  description="Download Cortisol+ for iOS 17+. Explore wearable HRV, sleep and recovery with a wellness score. Subscription or eligible trial required for analysis."
  image="/screenshots/track-cortisol-levels.png"
  schema={schema}
>
  <section class="max-w-2xl mx-auto px-6 py-24 text-center">
    <h1 class="text-5xl font-bold tracking-tight mb-4">Get Cortisol+</h1>
    <p class="text-xl text-[color:var(--color-ink-muted)] mb-6">
      Free to download. Explore your Apple Watch stress and HRV trends.
    </p>
    <div class="flex justify-center mb-8">
      <RatingBadge size="md" />
    </div>
    <AppStoreBadge size="lg" />
    <p class="text-sm text-[color:var(--color-ink-muted)] mt-8">
      Requires iOS 17+. Core analysis requires an active subscription or an eligible trial.
    </p>
  </section>

  <section class="max-w-3xl mx-auto px-6 pb-24">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-4">What Cortisol+ does</h2>
    <p class="text-[color:var(--color-ink-muted)] leading-relaxed mb-4">
      Cortisol+ brings available HRV, resting heart rate, sleep and activity into one view. Its 0–100 wellness score reflects a model, not a cortisol measurement. Read <a href="/how-it-works/" class="underline">how the score works</a> before interpreting it.
    </p>
    <p class="text-[color:var(--color-ink-muted)] mb-8">The app includes wearable trends and guided breathing. A change in the score does not establish that an intervention changed your hormone levels.</p>

    <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-4">What you need</h2>
    <ul class="list-disc pl-5 space-y-2 text-[color:var(--color-ink-muted)] leading-relaxed mb-8">
      <li><strong class="text-[color:var(--color-ink)]">An iPhone running iOS 17 or later.</strong> This download is the iPhone version.</li>
      <li><strong class="text-[color:var(--color-ink)]">A compatible Apple Watch paired to that iPhone.</strong> Available measurements depend on Watch model, software, region, permissions and wear time.</li>
      <li><strong class="text-[color:var(--color-ink)]">Apple Health permissions.</strong> On first launch you grant read access to heart rate, HRV, and sleep. Wearing the Watch overnight gives the app its most useful data.</li>
    </ul>
    <p class="text-[color:var(--color-ink-muted)] leading-relaxed mb-8">
      The app is free to download. Analysis requires an active subscription or eligible trial. Check the in-app offer for current pricing, trial eligibility and renewal terms.
    </p>

    <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-4">How the wellness score works</h2>
    <p class="text-[color:var(--color-ink-muted)] leading-relaxed mb-4">
      Apple Watch does not directly measure cortisol. Cortisol+ combines available wearable readings with model assumptions and, as sufficient history accumulates, a personal baseline. HRV, resting heart rate and sleep can vary with stress, exercise, illness and many other factors. A wellness score cannot determine your cortisol level.
    </p>
    <p class="text-[color:var(--color-ink-muted)] leading-relaxed mb-8">
      That means Cortisol+ is a pattern tracker, not a medical device. It won't diagnose Cushing's syndrome or adrenal insufficiency, and it's not a substitute for lab testing when a doctor recommends one — read <a href="/how-it-works" class="text-[color:var(--color-teal-dark)] underline underline-offset-2">how it works</a> for the full methodology and its limits.
    </p>

    <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-4">Your data stays yours</h2>
    <p class="text-[color:var(--color-ink-muted)] leading-relaxed">
      The core wellness score is calculated on your device. Optional connected services, account features and coaching have additional data flows. The full details are in our <a href="/privacy" class="text-[color:var(--color-teal-dark)] underline underline-offset-2">privacy policy</a>.
    </p>
  </section>
</BaseLayout>
