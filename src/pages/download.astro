---
import BaseLayout from '../layouts/BaseLayout.astro';
import GetAppButton from '../components/GetAppButton.astro';
import { SITE, APP_RATING } from '../consts';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Download Cortisol+ — Stress & HRV App',
    url: `${SITE.url}/download/`,
    description: 'Download Cortisol+ for iPhone on the App Store or for Android on Google Play.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: SITE.fullName,
    alternateName: SITE.name,
    operatingSystem: 'iOS 17+, watchOS',
    applicationCategory: 'HealthApplication',
    description: SITE.description,
    downloadUrl: SITE.appStoreUrl,
    installUrl: SITE.appStoreUrl,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
];
---

<BaseLayout
  title="Download Cortisol+ — Stress & HRV App"
  description="Download Cortisol+ for iPhone or Android. Choose the App Store or Google Play for your device."
  image="/screenshots/live-stress-levels.png"
  schema={schema}
>
  <div class="mx-auto w-full max-w-[30rem] -mt-14">
    <!-- Store card, like an App Store listing on the app's sky -->
    <section class="app-sky px-4 pt-20 pb-6">
      <div class="app-card p-5">
        <div class="flex items-center gap-4">
          <img src="/icon-192.png" alt="Cortisol+ app icon" width="192" height="192" class="w-20 h-20 rounded-[1.375rem] shadow-[0_8px_20px_-8px_rgba(40,96,140,0.55)]" />
          <div class="min-w-0">
            <h1 class="text-[1.625rem] leading-tight font-extrabold tracking-tight">Get Cortisol+</h1>
            <p class="text-[color:var(--color-ink-muted)] leading-snug">Stress &amp; HRV Monitor</p>
            <a href={SITE.appStoreUrl} class="mt-1 inline-flex items-center gap-1 text-sm font-bold" aria-label={`Rated ${APP_RATING.value} out of 5 from ${APP_RATING.count} App Store ratings`}>
              <span class="text-[#fbbf24]" aria-hidden="true">★</span>{APP_RATING.value}
              <span class="font-semibold text-[color:var(--color-ink-muted)]">· {APP_RATING.count} ratings</span>
            </a>
          </div>
        </div>

        <p class="mt-4 text-[color:var(--color-ink)]/75 leading-relaxed">
          <span data-only="ios">The iPhone app, with your Apple Watch.</span>
          <span data-only="android">The Android app, with Health Connect and Wear OS.</span>
          <span data-only="other">Choose the Cortisol+ app for your iPhone or Android device.</span>
        </p>

        <div class="mt-5"><GetAppButton /></div>

        <p class="mt-4 text-xs leading-relaxed text-[color:var(--color-ink-muted)] text-center">
          Free to download. Core analysis requires an active subscription or an eligible trial.
        </p>
      </div>

      <ul class="app-snap -mx-4 mt-5 pb-1">
        {['live-stress-levels', 'sleep-quality', 'activities', 'zen-ai-assistant'].map((name) => (
          <li class="w-[42%]">
            <img src={`/screenshots/${name}.webp`} alt="" width="645" height="1398" loading="lazy" decoding="async" class="rounded-2xl aspect-[645/1398] w-full object-cover shadow-[0_12px_28px_-18px_rgba(40,96,140,0.6)]" />
          </li>
        ))}
      </ul>
    </section>

    <!-- What you need — follows the visitor's phone -->
    <section class="px-4 mt-6">
      <h2 class="px-1 mb-2 text-xl font-extrabold tracking-tight">What you need</h2>
      <ul class="app-card app-list overflow-hidden" data-only-block="ios other">
        <li class="p-4"><div class="font-extrabold">iPhone with iOS 17 or later</div><p class="text-sm text-[color:var(--color-ink-muted)] leading-snug mt-0.5">The App Store download is the iPhone version.</p></li>
        <li class="p-4"><div class="font-extrabold">A compatible Apple Watch</div><p class="text-sm text-[color:var(--color-ink-muted)] leading-snug mt-0.5">Paired to that iPhone. Available measurements depend on Watch model, software, region, permissions and wear time.</p></li>
        <li class="p-4"><div class="font-extrabold">Apple Health permissions</div><p class="text-sm text-[color:var(--color-ink-muted)] leading-snug mt-0.5">On first launch you grant read access to heart rate, HRV, and sleep. Wearing the Watch overnight gives the app its most useful data.</p></li>
      </ul>
      <ul class="app-card app-list overflow-hidden" data-only-block="android">
        <li class="p-4"><div class="font-extrabold">Android 9 or later</div><p class="text-sm text-[color:var(--color-ink-muted)] leading-snug mt-0.5">Get Cortisol+ from Google Play.</p></li>
        <li class="p-4"><div class="font-extrabold">Health Connect</div><p class="text-sm text-[color:var(--color-ink-muted)] leading-snug mt-0.5">Built into Android 14 and later, or free from Google Play. On first launch you grant read access to heart rate, HRV and sleep.</p></li>
        <li class="p-4"><div class="font-extrabold">A watch or ring that syncs to Health Connect</div><p class="text-sm text-[color:var(--color-ink-muted)] leading-snug mt-0.5">Wear OS watches get the Cortisol+ watch app. Available measurements depend on your device, its app, permissions and wear time.</p></li>
      </ul>
      <p class="px-1 mt-3 text-sm text-[color:var(--color-ink-muted)] leading-relaxed">
        The app is free to download. Analysis requires an active subscription or eligible trial. Check the in-app offer for current pricing, trial eligibility and renewal terms.
      </p>
    </section>

    <!-- The explanations, kept in full -->
    <section class="px-4 mt-8 space-y-4">
      <div class="app-card p-5">
        <h2 class="text-xl font-extrabold tracking-tight mb-2">What Cortisol+ does</h2>
        <p class="text-[color:var(--color-ink-muted)] leading-relaxed mb-3">
          Cortisol+ brings available HRV, resting heart rate, sleep and activity into one view. Its 0–100 wellness score reflects a model, not a cortisol measurement. Read <a href="/how-it-works/" class="underline font-semibold text-[color:var(--color-teal-dark)]">how the score works</a> before interpreting it.
        </p>
        <p class="text-[color:var(--color-ink-muted)] leading-relaxed">The app includes wearable trends and guided breathing. A change in the score does not establish that an intervention changed your hormone levels.</p>
      </div>

      <div class="app-card p-5">
        <h2 class="text-xl font-extrabold tracking-tight mb-2">How the wellness score works</h2>
        <p class="text-[color:var(--color-ink-muted)] leading-relaxed mb-3">
          Apple Watch does not directly measure cortisol. Cortisol+ combines available wearable readings with model assumptions and, as sufficient history accumulates, a personal baseline. HRV, resting heart rate and sleep can vary with stress, exercise, illness and many other factors. A wellness score cannot determine your cortisol level.
        </p>
        <p class="text-[color:var(--color-ink-muted)] leading-relaxed">
          That means Cortisol+ is a pattern tracker, not a medical device. It won't diagnose Cushing's syndrome or adrenal insufficiency, and it's not a substitute for lab testing when a doctor recommends one — read <a href="/how-it-works/" class="text-[color:var(--color-teal-dark)] font-semibold underline underline-offset-2">how it works</a> for the full methodology and its limits.
        </p>
      </div>

      <div class="app-card p-5">
        <h2 class="text-xl font-extrabold tracking-tight mb-2">Looking for a cortisol tracker app?</h2>
        <p class="text-[color:var(--color-ink-muted)] leading-relaxed mb-3">Choose Cortisol+ if you want to organize available Apple Watch stress and recovery signals and understand the factors behind a wellness score. If you need a cortisol concentration or an explanation for symptoms, this app cannot provide that result.</p>
        <p class="text-[color:var(--color-ink-muted)] leading-relaxed">Before choosing a plan, read the <a href="/stress/apple-watch/" class="underline font-semibold text-[color:var(--color-teal-dark)]">Apple Watch setup guide</a>, compare <a href="/compare/apple-watch-stress-apps/" class="underline font-semibold text-[color:var(--color-teal-dark)]">documented approaches from stress apps</a>, and try the <a href="/resources/stress-sleep-journal/" class="underline font-semibold text-[color:var(--color-teal-dark)]">free observation journal</a>. The journal works without an account or subscription.</p>
      </div>

      <div class="app-card p-5">
        <h2 class="text-xl font-extrabold tracking-tight mb-2">Your data stays yours</h2>
        <p class="text-[color:var(--color-ink-muted)] leading-relaxed">
          The core wellness score is calculated on your device. Optional connected services, account features and coaching have additional data flows. The full details are in our <a href="/privacy/" class="text-[color:var(--color-teal-dark)] font-semibold underline underline-offset-2">privacy policy</a>.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
